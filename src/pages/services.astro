---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getPage, getServices } from '../lib/content';

const page = await getPage('services');
const services = await getServices();
---

<BaseLayout title={page.title} description={page.lede}>
  <h1 class="text-4xl font-bold">{page.headline}</h1>
  <p>{page.lede}</p>
  <div class="grid gap-4 py-8 md:grid-cols-2">
    {services.map((s) => <ServiceCard service={s} />)}
  </div>
</BaseLayout>
