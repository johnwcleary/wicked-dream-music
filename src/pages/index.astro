---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lines from '../components/Lines.astro';
import WordField from '../components/WordField.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceAccordion from '../components/ServiceAccordion.astro';
import WorkAccordion from '../components/WorkAccordion.astro';
import { getPage, getServices, getSite, getWork, pad, paragraphs, splitHeadline, toSection } from '../lib/content';

const site = await getSite();
const page = await getPage('home');
const about = await getPage('about');
const servicesPage = await getPage('services');
const workPage = await getPage('work');
const contact = await getPage('contact');
const services = await getServices();
const work = await getWork();
// The headline's last word is the one set in italics, and the one that expands.
const headWords = page.headline.trim().split(/\s+/);
const headLast = headWords.pop();
const headLead = headWords.join(' ');
const expand = page.hero_expand;
const video = page.hero_video;

const chapters = about.sections ?? [];
// Pull quote: the credentials line from the first chapter, repeated as a closing statement.
const firstParas = chapters[0] ? paragraphs(chapters[0].body) : [];
const quote = firstParas[firstParas.length - 1];
---

<BaseLayout title={page.title} intro>
  <!-- 00 — Hero: the footage holds still behind a line too big for the screen.
       Scrolling runs the line across, opens its last word into a list, then
       resolves on one word. Without JS or with reduced motion it's stacked text. -->
  <section id="top" class={`hero${video ? ' has-video' : ''}`} aria-labelledby="hero-title" data-hero>
    <div class="hero-stage">
      {
        video && (
          <div class="hero-media" aria-hidden="true" data-hero-media>
            <Image
              src={video.poster}
              alt=""
              widths={[640, 960, 1280, 1920].filter((w) => w <= video.poster.width)}
              width={Math.min(1920, video.poster.width)}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              quality={62}
              class="hero-poster"
            />
            <video class="hero-video" muted loop playsinline preload="none" disablepictureinpicture data-hero-video>
              {video.mobile_webm && <source src={video.mobile_webm} type="video/webm" media="(max-width: 767px)" />}
              {video.mobile_mp4 && <source src={video.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
              {video.webm && <source src={video.webm} type="video/webm" />}
              <source src={video.mp4} type="video/mp4" />
            </video>
            <span class="hero-shade" />
          </div>
        )
      }
      <div class="hero-type">
        <h1 id="hero-title" class="run display">
          <span class="run-line" data-run-line>
            <span class="run-lead" data-run-lead>{headLead}</span>{' '}
            <em class="run-last" data-run-last>{headLast}</em>
          </span>
        </h1>
        {
          expand && (
            <div class="bloom">
              <ul class="bloom-list display">
                {expand.words.map((word) => (
                  <li data-bloom-word>
                    <em>{word}</em>
                  </li>
                ))}
              </ul>
              <p class="bloom-end display" data-bloom-end>
                <em>{expand.resolve}</em>
              </p>
            </div>
          )
        }
      </div>
      <div class="wrap hero-foot">
        <p class="hero-strap label label-muted">{page.strapline}</p>
        {
          page.cta && (
            <a class="hero-cta label" href={toSection(page.cta.href)}>
              {page.cta.label} <span aria-hidden="true">↓</span>
            </a>
          )
        }
        {
          video && (
            <button
              type="button"
              class="hero-credit label"
              data-hero-toggle
              data-play={`${site.ui.play_video}: ${video.title}`}
              data-pause={`${site.ui.pause_video}: ${video.title}`}
              aria-label={`${site.ui.pause_video}: ${video.title}`}
            >
              {video.title}
            </button>
          )
        }
      </div>
    </div>
  </section>

  <!-- 01 — Services -->
  <section id="services" class="sec wrap" aria-labelledby="services-title">
    <SectionHead id="services-title" title={servicesPage.headline} count={services.length} kicker={servicesPage.lede} number={1} />
    <ServiceAccordion items={services} />
  </section>

  <!-- Artists. Ideas. Sound. Culture. — with the four plates set into the line -->
  <WordField words={site.ticker} items={work} />

  <!-- 02 — About -->
  <section id="about" class="band band-ink" aria-labelledby="about-label">
    <div class="wrap">
      <p id="about-label" class="band-label label" data-reveal>
        <span aria-hidden="true">{pad(2)} —</span> {about.title}
      </p>
      <div class="chaps grid12">
        {
          chapters.map((c, i) => (
            <article class="chap" data-reveal style={`--i: ${i + 1}`}>
              <p class="chap-no label" aria-hidden="true">
                {pad(2)}.{i + 1}
              </p>
              <Lines as="h2" class="chap-title display d-md" lines={splitHeadline(c.heading)} i={i + 1} />
              <div class="chap-body">
                {paragraphs(c.body).map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>
      {
        quote && (
          <figure class="pull" aria-hidden="true">
            <blockquote class="pull-q display" data-reveal>
              <p>
                <span class="pull-fill">“{quote}”</span>
              </p>
            </blockquote>
            <figcaption class="pull-cap label">— {site.name}</figcaption>
          </figure>
        )
      }
    </div>
  </section>

  <!-- 03 — Selected work -->
  <section id="work" class="sec wrap" aria-labelledby="work-title">
    <SectionHead id="work-title" title={workPage.headline} count={work.length} kicker={workPage.lede} number={3} />
    <WorkAccordion items={work} />
    {workPage.footnote && <p class="sec-foot label label-muted">{workPage.footnote}</p>}
  </section>

  <!-- 04 — Contact: one big email call to action -->
  <section id="contact" class="band band-cta" aria-labelledby="contact-title">
    <div class="wrap grid12 cta">
      <p class="band-label label cta-label" data-reveal>
        <span aria-hidden="true">{pad(4)} —</span> {contact.intro_heading}
      </p>
      <Lines as="h2" id="contact-title" class="cta-title display d-lg" lines={splitHeadline(contact.headline)} />
      <p class="cta-lede body-lg" data-reveal style="--i: 2">{contact.lede} {contact.intro}</p>
      <a class="cta-mail display" href={`mailto:${site.email}`} data-reveal style="--i: 3">
        <span class="cta-mail-text">{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</span>
        <span class="cta-mail-arrow" aria-hidden="true">↗</span>
      </a>
      <p class="cta-loc label" data-reveal style="--i: 4">{site.location}</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: a pinned stage, video behind and type in front ---------- */
  .hero {
    --hero-soft: color-mix(in srgb, var(--paper) 86%, transparent);
    --hero-muted: color-mix(in srgb, var(--paper) 70%, transparent);
    position: relative;
    margin-top: calc(var(--header-h) * -1);
    scroll-margin-top: 0;
  }
  .hero-stage {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(2rem, 5vw, 4rem);
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 2rem);
    overflow: clip;
  }
  .hero :global(.label-muted) {
    color: var(--hero-muted);
  }

  /* Media stack: optimised poster (the LCP image), the loop over it once it
     plays, and a shade that keeps text AA. The grade is baked into the footage
     and poster, so nothing is filtered per frame. */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-media :global(.hero-poster),
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-video {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero.is-playing .hero-video {
    opacity: 1;
  }
  /* Never below 50% ink behind the type: white footage still gives 3.4:1. */
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--ink) 70%, transparent) 0%,
      color-mix(in srgb, var(--ink) 50%, transparent) 20%,
      color-mix(in srgb, var(--ink) 50%, transparent) 72%,
      color-mix(in srgb, var(--ink) 92%, transparent) 90%,
      var(--ink) 100%
    );
  }

  /* Stacked text by default: no JS, or reduced motion. */
  .hero-type {
    padding-inline: var(--gutter);
  }
  .run {
    margin: 0;
    font-size: clamp(3.4rem, 11vw, 12rem);
  }
  .run em,
  .bloom em {
    font-style: italic;
  }
  .bloom {
    margin-top: 1.5rem;
  }
  .bloom-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(2rem, 6vw, 6rem);
    line-height: 1;
  }
  .bloom-end {
    margin: 0.75rem 0 0;
    font-size: clamp(3.4rem, 11vw, 12rem);
  }

  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 2rem;
    padding-block: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--paper) 22%, transparent);
  }
  .hero-strap {
    margin: 0 auto 0 0;
  }
  .hero-cta {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.35rem 0;
    color: var(--paper);
  }
  .hero-cta:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  /* The credit doubles as a quiet pause/play control for the loop. */
  .hero-credit {
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: var(--hero-soft);
    cursor: pointer;
  }
  .hero-credit:hover {
    color: var(--paper);
  }

  /* The sequence: a tall track with the stage pinned inside it. Everything moves
     by transform and opacity from the script below. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero {
      height: 540svh;
    }
    :global(html.js) .hero-stage {
      position: sticky;
      top: 0;
      height: 100svh;
      gap: 0;
      padding-top: var(--header-h);
    }
    :global(html.js) .hero-media {
      will-change: transform;
    }
    :global(html.js) .hero-type {
      position: relative;
      flex: 1;
      min-height: 0;
      display: flex;
      align-items: center;
      padding-inline: 0;
    }
    :global(html.js) .run {
      font-size: min(58svh, 42vw);
      white-space: nowrap;
    }
    :global(html.js) .run-line {
      display: inline-block;
      position: relative;
      padding-inline: var(--gutter);
      will-change: transform;
    }
    :global(html.js) .run-lead,
    :global(html.js) .run-last {
      display: inline-block;
    }
    :global(html.js) .run-last {
      padding-right: 0.08em;
    }
    :global(html.js) .bloom {
      position: absolute;
      inset: 0.5rem var(--gutter);
      margin: 0;
      pointer-events: none;
    }
    :global(html.js) .bloom-list {
      display: grid;
      grid-template-rows: repeat(4, minmax(0, 1fr));
      gap: 0;
      height: 100%;
      font-size: min(22svh, 19vw);
      line-height: 0.9;
      white-space: nowrap;
    }
    :global(html.js) .bloom-list li {
      align-self: center;
      opacity: 0;
    }
    /* Alternating sides, so the list spreads across the whole frame. */
    :global(html.js) .bloom-list li:nth-child(even) {
      justify-self: end;
    }
    :global(html.js) .bloom-end {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      margin: 0;
      font-size: min(58svh, 42vw);
      opacity: 0;
    }
  }

  /* ---------- Sections ---------- */
  .sec {
    padding-block: clamp(3rem, 7vw, 6rem);
    scroll-margin-top: 4rem;
  }
  .sec-foot {
    margin: 1.25rem 0 0;
    max-width: 52ch;
  }

  /* The contact band runs straight into the footer. */
  :global(.site-footer) {
    margin-top: 0;
  }

  /* ---------- Full-width sections, split by a hairline ---------- */
  .band {
    padding-block: clamp(4rem, 9vw, 8rem);
    scroll-margin-top: 4rem;
    border-top: 1px solid var(--rule);
  }
  .band-label {
    margin: 0 0 clamp(2.5rem, 6vw, 5rem);
  }

  /* About — title and body side by side, the quote highlighted. */
  .band-ink {
    --soft: color-mix(in srgb, var(--paper) 82%, transparent);
  }
  .band-ink .band-label,
  .chap-no {
    color: var(--accent);
  }
  .chaps {
    row-gap: clamp(3rem, 7vw, 5rem);
  }
  /* Each chapter is a row: title left, body right. */
  .chap {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .chap > * {
    grid-column: 1 / -1;
  }
  .chap-no {
    margin: 0 0 1.25rem;
  }
  .chap :global(.chap-title) {
    margin: 0 0 1.5rem;
  }
  .chap-body p {
    margin: 0 0 1em;
    max-width: 40ch;
    color: var(--soft);
    font-size: clamp(1.125rem, 1.4vw, 1.3125rem);
    line-height: 1.5;
    letter-spacing: -0.006em;
  }
  .pull {
    margin: clamp(5rem, 11vw, 9rem) 0 0;
  }
  .pull-q {
    margin: 0;
  }
  .pull-q p {
    margin: 0;
    font-size: clamp(2rem, 4.8vw, 5rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-indent: -0.4em;
  }
  .pull-cap {
    margin-top: 1.5rem;
    color: var(--accent);
  }
  /* The quote is set in the accent gradient (silver to pewter across each line). */
  .pull-fill {
    color: var(--accent);
  }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .pull-fill {
      color: transparent;
      background-image: linear-gradient(90deg, var(--accent), var(--accent-2));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
  }

  /* Contact — one giant email link, in silver. */
  .band-cta {
    --soft: color-mix(in srgb, var(--paper) 78%, transparent);
  }
  .cta {
    row-gap: 1.5rem;
  }
  .cta-label,
  .cta-loc {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--soft);
  }
  .cta :global(.cta-title) {
    grid-column: 1 / -1;
    margin: 0;
  }
  .cta-lede {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
    max-width: 44ch;
    color: var(--soft);
  }
  .cta-mail {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
    max-width: 100%;
    color: var(--accent);
    font-size: clamp(2rem, 8.4vw, 8.5rem);
    line-height: 1.05;
  }
  .cta-mail-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 0.06em;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.06em;
    transition: background-size 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-text {
    background-size: 100% 0.12em;
  }
  .cta-mail-arrow {
    font-size: 0.6em;
    transition: transform 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-arrow {
    transform: translate(0.12em, -0.12em);
  }
  .cta-loc {
    margin-top: 0.5rem;
  }

  @media (min-width: 900px) {
    .chap > :global(.chap-title) {
      grid-column: 1 / span 5;
    }
    .chap > .chap-body {
      grid-column: 7 / -1;
    }
    .pull-q,
    .pull-cap {
      max-width: 85%;
      margin-left: auto;
    }
    .cta-lede {
      grid-column: 1 / span 6;
    }
    .cta-mail {
      font-size: clamp(3rem, 6.4vw, 8rem);
    }
  }
</style>

<script>
  // Hero loop: starts after the page has loaded (so it never competes with the
  // poster image), pauses off-screen and never autoplays under reduced motion.
  // The title credit doubles as the pause/play control (WCAG 2.2.2).
  const hero = document.getElementById('top');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (hero && video && toggle) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let wanted = !reduce.matches; // play unless the visitor paused it or prefers reduced motion
    let visible = true;

    const render = () => {
      const playing = !video.paused;
      toggle.setAttribute('aria-label', (playing ? toggle.dataset.pause : toggle.dataset.play) ?? '');
      hero.classList.toggle('is-playing', playing);
    };
    const sync = () => {
      if (wanted && visible) {
        video.preload = 'auto';
        video.play().catch(() => {});
      } else video.pause();
    };
    video.addEventListener('playing', render);
    video.addEventListener('pause', render);
    toggle.addEventListener('click', () => {
      wanted = video.paused;
      sync();
    });
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      sync();
    }).observe(hero);

    render();
    const begin = () => ('requestIdleCallback' in window ? requestIdleCallback(sync, { timeout: 1500 }) : setTimeout(sync, 300));
    if (document.readyState === 'complete') begin();
    else addEventListener('load', begin, { once: true });
  }

  // Hero sequence, driven by how far the pinned stage has scrolled (0 to 1):
  // the line runs until its last word is centred, that word opens into the list,
  // then the list closes back on one word. Same timings everywhere; only sizes change.
  const track = document.querySelector<HTMLElement>('[data-hero]');
  const line = document.querySelector<HTMLElement>('[data-run-line]');
  const lead = document.querySelector<HTMLElement>('[data-run-lead]');
  const last = document.querySelector<HTMLElement>('[data-run-last]');
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const end = document.querySelector<HTMLElement>('[data-bloom-end]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-bloom-word]'));
  if (track && line && lead && last && end && rows.length && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const seg = (p: number, from: number, to: number) => Math.min(1, Math.max(0, (p - from) / (to - from)));
    const easeOut = (t: number) => 1 - (1 - t) ** 3;
    const easeIn = (t: number) => t ** 3;

    let reach = 0;
    let offsets: number[] = [];
    const measure = () => {
      reach = Math.max(0, last.offsetLeft + last.offsetWidth / 2 - innerWidth / 2);
      const box = end.getBoundingClientRect();
      const mid = box.top + box.height / 2;
      offsets = rows.map((r) => {
        // Read each row's resting place, ignoring its current transform.
        const m = new DOMMatrix(getComputedStyle(r).transform);
        const b = r.getBoundingClientRect();
        return mid - (b.top - m.m42 + b.height / 2);
      });
    };

    const render = (p: number) => {
      // 1. The line runs across.
      line.style.transform = `translate3d(${-reach * seg(p, 0, 0.4)}px, 0, 0)`;
      if (media) media.style.transform = `scale(${1 + p * 0.16})`;
      // 2. The rest of the line clears, the last word swells and dissolves into the list.
      lead.style.opacity = String(1 - seg(p, 0.38, 0.46));
      const swell = seg(p, 0.42, 0.56);
      last.style.transform = `scale(${1 + easeIn(swell) * 0.9})`;
      last.style.opacity = String(1 - seg(p, 0.46, 0.56));
      // 3. The list opens out from the centre, one row at a time, then closes.
      const close = easeIn(seg(p, 0.78, 0.88));
      rows.forEach((row, i) => {
        const open = easeOut(seg(p, 0.46 + i * 0.05, 0.56 + i * 0.05));
        const y = (offsets[i] ?? 0) * (1 - open + close);
        row.style.transform = `translate3d(0, ${y}px, 0) scale(${0.55 + 0.45 * open - 0.25 * close})`;
        row.style.opacity = String(open * (1 - close));
      });
      // 4. One word is left.
      const settle = easeOut(seg(p, 0.84, 0.94));
      end.style.opacity = String(settle);
      end.style.transform = `scale(${0.7 + 0.3 * settle})`;
    };

    const target = () => {
      const span = track.offsetHeight - innerHeight;
      return span > 0 ? Math.min(1, Math.max(0, -track.getBoundingClientRect().top / span)) : 0;
    };
    let now = target();
    let frame = 0;
    const tick = () => {
      const to = target();
      now += (to - now) * 0.14;
      if (Math.abs(to - now) < 0.0004) now = to;
      render(now);
      frame = now === to ? 0 : requestAnimationFrame(tick);
    };
    const wake = () => {
      if (!frame) frame = requestAnimationFrame(tick);
    };
    const refresh = () => {
      measure();
      render(now);
    };
    addEventListener('scroll', wake, { passive: true });
    addEventListener('resize', refresh);
    document.fonts?.ready.then(refresh);
    refresh();
  }
</script>
