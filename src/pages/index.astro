---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lines from '../components/Lines.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import { getPage, getServices, getSite, paragraphs, splitHeadline, toSection } from '../lib/content';

const site = await getSite();
const page = await getPage('home');
const about = await getPage('about');
const servicesPage = await getPage('services');
const workPage = await getPage('work');
const playlist = workPage.playlist;
const customers = servicesPage.customers;
const contact = await getPage('contact');
const services = await getServices();
// The headline, on two lines. Its last word is in italics, and the lines start from it.
const [headOne = '', headTwo = ''] = splitHeadline(page.headline);
const headLast = headTwo.split(' ').pop() ?? '';
const headRest = headTwo.slice(0, -headLast.length).trim();
const closing = page.hero_closing;
// Only the headline's last word and the closing line's take italics.
const stressed = [headLast, closing?.line.trim().split(/\s+/).pop()];
const video = page.hero_video;
const film = page.hero_film;

const people = about.sections ?? [];
---

<BaseLayout title={page.title} intro>
  <!-- Temporary: picks the font being auditioned, before the page paints. -->
  <script is:inline>
    (function () {
      var saved = null;
      try {
        saved = new URLSearchParams(location.search).get('font') || localStorage.getItem('wdm-font');
      } catch (e) {}
      if (saved) document.documentElement.dataset.font = saved;
    })();
  </script>
  <div class="pick" role="group" aria-label="Font">
    <button type="button" data-font-pick="">inter tight</button>
    <button type="button" data-font-pick="hanken">hanken grotesk</button>
    <button type="button" data-font-pick="geist">geist</button>
    <button type="button" data-font-pick="instrument">instrument sans</button>
    <button type="button" data-font-pick="dm">dm sans</button>
  </div>
  <!-- 00 — Hero: all the type is a window onto the footage, which holds still behind
       a beige sheet as the page scrolls, then the closing line holds a screen of its own.
       Without JS or with reduced
       motion the type sits still and stacked, over the poster. -->
  <section id="top" class={`hero${video ? ' has-video' : ''}`} aria-labelledby="hero-title" data-hero>
    {
      video && (
        <div class="hero-media" aria-hidden="true">
          <div class="hero-frame" data-hero-frame>
            <Image
              src={video.poster}
              alt=""
              widths={[640, 960, 1280, 1920].filter((w) => w <= video.poster.width)}
              width={Math.min(1920, video.poster.width)}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              quality={62}
              class="hero-poster"
            />
            <video class="hero-video" muted loop playsinline preload="none" disablepictureinpicture data-hero-video>
              {video.mobile_webm && <source src={video.mobile_webm} type="video/webm" media="(max-width: 767px)" />}
              {video.mobile_mp4 && <source src={video.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
              {video.webm && <source src={video.webm} type="video/webm" />}
              <source src={video.mp4} type="video/mp4" />
            </video>
          </div>
        </div>
      )
    }
    <div class="hero-sheet">
      <span class="hero-lift" aria-hidden="true"></span>
      <div class="hero-cut">
        <div class="hero-stage">
          <h1 id="hero-title" class="run display">
            <span class="run-line">{headOne}</span>
            <span class="run-line">{headRest} <em>{headLast}</em></span>
          </h1>
        </div>
        {
          closing && (
            <div class="bloom">
              <p class="bloom-end display" data-bloom-end>
                <span class="bloom-end-line">
                  {closing.line.split(' ').map((w) => (
                    <>
                      {stressed.includes(w) ? <em>{w}</em> : w}{' '}
                    </>
                  ))}
                </span>
                {closing.note && <span class="bloom-note">{closing.note}</span>}
              </p>
            </div>
          )
        }
      </div>
    </div>
    {
      closing?.outro && (
        <div class="reel" data-reel>
          <div class="reel-top">
            <span class="reel-wash" data-reel-wash />
            <span class="reel-edge" data-reel-edge />
            <div class="reel-title" data-reel-title>
              <p class="reel-text display" data-reel-text>
                {closing.outro}
              </p>
            </div>
          </div>
          <div class="reel-one" data-reel-one />
          {film && (
            <div class="reel-film" data-reel-film aria-hidden="true">
              <div class="reel-stage">
                <Image
                  src={film.poster}
                  alt=""
                  widths={[640, 960, 1280, 1920].filter((w) => w <= film.poster.width)}
                  width={Math.min(1920, film.poster.width)}
                  sizes="100vw"
                  loading="lazy"
                  decoding="async"
                  quality={62}
                  class="film-poster"
                />
                <video class="film-video" muted loop playsinline preload="none" disablepictureinpicture data-film-video>
                  {film.mobile_webm && <source src={film.mobile_webm} type="video/webm" media="(max-width: 767px)" />}
                  {film.mobile_mp4 && <source src={film.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
                  {film.webm && <source src={film.webm} type="video/webm" />}
                  <source src={film.mp4} type="video/mp4" />
                </video>
              </div>
            </div>
          )}
        </div>
      )
    }
    <div class="hero-bar">
        <div class="wrap hero-foot">
          {
            page.cta && (
              <a class="hero-cta label" href={toSection(page.cta.href)}>
                {page.cta.label} <span aria-hidden="true">↓</span>
              </a>
            )
          }
          {
            video && (
              <button
                type="button"
                class="hero-credit label"
                data-hero-toggle
                data-play={site.ui.play_video}
                data-pause={site.ui.pause_video}
              >
                {site.ui.pause_video}
              </button>
            )
          }
        </div>
    </div>
  </section>

  <!-- 01 — Services -->
  <section id="services" class="sec wrap" aria-labelledby="services-title">
    <SectionHead id="services-title" title={servicesPage.headline} />
    <ServiceGrid items={services} stills={[video?.poster, film?.poster]} />
    {
      customers && (
        <p class="customers" data-reveal>
          <span class="customers-label">{customers.label}:</span> {customers.list}
        </p>
      )
    }
  </section>


  <!-- 02 — About -->
  <section id="about" class="founder" aria-labelledby="about-title" data-founder>
    {
      video && (
        <div class="founder-media" aria-hidden="true">
          <Image
            src={video.poster}
            alt=""
            widths={[640, 960, 1280, 1920].filter((w) => w <= video.poster.width)}
            width={Math.min(1920, video.poster.width)}
            sizes="100vw"
            loading="lazy"
            decoding="async"
            quality={62}
            class="founder-poster"
          />
          <video class="founder-video" muted loop playsinline preload="none" disablepictureinpicture data-founder-video>
            {video.mobile_webm && <source src={video.mobile_webm} type="video/webm" media="(max-width: 767px)" />}
            {video.mobile_mp4 && <source src={video.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
            {video.webm && <source src={video.webm} type="video/webm" />}
            <source src={video.mp4} type="video/mp4" />
          </video>
          <span class="founder-shade" />
        </div>
      )
    }
    <div class="wrap founder-inner">
      <SectionHead id="about-title" title={about.section_title ?? about.title} />
      {
        people.map((person) => (
          <article class="bio">
            <Lines as="h2" class="bio-name display d-lg" lines={splitHeadline(person.heading)} />
            <div class="bio-body" data-reveal>
              {paragraphs(person.body).map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </article>
        ))
      }
      {
        video && (
          <button
            type="button"
            class="hero-credit label founder-pause"
            data-hero-toggle
            data-play={site.ui.play_video}
            data-pause={site.ui.pause_video}
          >
            {site.ui.pause_video}
          </button>
        )
      }
    </div>
  </section>

  <!-- 03 — Selected work: one Spotify playlist -->
  <section id="work" class="sec wrap" aria-labelledby="work-title">
    <SectionHead id="work-title" title={workPage.headline} />
    {
      playlist && (
        <>
          <iframe
            class="playlist"
            src={`https://open.spotify.com/embed/playlist/${playlist.spotify_id}`}
            title={playlist.title}
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          />
          <a class="sec-foot label link-line" href={`https://open.spotify.com/playlist/${playlist.spotify_id}`}>
            {playlist.link_label} <span aria-hidden="true">↗</span>
          </a>
        </>
      )
    }
  </section>

  <!-- 04 — Contact: one big email call to action -->
  <section id="contact" class="band band-cta" aria-labelledby="contact-title">
    <div class="wrap grid12 cta">
      <Lines as="h2" id="contact-title" class="cta-title display d-lg" lines={splitHeadline(contact.headline)} />
      <p class="cta-lede body-lg" data-reveal style="--i: 2">{contact.lede} {contact.intro}</p>
      <a class="cta-mail display" href={`mailto:${site.email}`} data-reveal style="--i: 3">
        <span class="cta-mail-text">{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</span>
        <span class="cta-mail-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: the type is a window onto the footage ---------- */
  .hero {
    --run-size: 15vw;
    --ease-soft: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    isolation: isolate;
    margin-top: calc(var(--header-h) * -1);
    scroll-margin-top: 0;
    overflow: clip;
  }

  /* Media stack: optimised poster (the LCP image) and the loop over it once it
     plays. The grade is baked into the footage and poster, so nothing is filtered
     per frame. */
  .hero-media {
    position: sticky;
    top: 0;
    height: 100svh;
    margin-bottom: -100svh;
    overflow: clip;
  }
  .hero-frame {
    position: absolute;
    inset: 0;
  }
  .hero-frame :global(.hero-poster),
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-video {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero.is-playing .hero-video {
    opacity: 1;
  }
  /* The sheet scrolls over the footage with its own shade underneath: inside the
     letters the brightest frame still gives 3.1:1 against the beige, and the footage
     below the sheet's edge is untouched. */
  .hero-sheet {
    position: relative;
  }
  .hero-lift {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 50%, transparent);
  }

  /* The sheet: beige everywhere, black type. "Lighten" keeps the higher of sheet and
     footage, so the sheet stays exactly beige and the footage shows only in the type. */
  .hero-cut {
    position: relative;
    background: var(--paper);
    color: #000;
    mix-blend-mode: lighten;
  }
  .run,
  .bloom-end {
    font-weight: 600;
  }
  .hero-stage {
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    padding: calc(var(--header-h) + 1rem) var(--gutter) 4.5rem;
  }
  .run {
    margin: 0;
    font-size: var(--run-size);
  }
  .run-line {
    display: block;
  }
  .run em,
  .bloom em {
    font-style: italic;
  }
  .bloom {
    padding: 0 var(--gutter) clamp(2rem, 5vw, 4rem);
  }
  .bloom-end {
    margin: 1.5rem 0 0;
    --line-size: calc((100vw - 2 * var(--gutter)) / var(--line-em, 10.4));
    font-size: var(--line-size);
    line-height: 0.95;
  }
  .bloom-end-line {
    display: block;
  }
  /* Large text for AA (24px or more), since it's also a window onto the footage. */
  .bloom-note {
    display: block;
    margin-top: 0.7em;
    font-size: clamp(1.5rem, 3.2vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  @media (min-width: 768px) {
    .hero {
      --run-size: min(22svh, 9.4vw);
    }
  }

  /* Past the sheet: one line over the footage at full screen, then the second film.
     The 50% ink keeps the line AA over white footage (3.4:1). */
  .reel {
    position: relative;
  }
  .reel-top {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: grid;
    place-items: center;
    height: 100svh;
    overflow: clip;
    color: var(--paper);
    text-align: center;
    pointer-events: none;
  }
  .reel-wash,
  .reel-edge {
    position: absolute;
    inset: 0;
  }
  .reel-wash {
    background: color-mix(in srgb, var(--ink) 50%, transparent);
  }
  /* Once the line has shrunk: enough shade behind it and the footer row to stay AA. */
  .reel-edge {
    opacity: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--ink) 55%, transparent) 0,
      color-mix(in srgb, var(--ink) 55%, transparent) 8.5rem,
      transparent 17rem,
      transparent calc(100% - 11rem),
      color-mix(in srgb, var(--ink) 80%, transparent) calc(100% - 3rem)
    );
  }
  .reel-title {
    position: relative;
  }
  .reel-text {
    margin: 0;
    font-size: min(24svh, 19vw);
    white-space: nowrap;
  }
  .reel-one {
    height: 100svh;
  }
  .reel-film {
    position: relative;
    z-index: 1;
    background: var(--ink);
  }
  .reel-stage {
    position: relative;
    height: 100svh;
    overflow: clip;
  }
  .reel-stage :global(.film-poster),
  .film-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-video {
    opacity: 0;
    transition: opacity 0.8s var(--ease-out);
  }
  .reel-film.is-playing .film-video {
    opacity: 1;
  }

  .hero-bar {
    position: relative;
    z-index: 4;
    background: var(--paper);
    transition:
      background-color 0.4s,
      color 0.4s;
  }
  /* Over the films the row drops its ground, leaving the frame clear. */
  .hero.in-reel .hero-bar {
    background: transparent;
    color: var(--paper);
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 2rem;
    padding-block: 0.75rem;
  }
  .hero-cta {
    display: inline-flex;
    margin-right: auto;
    gap: 0.5rem;
    padding: 0.35rem 0;
  }
  .hero-cta:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  /* A quiet pause/play control for the loops. */
  .hero-credit {
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .hero-credit:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .hero.in-reel .hero-bar :focus-visible {
    outline-color: var(--paper);
  }

  /* The sequence. The footage stays pinned for the whole hero while the sheet
     scrolls over it: words pop as the lines (drawn by the script below) reach them. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-frame {
      will-change: transform;
    }
    :global(html.js) .reel-top {
      position: sticky;
      top: 0;
      margin-bottom: -100svh;
    }
    :global(html.js) .reel-title {
      will-change: transform;
    }
    :global(html.js) .reel-text {
      opacity: 0;
      transform: translateY(0.2em) scale(0.92);
      transition:
        opacity 0.6s var(--ease-out),
        transform 1s var(--ease-out);
    }
    :global(html.js) .reel.is-in .reel-text {
      opacity: 1;
      transform: none;
    }
    :global(html.js) .reel-one {
      height: 165svh;
    }
    :global(html.js) .reel-film {
      height: 160svh;
    }
    :global(html.js) .reel-stage {
      position: sticky;
      top: 0;
    }
    /* Stays on screen for the whole hero (it holds the video's pause control), taking
       no space of its own, so it leaves with the last film. */
    :global(html.js) .hero-bar {
      position: sticky;
      bottom: 0;
      height: 0;
      background: none;
    }
    :global(html.js) .hero-foot {
      position: absolute;
      inset: auto 0 0;
      max-width: none;
      background: var(--paper);
      transition: background-color 0.4s;
    }
    :global(html.js) .hero.in-reel .hero-foot {
      background: transparent;
    }
    :global(html.js) .run-line {
      animation: run-in 1.2s var(--ease-out) both;
    }
    :global(html.js) .run-line + .run-line {
      animation-delay: 0.12s;
    }
    @keyframes run-in {
      from {
        opacity: 0;
        transform: translateY(0.18em);
      }
    }

    /* The closing line holds a screen of its own, a little longer than the scroll past it. */
    :global(html.js) .bloom {
      height: 130svh;
      padding: 0 var(--gutter);
    }
    :global(html.js) .bloom-end {
      position: sticky;
      top: 0;
      display: grid;
      align-content: center;
      justify-items: start;
      min-height: 100svh;
      margin: 0;
      font-size: min(22svh, var(--line-size));
      white-space: nowrap;
    }
    :global(html.js) .bloom-end-line {
      opacity: 0;
      transform: translateY(0.1em);
      transition:
        opacity 1.1s var(--ease-soft),
        transform 1.5s var(--ease-soft);
    }
    :global(html.js) .bloom-end.is-in .bloom-end-line {
      opacity: 1;
      transform: none;
    }
    :global(html.js) .bloom-note {
      opacity: 0;
      transition: opacity 1.2s var(--ease-soft) 0.4s;
    }
    :global(html.js) .bloom-end.is-in .bloom-note {
      opacity: 1;
    }
  }

  /* Temporary: the font switcher. */
  .pick {
    position: fixed;
    top: calc(var(--header-h) + 0.25rem);
    right: var(--gutter);
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    max-width: calc(100vw - 2 * var(--gutter));
    padding: 0.2rem;
    border-radius: 1.1rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8125rem;
  }
  .pick button {
    padding: 0.3rem 0.7rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .pick button[aria-pressed='true'] {
    background: var(--paper);
    color: var(--ink);
  }
  .pick :focus-visible {
    outline-color: var(--paper);
  }

  /* ---------- Sections ---------- */
  .sec {
    padding-block: clamp(1.75rem, 3.5vw, 3.25rem);
    scroll-margin-top: 4rem;
  }
  .sec-foot {
    display: inline-block;
    margin-top: 1.25rem;
  }
  /* Lands right after the last film, with room for the header. */
  #services {
    padding-top: calc(var(--header-h) + 1.25rem);
    scroll-margin-top: 0;
  }
  /* Who the company has worked for, directly under the last service. */
  .customers {
    margin: 0.5rem 0 0;
    font-size: clamp(1rem, 1.15vw, 1.125rem);
    font-weight: 450;
    letter-spacing: -0.005em;
    line-height: 1.3;
  }
  .customers-label {
    color: var(--muted);
  }
  .playlist {
    display: block;
    width: 100%;
    height: clamp(22rem, 58svh, 34rem);
    border: 0;
    border-radius: 12px;
  }
  .playlist.is-focused {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* The contact band runs straight into the footer. */
  :global(.site-footer) {
    margin-top: 0;
  }

  /* ---------- Full-width sections ---------- */
  .band {
    padding-block: clamp(1.75rem, 3.5vw, 3.25rem);
    scroll-margin-top: 4rem;
  }
  /* About — the name right beside the bio, in light type over the footage. The 65% ink
     keeps the bio at 5.2:1 over white footage. */
  .founder {
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--paper);
    scroll-margin-top: 0;
  }
  .founder :global(:focus-visible) {
    outline-color: var(--paper);
  }
  .founder-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
  }
  .founder-media :global(.founder-poster),
  .founder-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder-video {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .founder.is-playing .founder-video {
    opacity: 1;
  }
  .founder-shade {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--ink) 65%, transparent);
  }
  .founder-inner {
    padding-block: calc(var(--header-h) + 0.75rem) clamp(1.25rem, 2.5vw, 2rem);
  }
  .bio {
    display: grid;
    gap: 0.75rem clamp(1.5rem, 3vw, 3rem);
  }
  .bio + .bio {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .bio :global(.bio-name) {
    margin: 0;
  }
  .bio-body p {
    margin: 0;
    max-width: 34em;
    font-size: clamp(1.125rem, 1.6vw, 1.625rem);
    font-weight: 450;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  .founder-pause {
    display: block;
    margin: clamp(1.25rem, 2.5vw, 2rem) 0 0 auto;
  }

  /* Contact — one giant email link, in silver. */
  .band-cta {
    --soft: color-mix(in srgb, var(--ink) 74%, transparent);
  }
  .cta {
    row-gap: 1.5rem;
  }
  .cta :global(.cta-title) {
    grid-column: 1 / -1;
    margin: 0;
  }
  .cta-lede {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
    max-width: 44ch;
    color: var(--soft);
  }
  .cta-mail {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
    max-width: 100%;
    font-size: clamp(1.5rem, 6vw, 4rem);
    line-height: 1.05;
  }
  .cta-mail-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 0.04em;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.06em;
    transition: background-size 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-text {
    background-size: 100% 0.04em;
  }
  .cta-mail-arrow {
    font-size: 0.6em;
    transition: transform 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-arrow {
    transform: translate(0.12em, -0.12em);
  }

  @media (min-width: 900px) {
    .bio {
      grid-template-columns: max-content minmax(0, 1fr);
    }
    .cta-lede {
      grid-column: 1 / span 6;
    }
    .cta-mail {
      font-size: clamp(2.25rem, 4vw, 4.75rem);
    }
  }
</style>

<script>
  // The loops: they start after the page has loaded (so they never compete with the
  // poster image), pause off-screen and never autoplay under reduced motion. The small
  // pause controls, in the hero's footer row and the founder section, work on all of them
  // (WCAG 2.2.2).
  const hero = document.getElementById('top');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hero-toggle]'));
  if (hero && video && toggles.length) {
    const filmHost = document.querySelector<HTMLElement>('[data-reel-film]');
    const filmVideo = document.querySelector<HTMLVideoElement>('[data-film-video]');
    const clips = [{ video, host: hero, seen: true }];
    if (filmHost && filmVideo) clips.push({ video: filmVideo, host: filmHost, seen: false });
    const founderHost = document.querySelector<HTMLElement>('[data-founder]');
    const founderVideo = document.querySelector<HTMLVideoElement>('[data-founder-video]');
    if (founderHost && founderVideo) clips.push({ video: founderVideo, host: founderHost, seen: false });

    let wanted = !matchMedia('(prefers-reduced-motion: reduce)').matches; // play unless paused or reduced motion
    let started = false;

    const render = () => {
      for (const toggle of toggles) toggle.textContent = (wanted ? toggle.dataset.pause : toggle.dataset.play) ?? '';
    };
    const sync = () => {
      if (!started) return;
      for (const clip of clips) {
        if (wanted && clip.seen) {
          clip.video.preload = 'auto';
          clip.video.play().catch(() => {});
        } else clip.video.pause();
      }
    };
    for (const clip of clips) clip.video.addEventListener('playing', () => clip.host.classList.add('is-playing'));
    for (const toggle of toggles) {
      toggle.addEventListener('click', () => {
        wanted = !wanted;
        render();
        sync();
      });
    }

    // The first loop is in view until the second film has fully covered it.
    const cover = [document.querySelector('.hero-sheet'), document.querySelector('[data-reel-one]')].filter((el): el is Element => !!el);
    const inView = new Set<Element>();
    const firstWatch = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) inView.add(e.target);
        else inView.delete(e.target);
      }
      clips[0]!.seen = inView.size > 0;
      sync();
    });
    cover.forEach((el) => firstWatch.observe(el));
    for (const clip of clips.slice(1)) {
      new IntersectionObserver(
        ([e]) => {
          clip.seen = !!e?.isIntersecting;
          sync();
        },
        { rootMargin: '200px 0px' },
      ).observe(clip.host);
    }

    render();
    const begin = () => {
      started = true;
      sync();
    };
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(begin, { timeout: 1500 }) : setTimeout(begin, 300));
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }

  // Hero sequence. The closing line settles in as it arrives. Past the sheet, the reel's line shrinks away so the films can be watched.
  const frame = document.querySelector<HTMLElement>('[data-hero-frame]');
  const end = document.querySelector<HTMLElement>('[data-bloom-end]');
  const founder = document.querySelector<HTMLElement>('[data-founder]');
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const reelTitle = document.querySelector<HTMLElement>('[data-reel-title]');
  const reelText = document.querySelector<HTMLElement>('[data-reel-text]');
  const reelWash = document.querySelector<HTMLElement>('[data-reel-wash]');
  const reelEdge = document.querySelector<HTMLElement>('[data-reel-edge]');
  if (hero && end && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const seg = (v: number, from: number, to: number) => Math.min(1, Math.max(0, (v - from) / (to - from)));
    const MARK = 0.72;

    let endTop = 0;
    let heroTop = 0;
    let reelTop = 0;
    let reelEnd = 0;
    let titleLift = 0;
    let titleScale = 1;
    let founderTop = 0;
    let founderEnd = 0;

    // Coordinates are the hero's own.
    const measure = () => {
      const b = hero.getBoundingClientRect();
      heroTop = b.top + scrollY;
      if (reel && reelText) {
        const r = reel.getBoundingClientRect();
        reelTop = r.top + scrollY;
        reelEnd = r.bottom + scrollY;
        // The line ends just under the header, small enough to watch the film beneath it.
        const header = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0;
        titleLift = innerHeight / 2 - (header + 36);
        titleScale = 28 / parseFloat(getComputedStyle(reelText).fontSize);
      }
      // The line is centred in its screen, so it's about three quarters of the way down
      // the view when the mark reaches this point.
      endTop = end.parentElement!.getBoundingClientRect().top - b.top + innerHeight * 0.47;
      if (founder) {
        const f = founder.getBoundingClientRect();
        founderTop = f.top + scrollY;
        founderEnd = f.bottom + scrollY;
      }
    };

    const render = (y: number) => {
      // Over the first screen of the reel the line shrinks to the top and the shade clears.
      const clear = reel ? seg(y, reelTop, reelTop + innerHeight * 0.7) : 0;
      const ease = clear * clear * (3 - 2 * clear);
      if (frame) frame.style.transform = `scale(${1 + seg(y, heroTop, reelTop || heroTop + 1) * 0.16 * (1 - ease)})`;
      if (reelTitle) reelTitle.style.transform = `translate3d(0, ${-titleLift * ease}px, 0) scale(${1 + (titleScale - 1) * ease})`;
      if (reelWash) reelWash.style.opacity = String(1 - ease);
      if (reelEdge) reelEdge.style.opacity = String(ease);
      if (reel) {
        // The line arrives once the sheet has lifted about halfway off the footage.
        reel.classList.toggle('is-in', y + innerHeight * 0.45 >= reelTop);
        const inReel = y >= reelTop - innerHeight * 0.1 && y <= reelEnd;
        hero.classList.toggle('in-reel', inReel);
      }
      // The header turns light over the films and the founder section.
      const overFilm = reel ? y >= reelTop - 40 && y <= reelEnd - 40 : false;
      const overFounder = founder ? y + 40 >= founderTop && y + 40 <= founderEnd : false;
      document.documentElement.classList.toggle('on-reel', overFilm || overFounder);
      const mark = y + innerHeight * MARK - heroTop;
      end.classList.toggle('is-in', mark >= endTop);
    };

    let now = scrollY;
    let raf = 0;
    const tick = () => {
      now += (scrollY - now) * 0.1;
      if (Math.abs(scrollY - now) < 0.25) now = scrollY;
      render(now);
      raf = now === scrollY ? 0 : requestAnimationFrame(tick);
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const refresh = () => {
      measure();
      render(now);
    };
    addEventListener('scroll', wake, { passive: true });
    addEventListener('resize', refresh);
    document.fonts?.ready.then(refresh);
    refresh();
  }

  // Temporary: the font switcher. Stays where you are on the page, so fonts compare in place.
  const fontPicks = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-font-pick]'));
  const showFont = () =>
    fontPicks.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.fontPick === (document.documentElement.dataset.font ?? ''))));
  fontPicks.forEach((b) =>
    b.addEventListener('click', () => {
      const pick = b.dataset.fontPick ?? '';
      if (pick) document.documentElement.dataset.font = pick;
      else delete document.documentElement.dataset.font;
      try {
        localStorage.setItem('wdm-font', pick);
      } catch (e) {}
      showFont();
      document.fonts?.ready.then(() => dispatchEvent(new Event('resize')));
    }),
  );
  showFont();

  // Focus moves inside the playlist's frame, where CSS focus states can't see it, so
  // tabbing in marks the frame from here to give keyboard users a visible ring.
  const playlist = document.querySelector<HTMLIFrameElement>('.playlist');
  if (playlist) {
    let tabbing = false;
    addEventListener('keydown', (e) => (tabbing = e.key === 'Tab'), true);
    addEventListener('pointerdown', () => (tabbing = false), true);
    document.addEventListener('focusin', () => playlist.classList.remove('is-focused'));
    document.addEventListener('focusout', (e) => {
      if (tabbing && e.relatedTarget === playlist) playlist.classList.add('is-focused');
    });
    addEventListener('blur', () => {
      if (tabbing && document.activeElement === playlist) playlist.classList.add('is-focused');
    });
  }
</script>
