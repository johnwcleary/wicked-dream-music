---
import { Image } from 'astro:assets';
import logoUrl from '../assets/brand/wdm-lockup-white.svg?url';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import SoundToggle from '../components/SoundToggle.astro';
import { getPage, getServices, getSite, paragraphs, splitHeadline, toSection } from '../lib/content';

const site = await getSite();
const page = await getPage('home');
const about = await getPage('about');
const servicesPage = await getPage('services');
const workPage = await getPage('work');
const playlist = workPage.playlist;
const customers = servicesPage.customers;
const contact = await getPage('contact');
const services = await getServices();
// The headline, on two lines. Its last word is in italics, and the lines start from it.
const [headOne = '', headTwo = ''] = splitHeadline(page.headline);
const headLast = headTwo.split(' ').pop() ?? '';
const headRest = headTwo.slice(0, -headLast.length).trim();
const closing = page.hero_closing;
// The closing line is built around the headline's last word, which is shared between them.
const [closeBefore = '', closeAfter = ''] = closing ? closing.line.split(headLast).map((part) => part.trim()) : [];
const closeRest = closeAfter.split(' ');
const closeLast = closeRest.pop();
const video = page.hero_video;
// The reel plays the other films first and the opening's footage last.
const films = [...(page.hero_films ?? []), ...(video ? [video] : [])];

const people = about.sections ?? [];
---

<BaseLayout title={page.title} intro>
  <!-- 00 — Hero: all the type is a window onto the footage, which holds still behind
       a beige sheet. Scrolling keeps the headline's last word still and changes the words
       around it into the closing line.
       Without JS or with reduced
       motion the type sits still and stacked, over the poster. -->
  <section id="top" class={`hero${video ? ' has-video' : ''}`} aria-labelledby="hero-title" data-hero>
    {
      video && (
        <div class="hero-media" aria-hidden="true">
          <div class="hero-frame" data-hero-frame>
            <Image
              src={video.poster}
              alt=""
              widths={[640, 960, 1280, 1920].filter((w) => w <= video.poster.width)}
              width={Math.min(1920, video.poster.width)}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              quality={62}
              class="hero-poster"
            />
            <video class="hero-video" muted loop playsinline preload="none" disablepictureinpicture data-hero-video>
              {video.mobile_mp4 && <source src={video.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
              <source src={video.mp4} type="video/mp4" />
            </video>
          </div>
        </div>
      )
    }
    <!-- The opening: the footage at full screen with the logo centred. The beige sheet below
         rises over it and the site carries on from there. -->
    <div class="opening" data-opening>
      <span class="opening-logo" role="img" aria-label={site.name} style={`--logo-url: url(${logoUrl})`}></span>
      {
        page.cta && (
          <a class="opening-cta" href={toSection(page.cta.href)}>
            {page.cta.label} <span aria-hidden="true">↓</span>
          </a>
        )
      }
    </div>
    <div class="hero-sheet">
      <span class="hero-lift" aria-hidden="true"></span>
      <div class="hero-cut">
        <div class="hero-track" data-hero-track>
          <div class="hero-stage">
            <h1 id="hero-title" class="run display">
              <span class="run-line"><span class="run-old" data-run-old>{headOne}</span></span>
              <span class="run-line"><span class="run-old" data-run-old>{headRest}</span> <em data-sound-word>{headLast}</em></span>
            </h1>
            {
              closing && (
                <p class="closing display" data-closing>
                  <span class="closing-line">
                    <span class="closing-seg closing-lead" data-close-seg>{closeBefore}</span>{' '}
                    <em data-sound-slot>{headLast}</em>{' '}
                    <span class="closing-seg closing-lead" data-close-seg>{closeRest.join(' ')}</span>{' '}
                    <span class="closing-seg" data-close-seg>
                      <em>{closeLast}</em>
                    </span>
                  </span>
                  {closing.note && <span class="closing-note" data-close-note>{closing.note}</span>}
                </p>
              )
            }
          </div>
        </div>
      </div>
    </div>
    {
      closing?.outro && (
        <div class="reel" data-reel>
          <div class="reel-top">
            <span class="reel-edge" data-reel-edge />
            <span class="reel-foot" />
            <div class="reel-title" data-reel-title>
              <p class="reel-text display" data-reel-text>
                {closing.outro}
              </p>
            </div>
          </div>
          {films.map((film, i) => (
            <div class:list={['reel-film', { 'is-first': i === 0 }]} data-reel-film aria-hidden="true">
              <div class="reel-stage">
                <Image
                  src={film.poster}
                  alt=""
                  widths={[640, 960, 1280, 1920].filter((w) => w <= film.poster.width)}
                  width={Math.min(1920, film.poster.width)}
                  sizes="100vw"
                  loading="lazy"
                  decoding="async"
                  quality={62}
                  class="film-poster"
                />
                <video class="film-video" muted loop playsinline preload="none" disablepictureinpicture data-film-video>
                  {film.mobile_mp4 && <source src={film.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
                  <source src={film.mp4} type="video/mp4" />
                </video>
              </div>
            </div>
          ))}
        </div>
      )
    }
    <div class="hero-bar">
        <div class="wrap hero-foot">
          {
            video && (
              <>
                <SoundToggle on={site.ui.sound_on} off={site.ui.sound_off} />
                <button
                  type="button"
                  class="hero-credit label"
                  data-hero-toggle
                  data-play={site.ui.play_video}
                  data-pause={site.ui.pause_video}
                >
                  {site.ui.pause_video}
                </button>
              </>
            )
          }
        </div>
    </div>
  </section>

  <!-- 01 — Services -->
  <section id="services" class="sec wrap" aria-labelledby="services-title">
    <SectionHead id="services-title" title={servicesPage.headline} />
    <ServiceGrid items={services} stills={[video?.poster, films[0]?.poster]} />
    {
      customers && (
        <p class="customers" data-reveal>
          <span class="customers-label">{customers.label}:</span> {customers.list}
        </p>
      )
    }
  </section>


  <!-- 02 — About -->
  <section id="about" class="founder" aria-labelledby="about-title" data-founder>
    {
      video && (
        <div class="founder-media" aria-hidden="true">
          <Image
            src={video.poster}
            alt=""
            widths={[640, 960, 1280, 1920].filter((w) => w <= video.poster.width)}
            width={Math.min(1920, video.poster.width)}
            sizes="100vw"
            loading="lazy"
            decoding="async"
            quality={62}
            class="founder-poster"
          />
          <video class="founder-video" muted loop playsinline preload="none" disablepictureinpicture data-founder-video>
            {video.mobile_mp4 && <source src={video.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
            <source src={video.mp4} type="video/mp4" />
          </video>
          <span class="founder-shade" />
        </div>
      )
    }
    <div class="wrap founder-inner">
      <SectionHead id="about-title" title={about.section_title ?? about.title} still />
      {
        people.map((person) => (
          <article class="bio">
            <h2 class="bio-name display d-lg">
              {splitHeadline(person.heading).map((line) => (
                <span class="line">{line}</span>
              ))}
            </h2>
            <div class="bio-body">
              {paragraphs(person.body).map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </article>
        ))
      }
      {
        video && (
          <div class="founder-controls">
            <SoundToggle on={site.ui.sound_on} off={site.ui.sound_off} />
            <button
              type="button"
              class="hero-credit label"
              data-hero-toggle
              data-play={site.ui.play_video}
              data-pause={site.ui.pause_video}
            >
              {site.ui.pause_video}
            </button>
          </div>
        )
      }
    </div>
  </section>

  <!-- 03 — Selected work: one Spotify playlist -->
  <section id="work" class="sec wrap" aria-labelledby="work-title">
    <SectionHead id="work-title" title={workPage.headline} />
    {
      playlist && (
        <>
          <iframe
            class="playlist"
            src={`https://open.spotify.com/embed/playlist/${playlist.spotify_id}`}
            title={playlist.title}
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          />
          <a class="sec-foot label link-line" href={`https://open.spotify.com/playlist/${playlist.spotify_id}`}>
            {playlist.link_label} <span aria-hidden="true">↗</span>
          </a>
        </>
      )
    }
  </section>

  <!-- 04 — Contact: one big email call to action -->
  <section id="contact" class="band band-cta" aria-labelledby="contact-title">
    <div class="wrap grid12 cta">
      <h2 id="contact-title" class="cta-title display d-lg">
        {splitHeadline(contact.headline).map((line) => (
          <span class="line">{line}</span>
        ))}
      </h2>
      <p class="cta-lede body-lg">{contact.lede} {contact.intro}</p>
      <a class="cta-mail display" href={`mailto:${site.email}`}>
        <span class="cta-mail-text">{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</span>
        <span class="cta-mail-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: the type is a window onto the footage ---------- */
  .hero {
    --run-size: 15vw;
    --ease-soft: cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    isolation: isolate;
    margin-top: calc(var(--header-h) * -1);
    scroll-margin-top: 0;
    overflow: clip;
  }

  /* Media stack: optimised poster (the LCP image) and the loop over it once it
     plays. The grade is baked into the footage and poster, so nothing is filtered
     per frame. */
  /* The large viewport height, so footage reaches the foot of the screen on phones when
     the browser's toolbar collapses. */
  .hero-media {
    position: sticky;
    top: 0;
    height: 100lvh;
    margin-bottom: -100lvh;
    overflow: clip;
  }
  .hero-frame {
    position: absolute;
    inset: 0;
  }
  .hero-frame :global(.hero-poster),
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The poster sits over the video and fades once it plays. A video with no opacity stays
     eligible to play on iPhones, which can hold back video they consider hidden. */
  .hero-frame :global(.hero-poster) {
    z-index: 1;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero.is-playing .hero-frame :global(.hero-poster) {
    opacity: 0;
  }
  /* The opening: the footage untouched, with a neutral fade only behind the footer row to
     keep its small text AA, the logo centred and one pill beneath it. */
  .opening {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-content: center;
    justify-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    height: 100svh;
    padding: var(--header-h) var(--gutter) 3.5rem;
    background: linear-gradient(to bottom, transparent calc(100% - 7rem), color-mix(in srgb, var(--scrim) 70%, transparent) calc(100% - 1rem));
    color: var(--on-shade);
  }
  .opening-logo {
    display: block;
    width: min(clamp(14rem, 34vw, 30rem), 80svh);
    aspect-ratio: 324 / 208.3;
    background: #fff;
    -webkit-mask: var(--logo-url) center / contain no-repeat;
    mask: var(--logo-url) center / contain no-repeat;
  }
  .opening-cta {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    background: var(--on-shade);
    color: var(--shade);
    font-size: 0.9375rem;
    font-weight: 500;
    text-align: center;
    text-wrap: balance;
    transition: transform 0.4s var(--ease-out);
  }
  .opening-cta:hover {
    transform: translateY(2px);
  }
  .opening-cta:focus-visible {
    outline-color: var(--on-shade);
  }
  @media (max-width: 480px) {
    .opening-cta {
      padding: 0.5rem 0.9rem;
      font-size: 0.8125rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .opening-logo,
    :global(html.js) .opening-cta {
      animation: opening-in 1.6s var(--ease-out) both;
    }
    :global(html.js) .opening-cta {
      animation-delay: 0.35s;
    }
    @keyframes opening-in {
      from {
        opacity: 0;
        transform: translateY(0.75rem);
      }
    }
  }

  /* The sheet scrolls over the footage with its own shade underneath: inside the
     letters the brightest frame still gives 3.1:1 against the beige, and the footage
     below the sheet's edge is untouched. */
  .hero-sheet {
    position: relative;
  }
  .hero-lift {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--lift-color) var(--lift), transparent);
  }

  /* The sheet: beige everywhere, black type. "Lighten" keeps the higher of sheet and
     footage, so the sheet stays exactly beige and the footage shows only in the type. */
  .hero-cut {
    position: relative;
    background: var(--sheet);
    padding-bottom: 18svh;
    color: var(--sheet-type);
    mix-blend-mode: var(--sheet-blend);
  }
  .run,
  .closing {
    font-weight: 600;
  }
  .hero-stage {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    padding: calc(var(--header-h) + 1rem) var(--gutter) 4.5rem;
  }
  .run {
    margin: 0;
    font-size: var(--run-size);
  }
  .run-line {
    display: block;
  }
  .run em,
  .closing em {
    font-style: italic;
  }
  .closing {
    margin: 1.5rem 0 0;
    font-size: var(--run-size);
    line-height: 0.95;
  }
  /* "sound" and "brand" share a left edge, with the words before them set against it. The row
     gap clears the descender of the y above. On phones all four stack on that edge. */
  .closing-line {
    display: grid;
    justify-content: start;
    column-gap: 0.15em;
    row-gap: 0.16em;
  }
  @media (min-width: 768px) {
    .closing-line {
      grid-template-columns: max-content max-content;
    }
    .closing-lead {
      justify-self: end;
    }
  }
  /* Large text for AA (24px or more), since it's also a window onto the footage. */
  .closing-note {
    display: block;
    margin-top: 1.9em;
    text-align: center;
    font-size: clamp(1.5rem, 3.2vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  @media (min-width: 768px) {
    .hero {
      --run-size: min(22svh, 9.4vw);
    }
  }

  /* Past the sheet: one line over the first film at full screen, then the others.
     The 50% ink keeps the line AA over white footage (3.4:1). */
  .reel {
    position: relative;
  }
  .reel-top {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: grid;
    place-items: center;
    height: 100lvh;
    overflow: clip;
    color: var(--on-shade);
    text-align: center;
    pointer-events: none;
  }
  .reel-edge,
  .reel-foot {
    position: absolute;
    inset: 0;
  }
  /* The films run untouched. A neutral fade sits only behind the small text: the shrunken
     line, once it has shrunk, and the footer row. */
  .reel-edge {
    opacity: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--scrim) 55%, transparent) 0,
      color-mix(in srgb, var(--scrim) 50%, transparent) 8.5rem,
      color-mix(in srgb, var(--scrim) 22%, transparent) 11rem,
      color-mix(in srgb, var(--scrim) 7%, transparent) 13.5rem,
      transparent 16rem
    );
  }
  .reel-foot {
    background: linear-gradient(
      to bottom,
      transparent calc(100svh - 7rem),
      color-mix(in srgb, var(--scrim) 70%, transparent) calc(100svh - 1rem)
    );
  }
  .reel-title {
    position: relative;
  }
  .reel-text {
    margin: 0;
    font-size: min(24svh, 19vw);
    white-space: nowrap;
    /* No shade behind the big line, so a soft shadow holds it over bright footage. */
    text-shadow:
      0 0 0.12em color-mix(in srgb, var(--scrim) 45%, transparent),
      0 0 0.5em color-mix(in srgb, var(--scrim) 45%, transparent);
  }
  .reel-film {
    position: relative;
    z-index: 1;
    background: var(--shade);
  }
  .reel-stage {
    position: relative;
    height: 100lvh;
    overflow: clip;
  }
  .reel-stage :global(.film-poster),
  .film-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .reel-stage :global(.film-poster) {
    z-index: 1;
    transition: opacity 0.8s var(--ease-out);
  }
  .reel-film.is-playing :global(.film-poster) {
    opacity: 0;
  }

  .hero-bar {
    position: relative;
    z-index: 4;
    background: var(--foot-ground);
    transition:
      background-color 0.4s,
      color 0.4s;
  }
  /* Over the opening and the films the row drops its ground, leaving the frame clear. */
  .hero.in-reel .hero-bar,
  :global(html.intro-foot) .hero-bar {
    background: transparent;
    color: var(--on-shade);
  }
  .hero-foot {
    display: flex;
    justify-content: flex-end;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 2rem;
    padding-block: 0.75rem;
  }
  /* A quiet pause/play control for the loops. */
  .hero-credit {
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .hero-credit:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  :global(html.intro-foot) .hero-bar :focus-visible,
  .hero.in-reel .hero-bar :focus-visible {
    outline-color: var(--on-shade);
  }

  /* The sequence. The footage stays pinned for the whole hero while the sheet
     scrolls over it: words pop as the lines (drawn by the script below) reach them. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-frame {
      will-change: transform;
    }
    :global(html.js) .reel-top {
      position: sticky;
      top: 0;
      margin-bottom: -100lvh;
    }
    :global(html.js) .reel-title {
      will-change: transform;
    }
    :global(html.js) .reel-text {
      opacity: 0;
      transform: translateY(0.2em) scale(0.92);
      transition:
        opacity 0.6s var(--ease-out),
        transform 1s var(--ease-out);
    }
    :global(html.js) .reel.is-in .reel-text {
      opacity: 1;
      transform: none;
    }
    :global(html.js) .reel-film {
      height: 160svh;
    }
    /* The first film also holds while the line shrinks away. */
    :global(html.js) .reel-film.is-first {
      height: 230svh;
    }
    :global(html.js) .reel-stage {
      position: sticky;
      top: 0;
    }
    /* Stays on screen for the whole hero (it holds the video's pause control), taking
       no space of its own, so it leaves with the last film. */
    :global(html.js) .hero-bar {
      position: sticky;
      bottom: 0;
      height: 0;
      background: none;
    }
    :global(html.js) .hero-foot {
      position: absolute;
      inset: auto 0 0;
      max-width: none;
      background: var(--foot-ground);
      transition: background-color 0.4s;
    }
    :global(html.js) .hero.in-reel .hero-foot,
    :global(html.intro-foot) .hero-foot {
      background: transparent;
    }
    /* A pinned stage: the word stays put while the script changes the words around it.
       Both copies of the word share a box shape, so they line up exactly. */
    :global(html.js) .hero-track {
      height: 225svh;
    }
    /* Sits above centre, leaving room under the word for the lines that arrive. */
    :global(html.js) .hero-stage {
      position: sticky;
      top: 0;
      justify-content: center;
      height: 100svh;
      min-height: 0;
      padding-bottom: 30svh;
    }
    :global(html.js) .run-old {
      display: inline-block;
    }
    :global(html.js) .run-old,
    :global(html.js) .closing-seg {
      will-change: transform, opacity;
    }
    :global(html.js) [data-sound-word],
    :global(html.js) [data-sound-slot] {
      display: inline-block;
      line-height: 0.92;
    }
    :global(html.js) [data-sound-slot] {
      opacity: 0;
    }
    :global(html.js) .closing {
      position: absolute;
      top: 0;
      left: 0;
      margin: 0;
      font-size: var(--run-size);
      white-space: nowrap;
      pointer-events: none;
    }
    :global(html.js) .closing-seg,
    :global(html.js) .closing-note {
      opacity: 0;
    }
    :global(html.js) .closing-note {
      will-change: opacity;
    }
    @media (min-width: 768px) {
      :global(html.js) .run {
        white-space: nowrap;
      }
    }
  }

  /* ---------- Sections ---------- */
  .line {
    display: block;
  }
  .sec {
    padding-block: clamp(1.75rem, 3.5vw, 3.25rem);
    scroll-margin-top: 4rem;
  }
  .sec-foot {
    display: inline-block;
    margin-top: 1.25rem;
  }
  /* Lands right after the last film, with room for the header. */
  #services {
    padding-top: calc(var(--header-h) + 1.25rem);
    scroll-margin-top: 0;
  }
  /* Who the company has worked for, directly under the last service. */
  .customers {
    margin: 0.5rem 0 0;
    font-size: clamp(1rem, 1.15vw, 1.125rem);
    font-weight: 450;
    letter-spacing: -0.005em;
    line-height: 1.3;
  }
  .customers-label {
    color: var(--muted);
  }
  .playlist {
    display: block;
    width: 100%;
    height: clamp(22rem, 58svh, 34rem);
    border: 0;
    border-radius: 12px;
  }
  .playlist.is-focused {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  /* The contact band runs straight into the footer. */
  :global(.site-footer) {
    margin-top: 0;
  }

  /* ---------- Full-width sections ---------- */
  .band {
    padding-block: clamp(1.75rem, 3.5vw, 3.25rem);
    scroll-margin-top: 4rem;
  }
  /* About — the name right beside the bio, in light type over the footage. A neutral 65%
     shade keeps the bio at 5.3:1 or better over white footage. */
  .founder {
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--on-shade);
    scroll-margin-top: 0;
  }
  .founder :global(:focus-visible) {
    outline-color: var(--on-shade);
  }
  .founder-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--shade);
  }
  .founder-media :global(.founder-poster),
  .founder-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder-media :global(.founder-poster) {
    z-index: 1;
    transition: opacity 1.2s var(--ease-out);
  }
  .founder.is-playing :global(.founder-poster) {
    opacity: 0;
  }
  /* Above the poster too, so the bio stays legible while a video hasn't started. */
  .founder-shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: color-mix(in srgb, var(--scrim) 65%, transparent);
  }
  .founder-inner {
    padding-block: calc(var(--header-h) + 0.75rem) clamp(1.25rem, 2.5vw, 2rem);
  }
  .bio {
    display: grid;
    gap: 0.75rem clamp(1.5rem, 3vw, 3rem);
  }
  .bio + .bio {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }
  .bio .bio-name {
    margin: 0;
  }
  .bio-body p {
    margin: 0;
    max-width: 34em;
    font-size: clamp(1.125rem, 1.6vw, 1.625rem);
    font-weight: 450;
    line-height: 1.25;
    letter-spacing: -0.012em;
  }
  .founder-controls {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Contact — one giant email link, in silver. */
  .band-cta {
    --soft: color-mix(in srgb, var(--ink) 74%, transparent);
  }
  .cta {
    row-gap: 1.5rem;
  }
  .cta .cta-title {
    grid-column: 1 / -1;
    margin: 0;
  }
  .cta-lede {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
    max-width: 44ch;
    color: var(--soft);
  }
  .cta-mail {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
    max-width: 100%;
    font-size: clamp(1.5rem, 6vw, 4rem);
    line-height: 1.05;
  }
  .cta-mail-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 0.04em;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.06em;
    transition: background-size 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-text {
    background-size: 100% 0.04em;
  }
  .cta-mail-arrow {
    font-size: 0.6em;
    transition: transform 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-arrow {
    transform: translate(0.12em, -0.12em);
  }

  @media (min-width: 900px) {
    .bio {
      grid-template-columns: max-content minmax(0, 1fr);
    }
    .cta-lede {
      grid-column: 1 / span 6;
    }
    .cta-mail {
      font-size: clamp(2.25rem, 4vw, 4.75rem);
    }
  }
</style>

<script>
  // The loops: they start after the page has loaded (so they never compete with the
  // poster image), pause off-screen and never autoplay under reduced motion. The small
  // pause controls, in the hero's footer row and the founder section, work on all of them
  // (WCAG 2.2.2). Some phones block autoplay, in Low Power Mode for example: the posters stay
  // up, the controls offer play, and the next tap anywhere starts the videos.
  // Sound stays off until a speaker is pressed, then follows the clip at the middle of the
  // screen; only that clip is ever unmuted.
  const hero = document.getElementById('top');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-hero-toggle]'));
  if (hero && video && toggles.length) {
    const clips = [{ video, host: hero, seen: true }];
    document.querySelectorAll<HTMLElement>('[data-reel-film]').forEach((host) => {
      const clip = host.querySelector<HTMLVideoElement>('[data-film-video]');
      if (clip) clips.push({ video: clip, host, seen: false });
    });
    const founderHost = document.querySelector<HTMLElement>('[data-founder]');
    const founderVideo = document.querySelector<HTMLVideoElement>('[data-founder-video]');
    if (founderHost && founderVideo) clips.push({ video: founderVideo, host: founderHost, seen: false });

    let wanted = !matchMedia('(prefers-reduced-motion: reduce)').matches; // play unless paused or reduced motion
    let started = false;

    let blocked = false;
    let armed = false;
    let unblockedAt = 0;
    const render = () => {
      for (const toggle of toggles) toggle.textContent = (wanted && !blocked ? toggle.dataset.pause : toggle.dataset.play) ?? '';
    };
    const onBlocked = (error: unknown) => {
      if ((error as Error)?.name !== 'NotAllowedError') return;
      blocked = true;
      render();
      if (armed) return;
      armed = true;
      document.addEventListener('click', unblock, { capture: true });
      document.addEventListener('touchend', unblock, { capture: true, passive: true });
    };
    // Inside a tap the browser allows play(), and a video started once can play from then on.
    const unblock = () => {
      armed = false;
      unblockedAt = Date.now();
      document.removeEventListener('click', unblock, { capture: true });
      document.removeEventListener('touchend', unblock, { capture: true });
      blocked = false;
      render();
      if (!wanted) return;
      for (const clip of clips) {
        clip.video.preload = 'auto';
        clip.video
          .play()
          .then(() => {
            if (!clip.seen) clip.video.pause();
          })
          .catch(onBlocked);
      }
    };
    const sync = () => {
      if (!started) return;
      for (const clip of clips) {
        if (wanted && clip.seen) {
          clip.video.preload = 'auto';
          clip.video.play().catch(onBlocked);
        } else clip.video.pause();
      }
    };
    for (const clip of clips) clip.video.addEventListener('playing', () => clip.host.classList.add('is-playing'));

    const speakers = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]'));
    let sound = false;
    let granted = false;
    let current: (typeof clips)[number] | null = null;
    const renderSound = () => {
      for (const speaker of speakers) {
        speaker.classList.toggle('is-on', sound);
        speaker.setAttribute('aria-label', (sound ? speaker.dataset.off : speaker.dataset.on) ?? '');
      }
    };
    const applySound = () => {
      for (const clip of clips) {
        const audible = sound && clip === current;
        if (clip.video.muted !== audible) continue;
        clip.video.muted = !audible;
        if (!audible || clip.video.paused) continue;
        // iPhones can stop a video when it is unmuted: fall back to silent playback.
        clip.video.play().catch(() => {
          sound = false;
          clip.video.muted = true;
          renderSound();
          sync();
        });
      }
    };
    for (const speaker of speakers) {
      speaker.addEventListener('click', () => {
        sound = !sound;
        if (sound && !wanted) {
          wanted = true;
          render();
          sync();
        }
        // iPhones only let a video be unmuted later if it was started unmuted inside a tap.
        if (sound && !granted) {
          granted = true;
          for (const clip of clips) {
            clip.video.muted = false;
            clip.video.preload = 'auto';
            clip.video
              .play()
              .then(() => {
                if (!clip.seen) clip.video.pause();
              })
              .catch(onBlocked);
          }
          for (const clip of clips) clip.video.muted = clip !== current;
        }
        applySound();
        renderSound();
      });
    }
    const centred = new Map<Element, (typeof clips)[number]>();
    const isCentred = (el: Element) => {
      const box = el.getBoundingClientRect();
      return box.top <= innerHeight / 2 && box.bottom >= innerHeight / 2;
    };
    const atCentre = new IntersectionObserver(
      () => {
        current = Array.from(centred).find(([el]) => isCentred(el))?.[1] ?? null;
        applySound();
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    for (const toggle of toggles) {
      toggle.addEventListener('click', () => {
        // The tap that unblocked the videos has already started them.
        if (blocked || Date.now() - unblockedAt < 800) return;
        wanted = !wanted;
        render();
        sync();
      });
    }

    // The first loop is in view from the opening until the first film has covered it.
    const cover = [document.querySelector('[data-opening]'), document.querySelector('.hero-sheet')].filter((el): el is Element => !!el);
    const inView = new Set<Element>();
    const firstWatch = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) inView.add(e.target);
        else inView.delete(e.target);
      }
      clips[0]!.seen = inView.size > 0;
      sync();
    });
    cover.forEach((el) => {
      firstWatch.observe(el);
      centred.set(el, clips[0]!);
      atCentre.observe(el);
    });
    for (const clip of clips.slice(1)) {
      centred.set(clip.host, clip);
      atCentre.observe(clip.host);
    }
    for (const clip of clips.slice(1)) {
      new IntersectionObserver(
        ([e]) => {
          clip.seen = !!e?.isIntersecting;
          sync();
        },
        { rootMargin: '200px 0px' },
      ).observe(clip.host);
    }

    render();
    const begin = () => {
      started = true;
      sync();
    };
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(begin, { timeout: 1500 }) : setTimeout(begin, 300));
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }

  // Hero sequence. While the stage is pinned the headline's last word stays still, its other
  // words leave, and the closing line's arrive around it. Past the sheet, the reel's line shrinks away so the films can be watched.
  const frame = document.querySelector<HTMLElement>('[data-hero-frame]');
  const founder = document.querySelector<HTMLElement>('[data-founder]');
  const track = document.querySelector<HTMLElement>('[data-hero-track]');
  const soundWord = document.querySelector<HTMLElement>('[data-sound-word]');
  const soundSlot = document.querySelector<HTMLElement>('[data-sound-slot]');
  const closingLine = document.querySelector<HTMLElement>('[data-closing]');
  const oldWords = Array.from(document.querySelectorAll<HTMLElement>('[data-run-old]'));
  const newWords = Array.from(document.querySelectorAll<HTMLElement>('[data-close-seg]'));
  const closingNote = document.querySelector<HTMLElement>('[data-close-note]');
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const reelTitle = document.querySelector<HTMLElement>('[data-reel-title]');
  const reelText = document.querySelector<HTMLElement>('[data-reel-text]');
  const reelEdge = document.querySelector<HTMLElement>('[data-reel-edge]');
  if (hero && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const seg = (v: number, from: number, to: number) => Math.min(1, Math.max(0, (v - from) / (to - from)));

    let heroTop = 0;
    let reelTop = 0;
    let reelEnd = 0;
    let titleLift = 0;
    let titleScale = 1;
    let founderTop = 0;
    let founderEnd = 0;
    let trackTop = 0;
    let trackSpan = 0;

    // Coordinates are the hero's own.
    const measure = () => {
      const b = hero.getBoundingClientRect();
      heroTop = b.top + scrollY;
      if (reel && reelText) {
        const r = reel.getBoundingClientRect();
        reelTop = r.top + scrollY;
        reelEnd = r.bottom + scrollY;
        // The line ends just under the header, small enough to watch the film beneath it.
        const header = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0;
        const reelFrame = reelText.closest<HTMLElement>('.reel-top');
        titleLift = (reelFrame?.offsetHeight ?? innerHeight) / 2 - (header + 36);
        titleScale = 28 / parseFloat(getComputedStyle(reelText).fontSize);
      }
      if (track) {
        trackTop = track.getBoundingClientRect().top + scrollY;
        trackSpan = track.offsetHeight - innerHeight;
      }
      if (soundWord && soundSlot && closingLine) {
        // Lay the closing line over the headline so its gap sits exactly on the word.
        closingLine.style.transform = '';
        const word = soundWord.getBoundingClientRect();
        const slot = soundSlot.getBoundingClientRect();
        closingLine.style.transform = `translate3d(${word.left - slot.left}px, ${word.top - slot.top}px, 0)`;
        // The note centres on the page, wherever that leaves the lines above it.
        if (closingNote) {
          closingNote.style.translate = '';
          const note = closingNote.getBoundingClientRect();
          closingNote.style.translate = `${document.documentElement.clientWidth / 2 - (note.left + note.width / 2)}px`;
        }
      }
      if (founder) {
        const f = founder.getBoundingClientRect();
        founderTop = f.top + scrollY;
        founderEnd = f.bottom + scrollY;
      }
    };

    const render = (y: number) => {
      const smooth = (t: number) => t * t * (3 - 2 * t);
      const p = trackSpan > 0 ? seg(y, trackTop, trackTop + trackSpan) : 0;
      const out = smooth(seg(p, 0.02, 0.3));
      const arrive = smooth(seg(p, 0.23, 0.52));
      for (const el of oldWords) {
        el.style.opacity = String(1 - out);
        el.style.transform = out > 0 ? `translate3d(0, ${out * -38}%, 0)` : '';
      }
      for (const el of newWords) {
        el.style.opacity = String(arrive);
        el.style.transform = `translate3d(0, ${(1 - arrive) * 38}%, 0)`;
      }
      if (closingNote) closingNote.style.opacity = String(smooth(seg(p, 0.4, 0.63)));
      // Over the first screen of the reel the line shrinks to the top and the shade clears.
      const clear = reel ? seg(y, reelTop, reelTop + innerHeight * 0.7) : 0;
      const ease = clear * clear * (3 - 2 * clear);
      if (frame) frame.style.transform = `scale(${1 + seg(y, heroTop, reelTop || heroTop + 1) * 0.16 * (1 - ease)})`;
      if (reelTitle) reelTitle.style.transform = `translate3d(0, ${-titleLift * ease}px, 0) scale(${1 + (titleScale - 1) * ease})`;
      if (reelEdge) reelEdge.style.opacity = String(ease);
      if (reel) {
        // The line arrives once the sheet has lifted about halfway off the footage.
        reel.classList.toggle('is-in', y + innerHeight * 0.45 >= reelTop);
        // From when the first film reaches the footer row at the foot of the screen.
        const inReel = y >= reelTop - innerHeight + 50 && y <= reelEnd;
        hero.classList.toggle('in-reel', inReel);
      }
      // The header turns light over the films and the founder section.
      const overFilm = reel ? y >= reelTop - 40 && y <= reelEnd - 40 : false;
      const overFounder = founder ? y + 40 >= founderTop && y + 40 <= founderEnd : false;
      document.documentElement.classList.toggle('on-reel', overFilm || overFounder);
    };

    let now = scrollY;
    let raf = 0;
    const tick = () => {
      now += (scrollY - now) * 0.1;
      if (Math.abs(scrollY - now) < 0.25) now = scrollY;
      render(now);
      raf = now === scrollY ? 0 : requestAnimationFrame(tick);
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const refresh = () => {
      measure();
      render(now);
    };
    addEventListener('scroll', wake, { passive: true });
    addEventListener('resize', refresh);
    document.fonts?.ready.then(refresh);
    refresh();
  }

  // Focus moves inside the playlist's frame, where CSS focus states can't see it, so
  // tabbing in marks the frame from here to give keyboard users a visible ring.
  const playlist = document.querySelector<HTMLIFrameElement>('.playlist');
  if (playlist) {
    let tabbing = false;
    addEventListener('keydown', (e) => (tabbing = e.key === 'Tab'), true);
    addEventListener('pointerdown', () => (tabbing = false), true);
    document.addEventListener('focusin', () => playlist.classList.remove('is-focused'));
    document.addEventListener('focusout', (e) => {
      if (tabbing && e.relatedTarget === playlist) playlist.classList.add('is-focused');
    });
    addEventListener('blur', () => {
      if (tabbing && document.activeElement === playlist) playlist.classList.add('is-focused');
    });
  }
</script>
