---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Lines from '../components/Lines.astro';
import WordField from '../components/WordField.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceAccordion from '../components/ServiceAccordion.astro';
import WorkAccordion from '../components/WorkAccordion.astro';
import { getPage, getServices, getSite, getWork, pad, paragraphs, splitHeadline, toSection } from '../lib/content';

const site = await getSite();
const page = await getPage('home');
const about = await getPage('about');
const servicesPage = await getPage('services');
const workPage = await getPage('work');
const contact = await getPage('contact');
const services = await getServices();
const work = await getWork();
const [h1a, h1b] = splitHeadline(page.headline);
const video = page.hero_video;

const chapters = about.sections ?? [];
// Pull quote: the credentials line from the first chapter, repeated as a closing statement.
const firstParas = chapters[0] ? paragraphs(chapters[0].body) : [];
const quote = firstParas[firstParas.length - 1];
---

<BaseLayout title={page.title} description={page.lede} intro>
  <!-- 00 — Hero: full-screen video loop under the header, wordmark and line on top -->
  <section id="top" class={`hero${video ? ' has-video' : ''}`} aria-labelledby="hero-title">
    {
      video && (
        <div class="hero-media" aria-hidden="true">
          <Image
            src={video.poster}
            alt=""
            widths={[640, 960, 1280, 1920].filter((w) => w <= video.poster.width)}
            width={Math.min(1920, video.poster.width)}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            quality={62}
            class="hero-poster"
          />
          <video class="hero-video" muted loop playsinline preload="none" disablepictureinpicture data-hero-video>
            {video.mobile_webm && <source src={video.mobile_webm} type="video/webm" media="(max-width: 767px)" />}
            {video.mobile_mp4 && <source src={video.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
            {video.webm && <source src={video.webm} type="video/webm" />}
            <source src={video.mp4} type="video/mp4" />
          </video>
          <span class="hero-shade" />
        </div>
      )
    }
    <div class="wrap grid12 hero-grid">
      <div class="hero-logo">
        <Logo label={site.name} class="hero-logo-svg" />
      </div>
      <div class="hero-copy">
        <Lines as="h1" id="hero-title" class="hero-title display" lines={[h1a, h1b]} i={2} />
        <p class="hero-lede body-lg" data-reveal style="--i: 4">{page.lede}</p>
        {
          page.cta && (
            <a class="hero-cta" href={toSection(page.cta.href)} data-reveal style="--i: 5">
              {page.cta.label} <span aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
      <div class="hero-foot">
        <p class="hero-strap label label-muted">{page.strapline}</p>
        {
          video && (
            <button
              type="button"
              class="hero-credit label"
              data-hero-toggle
              data-play={`${site.ui.play_video}: ${video.title}`}
              data-pause={`${site.ui.pause_video}: ${video.title}`}
              aria-label={`${site.ui.pause_video}: ${video.title}`}
            >
              {video.title}
            </button>
          )
        }
      </div>
    </div>
  </section>

  <!-- Artists. Ideas. Sound. Culture. — with the four plates set into the line -->
  <WordField words={site.ticker} items={work} />

  <!-- 01 — Services -->
  <section id="services" class="sec wrap" aria-labelledby="services-title">
    <SectionHead id="services-title" title={servicesPage.headline} count={services.length} kicker={servicesPage.lede} number={1} />
    <ServiceAccordion items={services} />
  </section>

  <!-- 02 — About: a dark band to break the page up -->
  <section id="about" class="band band-ink" aria-labelledby="about-label">
    <div class="wrap">
      <p id="about-label" class="band-label label" data-reveal>
        <span aria-hidden="true">{pad(2)} —</span> {about.title}
      </p>
      <div class="chaps grid12">
        {
          chapters.map((c, i) => (
            <article class="chap" data-reveal style={`--i: ${i + 1}`}>
              <p class="chap-no label" aria-hidden="true">
                {pad(2)}.{i + 1}
              </p>
              <Lines as="h2" class="chap-title display d-md" lines={splitHeadline(c.heading)} i={i + 1} />
              <div class="chap-body">
                {paragraphs(c.body).map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>
      {
        quote && (
          <figure class="pull" aria-hidden="true">
            <blockquote class="pull-q display" data-reveal>
              <p>
                <span class="pull-fill">“{quote}”</span>
              </p>
            </blockquote>
            <figcaption class="pull-cap label">— {site.name}</figcaption>
          </figure>
        )
      }
    </div>
  </section>

  <!-- 03 — Selected work -->
  <section id="work" class="sec wrap" aria-labelledby="work-title">
    <SectionHead id="work-title" title={workPage.headline} count={work.length} kicker={workPage.lede} number={3} />
    <WorkAccordion items={work} />
    {workPage.footnote && <p class="sec-foot label label-muted">{workPage.footnote}</p>}
  </section>

  <!-- 04 — Contact: one big email call to action -->
  <section id="contact" class="band band-lav" aria-labelledby="contact-title">
    <div class="wrap grid12 cta">
      <p class="band-label label cta-label" data-reveal>
        <span aria-hidden="true">{pad(4)} —</span> {contact.intro_heading}
      </p>
      <Lines as="h2" id="contact-title" class="cta-title display d-lg" lines={splitHeadline(contact.headline)} />
      <p class="cta-lede body-lg" data-reveal style="--i: 2">{contact.lede} {contact.intro}</p>
      <a class="cta-mail display" href={`mailto:${site.email}`} data-reveal style="--i: 3">
        <span class="cta-mail-text">{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</span>
        <span class="cta-mail-arrow" aria-hidden="true">↗</span>
      </a>
      <p class="cta-loc label" data-reveal style="--i: 4">{site.location}</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: full-screen video under the header ---------- */
  .hero {
    --hero-soft: rgb(253 252 248 / 0.86);
    --hero-muted: rgb(253 252 248 / 0.7);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: max(36rem, 100svh);
    margin-top: calc(var(--header-h) * -1);
    padding-block: calc(var(--header-h) + 1.25rem) clamp(1.25rem, 2.5vw, 2rem);
    background: var(--ink);
    color: var(--paper);
    overflow: clip;
    scroll-margin-top: 0;
  }
  .hero:not(.has-video) {
    min-height: 0;
  }
  .hero :global(:focus-visible) {
    outline-color: var(--paper);
  }
  .hero :global(.label-muted) {
    color: var(--hero-muted);
  }

  /* Media stack: optimised poster (the LCP image), the loop over it once it
     plays, and a shade that keeps text AA. The lavender grade is baked into the
     footage and poster, so nothing is filtered per frame. */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-media :global(.hero-poster),
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-video {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero.is-playing .hero-video {
    opacity: 1;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(19 6 26 / 0.72) 0%, rgb(19 6 26 / 0.18) 22%, rgb(19 6 26 / 0.25) 45%, rgb(19 6 26 / 0.9) 82%, rgb(19 6 26 / 0.96) 100%),
      linear-gradient(to right, rgb(19 6 26 / 0.35), transparent 60%);
  }

  .hero-grid {
    row-gap: 1.5rem;
    align-items: end;
    width: 100%;
  }
  .hero-logo {
    grid-column: 1 / span 9;
  }
  .hero-logo :global(.hero-logo-svg) {
    display: block;
    width: 100%;
    height: auto;
    color: var(--wdm-lavender);
    filter: drop-shadow(0 6px 30px rgb(19 6 26 / 0.45));
  }
  /* One-time intro: the wordmark rises into view from the bottom up. */
  :global(html.intro) .hero-logo :global(.hero-logo-svg) {
    animation: logo-load 1.1s cubic-bezier(0.33, 1, 0.68, 1) both;
  }
  @keyframes logo-load {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .hero-copy {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.4rem, 10.5vw, 3.5rem);
  }
  .hero-lede {
    margin: 0;
    max-width: 34ch;
    color: var(--hero-soft);
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
    padding: 0.85rem 1.35rem;
    border-radius: 999px;
    background: var(--wdm-lavender);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 560;
    letter-spacing: -0.005em;
    transition:
      background-color 0.3s,
      transform 0.4s var(--ease-out);
  }
  .hero-cta:hover {
    background: var(--wdm-pink);
  }
  .hero-cta span[aria-hidden] {
    display: inline-block;
    transition: transform 0.4s var(--ease-out);
  }
  .hero-cta:hover span[aria-hidden] {
    transform: translateY(0.2rem);
  }
  .hero-foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgb(253 252 248 / 0.22);
  }
  .hero-strap {
    margin: 0;
  }
  /* The credit doubles as a quiet pause/play control for the loop. */
  .hero-credit {
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: var(--hero-soft);
    cursor: pointer;
  }
  .hero-credit:hover {
    color: var(--paper);
  }

  @media (min-width: 900px) {
    .hero-grid {
      row-gap: 2rem;
    }
    .hero-logo {
      grid-column: 1 / span 7;
    }
    .hero-copy {
      grid-column: 9 / -1;
      padding-bottom: 0.25rem;
    }
    .hero-title {
      font-size: clamp(2.75rem, 4.6vw, 5.25rem);
    }
  }

  /* As the hero leaves: the wordmark lifts away, the footage pushes in and darkens. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-logo {
        animation: hero-out linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
        transform-origin: 0 100%;
      }
      @keyframes hero-out {
        to {
          transform: translateY(-12%) scale(0.92);
          opacity: 0.2;
        }
      }
      .hero-media {
        animation: hero-push linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      @keyframes hero-push {
        to {
          transform: scale(1.08);
          filter: brightness(0.45);
        }
      }
    }
  }

  /* ---------- Sections ---------- */
  .sec {
    padding-block: clamp(3rem, 7vw, 6rem);
    scroll-margin-top: 4rem;
  }
  .sec-foot {
    margin: 1.25rem 0 0;
    max-width: 52ch;
  }

  /* The contact band runs straight into the footer. */
  :global(.site-footer) {
    margin-top: 0;
  }

  /* ---------- Full-bleed bands that break up the paper ---------- */
  .band {
    padding-block: clamp(4rem, 9vw, 8rem);
    scroll-margin-top: 4rem;
  }
  .band-label {
    margin: 0 0 clamp(2.5rem, 6vw, 5rem);
  }

  /* About — ink band, the two chapters side by side, the quote highlighted. */
  .band-ink {
    --soft: rgb(253 252 248 / 0.82);
    background: var(--ink);
    color: var(--paper);
  }
  .band-ink :global(:focus-visible) {
    outline-color: var(--paper);
  }
  .band-ink .band-label,
  .chap-no {
    color: var(--wdm-lavender);
  }
  .chaps {
    row-gap: clamp(3rem, 7vw, 5rem);
  }
  /* Each chapter is a row: title left, body right. */
  .chap {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    padding-top: 1rem;
    border-top: 1px solid rgb(253 252 248 / 0.22);
  }
  .chap > * {
    grid-column: 1 / -1;
  }
  .chap-no {
    margin: 0 0 1.25rem;
  }
  .chap :global(.chap-title) {
    margin: 0 0 1.5rem;
  }
  .chap-body p {
    margin: 0 0 1em;
    max-width: 40ch;
    color: var(--soft);
    font-size: clamp(1.125rem, 1.4vw, 1.3125rem);
    line-height: 1.5;
    letter-spacing: -0.006em;
  }
  .pull {
    margin: clamp(5rem, 11vw, 9rem) 0 0;
  }
  .pull-q {
    margin: 0;
  }
  .pull-q p {
    margin: 0;
    font-size: clamp(2rem, 4.8vw, 5rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-indent: -0.4em;
  }
  .pull-cap {
    margin-top: 1.5rem;
    color: var(--wdm-lavender);
  }
  /* The quote is set in the brand gradient (lavender to pink across each line). */
  .pull-fill {
    color: var(--wdm-lavender);
  }
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .pull-fill {
      color: transparent;
      background-image: linear-gradient(90deg, var(--wdm-lavender), var(--wdm-pink));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }
  }

  /* Contact — lavender band, one giant email link. */
  .band-lav {
    --ink-soft: rgb(19 6 26 / 0.78); /* ~6:1 on lavender */
    background: var(--wdm-lavender);
    color: var(--ink);
  }
  .cta {
    row-gap: 1.5rem;
  }
  .cta-label,
  .cta-loc {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--ink-soft);
  }
  .cta :global(.cta-title) {
    grid-column: 1 / -1;
    margin: 0;
  }
  .cta-lede {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
    max-width: 44ch;
    color: var(--ink-soft);
  }
  .cta-mail {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
    max-width: 100%;
    font-size: clamp(2rem, 8.4vw, 8.5rem);
    line-height: 1.05;
  }
  .cta-mail-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 0.06em;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.06em;
    transition: background-size 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-text {
    background-size: 100% 0.12em;
  }
  .cta-mail-arrow {
    font-size: 0.6em;
    transition: transform 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-arrow {
    transform: translate(0.12em, -0.12em);
  }
  .cta-loc {
    margin-top: 0.5rem;
  }

  @media (min-width: 900px) {
    .chap > :global(.chap-title) {
      grid-column: 1 / span 5;
    }
    .chap > .chap-body {
      grid-column: 7 / -1;
    }
    .pull-q,
    .pull-cap {
      max-width: 85%;
      margin-left: auto;
    }
    .cta-lede {
      grid-column: 1 / span 6;
    }
    .cta-mail {
      font-size: clamp(3rem, 6.4vw, 8rem);
    }
  }
</style>

<script>
  // Hero loop: starts after the page has loaded (so it never competes with the
  // poster image), pauses off-screen and never autoplays under reduced motion.
  // The title credit doubles as the pause/play control (WCAG 2.2.2).
  const hero = document.getElementById('top');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (hero && video && toggle) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let wanted = !reduce.matches; // play unless the visitor paused it or prefers reduced motion
    let visible = true;

    const render = () => {
      const playing = !video.paused;
      toggle.setAttribute('aria-label', (playing ? toggle.dataset.pause : toggle.dataset.play) ?? '');
      hero.classList.toggle('is-playing', playing);
    };
    const sync = () => {
      if (wanted && visible) {
        video.preload = 'auto';
        video.play().catch(() => {});
      } else video.pause();
    };
    video.addEventListener('playing', render);
    video.addEventListener('pause', render);
    toggle.addEventListener('click', () => {
      wanted = video.paused;
      sync();
    });
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      sync();
    }).observe(hero);

    render();
    const begin = () => ('requestIdleCallback' in window ? requestIdleCallback(sync, { timeout: 1500 }) : setTimeout(sync, 300));
    if (document.readyState === 'complete') begin();
    else addEventListener('load', begin, { once: true });
  }
</script>
