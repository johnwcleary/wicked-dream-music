---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Lines from '../components/Lines.astro';
import PhotoField from '../components/PhotoField.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceAccordion from '../components/ServiceAccordion.astro';
import WorkAccordion from '../components/WorkAccordion.astro';
import ContactForm from '../components/ContactForm.astro';
import { getPage, getServices, getSite, getWork, pad, paragraphs, splitHeadline, toSection } from '../lib/content';

const site = await getSite();
const page = await getPage('home');
const about = await getPage('about');
const servicesPage = await getPage('services');
const workPage = await getPage('work');
const contact = await getPage('contact');
const services = await getServices();
const work = await getWork();
const [h1a, h1b] = splitHeadline(page.headline);
const video = page.hero_video;

const chapters = about.sections ?? [];
// Pull quote: the credentials line from the first chapter, repeated as a closing statement.
const firstParas = chapters[0] ? paragraphs(chapters[0].body) : [];
const quote = firstParas[firstParas.length - 1];
---

<BaseLayout title={page.title} description={page.lede} intro>
  <!-- 00 — Hero: full-screen video loop under the header, wordmark and line on top -->
  <section id="top" class={`hero${video ? ' has-video' : ''}`} aria-labelledby="hero-title">
    {
      video && (
        <div class="hero-media" aria-hidden="true">
          <Image
            src={video.poster}
            alt=""
            widths={[640, 960, 1280, 1920].filter((w) => w <= video.poster.width)}
            width={Math.min(1920, video.poster.width)}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            quality={62}
            class="hero-poster"
          />
          <video class="hero-video" muted loop playsinline preload="none" disablepictureinpicture data-hero-video>
            {video.mobile_webm && <source src={video.mobile_webm} type="video/webm" media="(max-width: 767px)" />}
            {video.mobile_mp4 && <source src={video.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
            {video.webm && <source src={video.webm} type="video/webm" />}
            <source src={video.mp4} type="video/mp4" />
          </video>
          <span class="hero-shade" />
        </div>
      )
    }
    <div class="wrap grid12 hero-grid">
      <p class="hero-eyebrow label">
        <span><span class="label-muted" aria-hidden="true">{pad(0)} —</span> {page.eyebrow}</span>
        <span class="hero-count" aria-hidden="true" data-count></span>
      </p>
      <div class="hero-logo">
        <Logo label={site.name} class="hero-logo-svg" />
      </div>
      <div class="hero-copy">
        <Lines as="h1" id="hero-title" class="hero-title display" lines={[h1a, h1b]} i={2} />
        <p class="hero-lede body-lg" data-reveal style="--i: 4">{page.lede}</p>
        {
          page.cta && (
            <a class="hero-cta" href={toSection(page.cta.href)} data-reveal style="--i: 5">
              {page.cta.label} <span aria-hidden="true">↓</span>
            </a>
          )
        }
      </div>
      <div class="hero-foot">
        <p class="hero-strap label label-muted">{page.strapline}</p>
        {
          video && (
            <div class="hero-player">
              <span class="hero-credit label" aria-hidden="true">
                <span class="hero-eq">
                  <i />
                  <i />
                  <i />
                </span>
                {video.title}
              </span>
              <button
                type="button"
                class="hero-toggle label"
                data-hero-toggle
                data-play={site.ui.play_video}
                data-pause={site.ui.pause_video}
                hidden
              >
                <span class="hero-toggle-icon" aria-hidden="true" />
                <span class="hero-toggle-text">{site.ui.pause_video}</span>
              </button>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <PhotoField items={work} />

  <div class="tick-sec wrap">
    <p class="ticker display">
      {
        site.ticker.map((word, i) => (
          <span class={`tw tw-${i + 1}`}>
            <span class="tw-in" data-reveal style={`--i: ${i}`}>
              <span class="tw-no label" aria-hidden="true">{pad(i + 1)}</span>
              {word}{' '}
            </span>
          </span>
        ))
      }
    </p>
  </div>

  <!-- 01 — About -->
  <section id="about" class="sec sec-about wrap" aria-label={about.title}>
    {
      chapters.map((c, i) => (
        <div class="chap grid12">
          <span class="chap-rule" data-reveal="rule" aria-hidden="true" />
          <p class="chap-no label" aria-hidden="true" data-reveal>
            {pad(1)}.{i + 1}
          </p>
          <Lines as="h2" class="chap-title display d-sm" lines={splitHeadline(c.heading)} />
          <div class="chap-body" data-reveal style="--i: 2">
            {paragraphs(c.body).map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </div>
      ))
    }
    {
      quote && (
        <figure class="pull grid12" aria-hidden="true">
          <blockquote class="pull-q display" data-reveal="mark">
            <p>
              <span class="pull-fill">“{quote}”</span>
            </p>
          </blockquote>
          <figcaption class="pull-cap label label-muted">— {site.name}</figcaption>
        </figure>
      )
    }
  </section>

  <!-- 02 — Services -->
  <section id="services" class="sec wrap" aria-labelledby="services-title">
    <SectionHead id="services-title" title={servicesPage.headline} count={services.length} kicker={servicesPage.lede} number={2} />
    <ServiceAccordion items={services} />
  </section>

  <!-- 03 — Selected work -->
  <section id="work" class="sec wrap" aria-labelledby="work-title">
    <SectionHead id="work-title" title={workPage.headline} count={work.length} kicker={workPage.lede} number={3} />
    <WorkAccordion items={work} />
    {workPage.footnote && <p class="sec-foot label label-muted">{workPage.footnote}</p>}
  </section>

  <!-- 04 — Contact -->
  <section id="contact" class="sec wrap" aria-labelledby="contact-title">
    <SectionHead id="contact-title" title={contact.headline} kicker={contact.lede} number={4} />
    <div class="grid12 enquire">
      <div class="aside" data-reveal>
        <h3 class="display d-sm aside-title">{contact.intro_heading}</h3>
        <p class="aside-intro">{contact.intro}</p>
        <div class="aside-mail">
          <p class="label label-muted">{contact.email_label}</p>
          <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
          <p class="label label-muted">{site.location}</p>
        </div>
      </div>
      <div class="form-col" data-reveal style="--i: 2">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: full-screen video under the header ---------- */
  .hero {
    --hero-soft: rgb(253 252 248 / 0.86);
    --hero-muted: rgb(253 252 248 / 0.7);
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: max(36rem, 100svh);
    margin-top: calc(var(--header-h) * -1);
    padding-block: calc(var(--header-h) + 1.25rem) clamp(1.25rem, 2.5vw, 2rem);
    background: var(--ink);
    color: var(--paper);
    overflow: clip;
    scroll-margin-top: 0;
  }
  .hero:not(.has-video) {
    min-height: 0;
  }
  .hero :global(:focus-visible) {
    outline-color: var(--paper);
  }
  .hero :global(.label-muted) {
    color: var(--hero-muted);
  }

  /* Media stack: optimised poster (the LCP image), the loop over it once it
     plays, and a shade that keeps text AA. The lavender grade is baked into the
     footage and poster, so nothing is filtered per frame. */
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero-media :global(.hero-poster),
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-video {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero.is-playing .hero-video {
    opacity: 1;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(19 6 26 / 0.72) 0%, rgb(19 6 26 / 0.18) 22%, rgb(19 6 26 / 0.25) 45%, rgb(19 6 26 / 0.9) 82%, rgb(19 6 26 / 0.96) 100%),
      linear-gradient(to right, rgb(19 6 26 / 0.35), transparent 60%);
  }

  .hero-grid {
    row-gap: 1.5rem;
    align-items: end;
    width: 100%;
  }
  .hero-eyebrow {
    grid-column: 1 / -1;
    align-self: start;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 auto;
    text-shadow: 0 1px 12px rgb(19 6 26 / 0.6);
  }
  .hero.has-video .hero-eyebrow {
    margin-bottom: clamp(1.5rem, 6svh, 3rem);
  }
  .hero-count {
    display: none;
  }
  :global(html.counting) .hero-count {
    display: inline;
  }
  .hero-logo {
    grid-column: 1 / span 7;
  }
  .hero-logo :global(.hero-logo-svg) {
    display: block;
    width: 100%;
    height: auto;
    color: var(--wdm-lavender);
    filter: drop-shadow(0 6px 30px rgb(19 6 26 / 0.45));
  }
  /* One-time intro: the wordmark rises into view from the bottom up. */
  :global(html.intro) .hero-logo :global(.hero-logo-svg) {
    animation: logo-load 1.1s cubic-bezier(0.33, 1, 0.68, 1) both;
  }
  @keyframes logo-load {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .hero-copy {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .hero-title {
    margin: 0;
    font-size: clamp(2.4rem, 10.5vw, 3.5rem);
  }
  .hero-lede {
    margin: 0;
    max-width: 34ch;
    color: var(--hero-soft);
  }
  .hero-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.25rem;
    padding: 0.85rem 1.35rem;
    border-radius: 999px;
    background: var(--wdm-lavender);
    color: var(--ink);
    font-size: 1rem;
    font-weight: 560;
    letter-spacing: -0.005em;
    transition:
      background-color 0.3s,
      transform 0.4s var(--ease-out);
  }
  .hero-cta:hover {
    background: var(--wdm-pink);
  }
  .hero-cta span[aria-hidden] {
    display: inline-block;
    transition: transform 0.4s var(--ease-out);
  }
  .hero-cta:hover span[aria-hidden] {
    transform: translateY(0.2rem);
  }
  .hero-foot {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgb(253 252 248 / 0.22);
  }
  .hero-strap {
    margin: 0;
  }
  .hero-player {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .hero-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--hero-soft);
  }
  /* Tiny level meter: moves only while the loop plays. */
  .hero-eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 0.75rem;
  }
  .hero-eq i {
    width: 2px;
    height: 35%;
    background: var(--wdm-lavender);
  }
  .hero-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid rgb(253 252 248 / 0.4);
    border-radius: 999px;
    background: rgb(19 6 26 / 0.35);
    color: var(--paper);
    cursor: pointer;
    transition: border-color 0.3s;
  }
  .hero-toggle[hidden] {
    display: none;
  }
  .hero-toggle:hover {
    border-color: var(--paper);
  }
  .hero-toggle-icon {
    width: 0.6rem;
    height: 0.7rem;
    border-inline: 2px solid currentColor;
  }
  .hero-toggle[data-state='paused'] .hero-toggle-icon {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0.35rem 0 0.35rem 0.6rem;
    border-color: transparent transparent transparent currentColor;
  }

  @media (min-width: 900px) {
    .hero.has-video .hero-eyebrow {
      margin-bottom: clamp(6rem, 22svh, 16rem);
    }
    .hero-grid {
      row-gap: 2rem;
    }
    .hero-logo {
      grid-column: 1 / span 5;
    }
    .hero-copy {
      grid-column: 7 / -1;
      padding-bottom: 0.25rem;
    }
    .hero-title {
      font-size: clamp(2.75rem, 4.6vw, 5.25rem);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero.is-playing .hero-eq i {
      animation: eq 0.9s ease-in-out infinite alternate;
    }
    .hero.is-playing .hero-eq i:nth-child(2) {
      animation-duration: 0.6s;
    }
    .hero.is-playing .hero-eq i:nth-child(3) {
      animation-duration: 0.75s;
    }
    @keyframes eq {
      to {
        height: 100%;
      }
    }
  }

  /* As the hero leaves: the wordmark lifts away, the footage pushes in and darkens. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-logo {
        animation: hero-out linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
        transform-origin: 0 100%;
      }
      @keyframes hero-out {
        to {
          transform: translateY(-12%) scale(0.92);
          opacity: 0.2;
        }
      }
      .hero-media {
        animation: hero-push linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      @keyframes hero-push {
        to {
          transform: scale(1.08);
          filter: brightness(0.45);
        }
      }
    }
  }

  /* ---------- Ticker: a staircase that drifts into line ---------- */
  .tick-sec {
    padding-block: clamp(2rem, 6vw, 6rem) clamp(4rem, 9vw, 8rem);
    overflow-x: clip;
  }
  .ticker {
    margin: 0;
    font-size: clamp(3.25rem, 10.5vw, 11rem);
    line-height: 0.86;
  }
  .tw {
    display: block;
    width: max-content;
    max-width: 100%;
  }
  .tw-in {
    display: inline-block;
  }
  .tw-no {
    display: inline-block;
    vertical-align: top;
    margin-right: 0.5rem;
    margin-top: 0.35em;
    font-size: 0.75rem;
    letter-spacing: 0;
    color: var(--muted);
  }
  .tw-2 { margin-left: 12%; }
  .tw-3 { margin-left: 30%; }
  .tw-4 { margin-left: 8%; }
  @media (min-width: 768px) {
    .tw-2 { margin-left: 25%; }
    .tw-3 { margin-left: 50%; }
    .tw-4 { margin-left: 33.333%; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .tw {
        animation: tw-drift linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 55%;
      }
      .tw-1 { --from: -14vw; }
      .tw-2 { --from: 18vw; }
      .tw-3 { --from: -22vw; }
      .tw-4 { --from: 12vw; }
      @keyframes tw-drift {
        from {
          translate: var(--from, 0) 0;
        }
        to {
          translate: 0 0;
        }
      }
    }
  }

  /* ---------- Sections ---------- */
  .sec {
    padding-block: clamp(3rem, 7vw, 6rem);
    scroll-margin-top: 4rem;
  }
  .sec-foot {
    margin: 1.25rem 0 0;
    max-width: 52ch;
  }

  /* About */
  .sec-about {
    padding-top: 0;
  }
  .chap {
    position: relative;
    row-gap: 1rem;
    align-items: start;
    margin-top: clamp(3.5rem, 8vw, 7rem);
    padding-top: 1rem;
  }
  .chap-rule {
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--rule);
  }
  .chap-no {
    grid-column: 1 / -1;
    margin: 0;
  }
  .chap-title {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
  }
  .chap-body {
    grid-column: 1 / -1;
    max-width: 68ch;
  }
  .chap-body p {
    margin: 0 0 1.1em;
    font-size: clamp(1.125rem, 1.45vw, 1.375rem);
    line-height: 1.5;
    letter-spacing: -0.006em;
  }
  .pull {
    margin: clamp(5rem, 11vw, 10rem) 0 clamp(1rem, 3vw, 2rem);
    row-gap: 1.25rem;
  }
  .pull-q {
    grid-column: 1 / -1;
    margin: 0;
  }
  .pull-q p {
    margin: 0;
    font-size: clamp(2rem, 4.6vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-indent: -0.4em;
  }
  .pull-cap {
    grid-column: 1 / -1;
  }
  /* The quote gets a highlighter stroke in the brand gradient, drawn in as it arrives. */
  .pull-fill {
    background-image: linear-gradient(90deg, var(--wdm-lavender), var(--wdm-pink));
    background-repeat: no-repeat;
    background-position: 0 92%;
    background-size: 100% 0.44em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-inline: 0.06em;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .pull-fill {
      background-size: 0% 0.44em;
      transition: background-size 1.6s var(--ease-out) 0.15s;
    }
    :global(html.js) .is-in .pull-fill {
      background-size: 100% 0.44em;
    }
  }

  /* Contact */
  .enquire {
    row-gap: 3rem;
  }
  .aside {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .aside-title {
    margin: 0;
  }
  .aside-intro {
    margin: 0;
    max-width: 36ch;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
  }
  .aside-mail {
    display: grid;
    gap: 0.4rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .aside-mail p {
    margin: 0;
  }
  .mail {
    justify-self: start;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .mail:hover {
    text-decoration-thickness: 2px;
  }
  .form-col {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .chap-no {
      grid-column: 1 / span 1;
      margin-top: 0.4rem;
    }
    .chap-title {
      grid-column: 2 / span 4;
      margin: 0;
    }
    .chap-body {
      grid-column: 6 / -1;
      margin-top: 0.35rem;
    }
    .pull-q,
    .pull-cap {
      grid-column: 2 / span 10;
    }
  }
  @media (min-width: 900px) {
    .aside {
      grid-column: 1 / span 4;
      position: sticky;
      top: 6rem;
    }
    .form-col {
      grid-column: 6 / -1;
      padding-top: 0.75rem;
    }
  }
</style>

<script>
  // Hero loop: starts after the page has loaded (so it never competes with the
  // poster image), pauses off-screen, never autoplays under reduced motion,
  // and has a visible pause/play control (WCAG 2.2.2).
  const hero = document.getElementById('top');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (hero && video && toggle) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const label = toggle.querySelector('.hero-toggle-text');
    let wanted = !reduce.matches; // user intent: play unless they paused (or prefer reduced motion)
    let visible = true;

    const render = () => {
      const playing = !video.paused;
      toggle.dataset.state = playing ? 'playing' : 'paused';
      if (label) label.textContent = (playing ? toggle.dataset.pause : toggle.dataset.play) ?? '';
      hero.classList.toggle('is-playing', playing);
    };
    const sync = () => {
      if (wanted && visible) {
        video.preload = 'auto';
        video.play().catch(() => {});
      } else video.pause();
    };
    video.addEventListener('playing', render);
    video.addEventListener('pause', render);
    toggle.addEventListener('click', () => {
      wanted = video.paused;
      sync();
    });
    new IntersectionObserver(([e]) => {
      visible = !!e?.isIntersecting;
      sync();
    }).observe(hero);

    toggle.hidden = false;
    render();
    const begin = () => ('requestIdleCallback' in window ? requestIdleCallback(sync, { timeout: 1500 }) : setTimeout(sync, 300));
    if (document.readyState === 'complete') begin();
    else addEventListener('load', begin, { once: true });
  }

  // Once-per-session load counter (the inline head script decides; this only counts).
  const root = document.documentElement;
  const out = document.querySelector<HTMLElement>('[data-count]');
  if (root.classList.contains('intro') && out) {
    root.classList.add('counting');
    const start = performance.now();
    const DURATION = 1100;
    const step = (now: number) => {
      const t = Math.min((now - start) / DURATION, 1);
      const eased = 1 - Math.pow(1 - t, 3);
      out.textContent = `${String(Math.round(eased * 100)).padStart(2, '0')}%`;
      if (t < 1) requestAnimationFrame(step);
      else setTimeout(() => root.classList.remove('counting', 'intro'), 450);
    };
    requestAnimationFrame(step);
  }
</script>
