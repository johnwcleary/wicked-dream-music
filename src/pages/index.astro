---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Lines from '../components/Lines.astro';
import WordField from '../components/WordField.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceAccordion from '../components/ServiceAccordion.astro';
import WorkAccordion from '../components/WorkAccordion.astro';
import { getPage, getServices, getSite, getWork, pad, paragraphs, splitHeadline, toSection } from '../lib/content';

const site = await getSite();
const page = await getPage('home');
const about = await getPage('about');
const servicesPage = await getPage('services');
const workPage = await getPage('work');
const contact = await getPage('contact');
const services = await getServices();
const work = await getWork();
// The headline, on two lines. Its last word is in italics, and the lines start from it.
const [headOne = '', headTwo = ''] = splitHeadline(page.headline);
const headLast = headTwo.split(' ').pop() ?? '';
const headRest = headTwo.slice(0, -headLast.length).trim();
const expand = page.hero_expand;
// The closing line: two lines, with the headline's word and its own last word in italics.
const closing = expand ? splitHeadline(expand.resolve) : [];
const stressed = [headLast, expand?.resolve.trim().split(/\s+/).pop()];
const outroWords = expand?.outro?.trim().split(/\s+/) ?? [];
const outroLast = outroWords.pop();
const video = page.hero_video;
const film = page.hero_film;

const people = about.sections ?? [];
---

<BaseLayout title={page.title} intro>
  <!-- 00 — Hero: all the type is a window onto the footage, which holds still behind
       a dark sheet as the page scrolls. Thin lines draw from the headline's last word
       to each word in the list, and on to the closing line. Without JS or with reduced
       motion the type sits still and stacked, over the poster. -->
  <section id="top" class={`hero${video ? ' has-video' : ''}`} aria-labelledby="hero-title" data-hero>
    {
      video && (
        <div class="hero-media" aria-hidden="true">
          <div class="hero-frame" data-hero-frame>
            <Image
              src={video.poster}
              alt=""
              widths={[640, 960, 1280, 1920].filter((w) => w <= video.poster.width)}
              width={Math.min(1920, video.poster.width)}
              sizes="100vw"
              loading="eager"
              fetchpriority="high"
              quality={62}
              class="hero-poster"
            />
            <video class="hero-video" muted loop playsinline preload="none" disablepictureinpicture data-hero-video>
              {video.mobile_webm && <source src={video.mobile_webm} type="video/webm" media="(max-width: 767px)" />}
              {video.mobile_mp4 && <source src={video.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
              {video.webm && <source src={video.webm} type="video/webm" />}
              <source src={video.mp4} type="video/mp4" />
            </video>
          </div>
        </div>
      )
    }
    <div class="hero-sheet">
      <span class="hero-lift" aria-hidden="true"></span>
      <div class="hero-cut">
        <div class="hero-stage">
          <h1 id="hero-title" class="run display">
            <span class="run-line">{headOne}</span>
            <span class="run-line">{headRest} <em data-run-last>{headLast}</em></span>
          </h1>
        </div>
        {
          expand && (
            <div class="bloom">
              <ul class="bloom-list display">
                {expand.words.map((word) => (
                  <li data-bloom-word>
                    <em>{word}</em>
                  </li>
                ))}
              </ul>
              <p class="bloom-end display" data-bloom-end>
                {closing.map((line) => (
                  <span class="bloom-end-line">
                    {line.split(' ').map((w) => (
                      <>
                        {stressed.includes(w) ? <em>{w}</em> : w}{' '}
                      </>
                    ))}
                  </span>
                ))}
              </p>
            </div>
          )
        }
      </div>
    </div>
    {expand && <svg class="links" aria-hidden="true" focusable="false" data-links />}
    {
      outroLast && (
        <div class="reel" data-reel>
          <div class="reel-top">
            <span class="reel-wash" data-reel-wash />
            <span class="reel-edge" data-reel-edge />
            <div class="reel-title" data-reel-title>
              <p class="reel-text display" data-reel-text>
                {outroWords.join(' ')} <em>{outroLast}</em>
              </p>
            </div>
          </div>
          <div class="reel-one" data-reel-one />
          {film && (
            <div class="reel-film" data-reel-film data-title={film.title} aria-hidden="true">
              <div class="reel-stage">
                <Image
                  src={film.poster}
                  alt=""
                  widths={[640, 960, 1280, 1920].filter((w) => w <= film.poster.width)}
                  width={Math.min(1920, film.poster.width)}
                  sizes="100vw"
                  loading="lazy"
                  decoding="async"
                  quality={62}
                  class="film-poster"
                />
                <video class="film-video" muted loop playsinline preload="none" disablepictureinpicture data-film-video>
                  {film.mobile_webm && <source src={film.mobile_webm} type="video/webm" media="(max-width: 767px)" />}
                  {film.mobile_mp4 && <source src={film.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
                  {film.webm && <source src={film.webm} type="video/webm" />}
                  <source src={film.mp4} type="video/mp4" />
                </video>
              </div>
            </div>
          )}
        </div>
      )
    }
    <div class="hero-bar">
        <div class="wrap hero-foot">
          <p class="hero-strap label label-muted">{page.strapline}</p>
          {
            page.cta && (
              <a class="hero-cta label" href={toSection(page.cta.href)}>
                {page.cta.label} <span aria-hidden="true">↓</span>
              </a>
            )
          }
          {
            video && (
              <button
                type="button"
                class="hero-credit label"
                data-hero-toggle
                data-play={site.ui.play_video}
                data-pause={site.ui.pause_video}
                aria-label={`${site.ui.pause_video}: ${video.title}`}
              >
                {video.title}
              </button>
            )
          }
        </div>
    </div>
  </section>

  <!-- 01 — Services -->
  <section id="services" class="sec wrap" aria-labelledby="services-title">
    <SectionHead id="services-title" title={servicesPage.headline} count={services.length} kicker={servicesPage.lede} number={1} />
    <ServiceAccordion items={services} />
  </section>

  <!-- Artists. Ideas. Sound. Culture. — with the four plates set into the line -->
  <WordField words={site.ticker} items={work} />

  <!-- 02 — About -->
  <section id="about" class="band band-ink" aria-labelledby="about-label">
    <div class="wrap">
      <p id="about-label" class="band-label label" data-reveal>
        <span aria-hidden="true">{pad(2)} —</span> {about.title}
      </p>
      {
        people.map((person) => (
          <article class="bio">
            <Lines as="h2" class="bio-name display d-lg" lines={splitHeadline(person.heading)} />
            <div class="bio-body display" data-reveal>
              {paragraphs(person.body).map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 03 — Selected work -->
  <section id="work" class="sec wrap" aria-labelledby="work-title">
    <SectionHead id="work-title" title={workPage.headline} count={work.length} kicker={workPage.lede} number={3} />
    <WorkAccordion items={work} />
    {workPage.footnote && <p class="sec-foot label label-muted">{workPage.footnote}</p>}
  </section>

  <!-- 04 — Contact: one big email call to action -->
  <section id="contact" class="band band-cta" aria-labelledby="contact-title">
    <div class="wrap grid12 cta">
      <p class="band-label label cta-label" data-reveal>
        <span aria-hidden="true">{pad(4)} —</span> {contact.intro_heading}
      </p>
      <Lines as="h2" id="contact-title" class="cta-title display d-lg" lines={splitHeadline(contact.headline)} />
      <p class="cta-lede body-lg" data-reveal style="--i: 2">{contact.lede} {contact.intro}</p>
      <a class="cta-mail display" href={`mailto:${site.email}`} data-reveal style="--i: 3">
        <span class="cta-mail-text">{site.email.split('@')[0]}@<wbr />{site.email.split('@')[1]}</span>
        <span class="cta-mail-arrow" aria-hidden="true">↗</span>
      </a>
      <p class="cta-loc label" data-reveal style="--i: 4">{site.location}</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: the type is a window onto the footage ---------- */
  .hero {
    --hero-soft: color-mix(in srgb, var(--paper) 86%, transparent);
    --hero-muted: color-mix(in srgb, var(--paper) 70%, transparent);
    position: relative;
    isolation: isolate;
    margin-top: calc(var(--header-h) * -1);
    scroll-margin-top: 0;
    overflow: clip;
  }
  .hero :global(.label-muted) {
    color: var(--hero-muted);
  }

  /* Media stack: optimised poster (the LCP image) and the loop over it once it
     plays. The grade is baked into the footage and poster, so nothing is filtered
     per frame. */
  .hero-media {
    position: sticky;
    top: 0;
    height: 100svh;
    margin-bottom: -100svh;
    overflow: clip;
  }
  .hero-frame {
    position: absolute;
    inset: 0;
  }
  .hero-frame :global(.hero-poster),
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-video {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .hero.is-playing .hero-video {
    opacity: 1;
  }
  /* The sheet scrolls over the footage with its own lift underneath: inside the
     letters the darkest frame still gives 3.4:1 against the ink, and the footage
     below the sheet's edge is untouched. */
  .hero-sheet {
    position: relative;
  }
  .hero-lift {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--paper) 42%, transparent);
  }

  /* The sheet: ink everywhere, white type. "Darken" keeps the lower of sheet and
     footage, so the sheet stays exactly ink and the footage shows only in the type.
     The stroke adds weight, so the letters are wide enough to see through. */
  .hero-cut {
    position: relative;
    background: var(--ink);
    color: #fff;
    mix-blend-mode: darken;
  }
  .run,
  .bloom-list,
  .bloom-end {
    -webkit-text-stroke: 0.016em #fff;
  }
  .hero-stage {
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding: calc(var(--header-h) + 1rem) var(--gutter) 4rem;
  }
  .run {
    margin: 0;
    font-size: 19.5vw;
  }
  .run-line {
    display: block;
  }
  .run em,
  .bloom em {
    font-style: italic;
  }
  .bloom {
    padding: 0 var(--gutter) clamp(2rem, 5vw, 4rem);
  }
  .links {
    display: none;
  }
  .bloom-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.3em;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 1.05;
  }
  .bloom-end {
    margin: 1.5rem 0 0;
    font-size: clamp(3.25rem, 11vw, 12rem);
    line-height: 0.95;
  }
  .bloom-end-line {
    display: block;
  }
  @media (min-width: 768px) {
    .run {
      font-size: min(34svh, 14.8vw);
    }
  }

  /* Past the sheet: one line over the footage at full screen, then the second film.
     The 50% ink keeps the line AA over white footage (3.4:1). */
  .reel {
    position: relative;
  }
  .reel-top {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: grid;
    place-items: center;
    height: 100svh;
    overflow: clip;
    color: var(--paper);
    text-align: center;
    pointer-events: none;
  }
  .reel-wash,
  .reel-edge {
    position: absolute;
    inset: 0;
  }
  .reel-wash {
    background: color-mix(in srgb, var(--ink) 50%, transparent);
  }
  /* Once the line has shrunk: enough shade behind it and the footer row to stay AA. */
  .reel-edge {
    opacity: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--ink) 55%, transparent) 0,
      color-mix(in srgb, var(--ink) 55%, transparent) 8.5rem,
      transparent 17rem,
      transparent calc(100% - 11rem),
      color-mix(in srgb, var(--ink) 80%, transparent) calc(100% - 3rem)
    );
  }
  .reel-title {
    position: relative;
  }
  .reel-text {
    margin: 0;
    font-size: min(36svh, 30vw);
    white-space: nowrap;
  }
  .reel-text em {
    font-style: italic;
  }
  .reel-one {
    height: 100svh;
  }
  .reel-film {
    position: relative;
    z-index: 1;
    background: var(--ink);
  }
  .reel-stage {
    position: relative;
    height: 100svh;
    overflow: clip;
  }
  .reel-stage :global(.film-poster),
  .film-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-video {
    opacity: 0;
    transition: opacity 0.8s var(--ease-out);
  }
  .reel-film.is-playing .film-video {
    opacity: 1;
  }

  .hero-bar {
    position: relative;
    z-index: 4;
    background: var(--ink);
    border-top: 1px solid color-mix(in srgb, var(--paper) 22%, transparent);
    transition:
      background-color 0.4s,
      border-color 0.4s;
  }
  /* Over the films the row drops its ground and the services list, leaving the frame clear. */
  .hero.in-reel .hero-bar {
    background: transparent;
    border-top-color: transparent;
  }
  .hero.in-reel .hero-strap {
    visibility: hidden;
  }
  .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 2rem;
    padding-block: 0.75rem;
  }
  .hero-strap {
    margin: 0 auto 0 0;
  }
  .hero-cta {
    display: inline-flex;
    gap: 0.5rem;
    padding: 0.35rem 0;
    color: var(--paper);
  }
  .hero-cta:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  /* The credit doubles as a quiet pause/play control for the loop. */
  .hero-credit {
    padding: 0.35rem 0;
    border: 0;
    background: none;
    color: var(--hero-soft);
    cursor: pointer;
  }
  .hero-credit:hover {
    color: var(--paper);
  }

  /* The sequence. The footage stays pinned for the whole hero while the sheet
     scrolls over it: words pop as the lines (drawn by the script below) reach them. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero-frame {
      will-change: transform;
    }
    :global(html.js) .reel-top {
      position: sticky;
      top: 0;
      margin-bottom: -100svh;
    }
    :global(html.js) .reel-title {
      will-change: transform;
    }
    :global(html.js) .reel-text {
      opacity: 0;
      transform: translateY(0.2em) scale(0.92);
      transition:
        opacity 0.6s var(--ease-out),
        transform 1s var(--ease-out);
    }
    :global(html.js) .reel.is-in .reel-text {
      opacity: 1;
      transform: none;
    }
    :global(html.js) .reel-one {
      height: 200svh;
    }
    :global(html.js) .reel-film {
      height: 190svh;
    }
    :global(html.js) .reel-stage {
      position: sticky;
      top: 0;
    }
    /* Stays on screen for the whole hero: it holds the video's pause control. */
    :global(html.js) .hero-bar {
      position: sticky;
      bottom: 0;
    }
    :global(html.js) .run-line {
      animation: run-in 1.2s var(--ease-out) both;
    }
    :global(html.js) .run-line + .run-line {
      animation-delay: 0.12s;
    }
    @keyframes run-in {
      from {
        opacity: 0;
        transform: translateY(0.18em);
      }
    }

    :global(html.js) .bloom {
      padding: 0 var(--gutter);
    }
    :global(html.js) .links {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;
      overflow: visible;
      pointer-events: none;
      color: color-mix(in srgb, var(--paper) 72%, transparent);
    }
    :global(html.js) .bloom-list {
      display: grid;
      grid-auto-rows: 52svh;
      gap: 0;
      font-size: min(30svh, 20vw);
      line-height: 1;
      white-space: nowrap;
    }
    :global(html.js) .bloom-list li {
      align-self: center;
      justify-self: start;
    }
    /* Alternating sides, so the lines fan out across the whole frame. */
    :global(html.js) .bloom-list li:nth-child(even) {
      justify-self: end;
    }
    :global(html.js) .bloom-list em {
      display: inline-block;
      padding-inline: 0.05em;
      opacity: 0;
      transform: translateY(0.3em) scale(0.8);
      transition:
        opacity 0.4s var(--ease-out),
        transform 0.8s cubic-bezier(0.2, 1.45, 0.35, 1);
    }
    :global(html.js) .bloom-list li.is-in em {
      opacity: 1;
      transform: none;
    }
    :global(html.js) .bloom-end {
      display: grid;
      place-content: center;
      min-height: 100svh;
      margin: 0;
      font-size: min(32svh, 18.5vw);
      text-align: center;
    }
    :global(html.js) .bloom-end-line {
      opacity: 0;
      transform: translateY(0.25em) scale(0.9);
      transition:
        opacity 0.5s var(--ease-out),
        transform 0.9s cubic-bezier(0.2, 1.35, 0.35, 1);
    }
    :global(html.js) .bloom-end-line:nth-child(2) {
      transition-delay: 0.12s;
    }
    :global(html.js) .bloom-end.is-in .bloom-end-line {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Sections ---------- */
  .sec {
    padding-block: clamp(3rem, 7vw, 6rem);
    scroll-margin-top: 4rem;
  }
  .sec-foot {
    margin: 1.25rem 0 0;
    max-width: 52ch;
  }

  /* The contact band runs straight into the footer. */
  :global(.site-footer) {
    margin-top: 0;
  }

  /* ---------- Full-width sections, split by a hairline ---------- */
  .band {
    padding-block: clamp(4rem, 9vw, 8rem);
    scroll-margin-top: 4rem;
    border-top: 1px solid var(--rule);
  }
  .band-label {
    margin: 0 0 clamp(2.5rem, 6vw, 5rem);
  }

  /* About — each person large: name left, bio right. */
  .band-ink .band-label {
    color: var(--accent);
  }
  .bio {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .bio > * {
    grid-column: 1 / -1;
  }
  .bio + .bio {
    margin-top: clamp(4rem, 9vw, 8rem);
  }
  .bio :global(.bio-name) {
    margin: 0;
  }
  .bio-body p {
    margin: 0;
    font-size: clamp(1.75rem, 3.1vw, 3.25rem);
    line-height: 1.14;
    letter-spacing: -0.01em;
  }

  /* Contact — one giant email link, in silver. */
  .band-cta {
    --soft: color-mix(in srgb, var(--paper) 78%, transparent);
  }
  .cta {
    row-gap: 1.5rem;
  }
  .cta-label,
  .cta-loc {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--soft);
  }
  .cta :global(.cta-title) {
    grid-column: 1 / -1;
    margin: 0;
  }
  .cta-lede {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
    max-width: 44ch;
    color: var(--soft);
  }
  .cta-mail {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    margin-top: clamp(1.5rem, 4vw, 3rem);
    flex-wrap: wrap;
    max-width: 100%;
    color: var(--accent);
    font-size: clamp(2rem, 8.4vw, 8.5rem);
    line-height: 1.05;
  }
  .cta-mail-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 0.06em;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.06em;
    transition: background-size 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-text {
    background-size: 100% 0.12em;
  }
  .cta-mail-arrow {
    font-size: 0.6em;
    transition: transform 0.5s var(--ease-out);
  }
  .cta-mail:hover .cta-mail-arrow {
    transform: translate(0.12em, -0.12em);
  }
  .cta-loc {
    margin-top: 0.5rem;
  }

  @media (min-width: 900px) {
    .bio > :global(.bio-name) {
      grid-column: 1 / span 4;
    }
    .bio > .bio-body {
      grid-column: 5 / -1;
    }
    .cta-lede {
      grid-column: 1 / span 6;
    }
    .cta-mail {
      font-size: clamp(3rem, 6.4vw, 8rem);
    }
  }
</style>

<script>
  // The two loops: they start after the page has loaded (so they never compete with
  // the poster image), pause off-screen and never autoplay under reduced motion. The
  // title in the footer row names the film on screen and doubles as the pause/play
  // control for both (WCAG 2.2.2).
  const hero = document.getElementById('top');
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-hero-toggle]');
  if (hero && video && toggle) {
    const filmHost = document.querySelector<HTMLElement>('[data-reel-film]');
    const filmVideo = document.querySelector<HTMLVideoElement>('[data-film-video]');
    const firstTitle = toggle.textContent?.trim() ?? '';
    const clips = [{ video, host: hero, seen: true }];
    if (filmHost && filmVideo) clips.push({ video: filmVideo, host: filmHost, seen: false });

    let wanted = !matchMedia('(prefers-reduced-motion: reduce)').matches; // play unless paused or reduced motion
    let started = false;
    let title = firstTitle;

    const render = () => {
      toggle.textContent = title;
      toggle.setAttribute('aria-label', `${(wanted ? toggle.dataset.pause : toggle.dataset.play) ?? ''}: ${title}`);
    };
    const sync = () => {
      if (!started) return;
      for (const clip of clips) {
        if (wanted && clip.seen) {
          clip.video.preload = 'auto';
          clip.video.play().catch(() => {});
        } else clip.video.pause();
      }
    };
    for (const clip of clips) clip.video.addEventListener('playing', () => clip.host.classList.add('is-playing'));
    toggle.addEventListener('click', () => {
      wanted = !wanted;
      render();
      sync();
    });

    // The first loop is in view until the second film has fully covered it.
    const cover = [document.querySelector('.hero-sheet'), document.querySelector('[data-reel-one]')].filter((el): el is Element => !!el);
    const inView = new Set<Element>();
    const firstWatch = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) inView.add(e.target);
        else inView.delete(e.target);
      }
      clips[0]!.seen = inView.size > 0;
      sync();
    });
    cover.forEach((el) => firstWatch.observe(el));
    if (filmHost && clips[1]) {
      new IntersectionObserver(
        ([e]) => {
          clips[1]!.seen = !!e?.isIntersecting;
          sync();
        },
        { rootMargin: '200px 0px' },
      ).observe(filmHost);
      new IntersectionObserver(
        ([e]) => {
          title = e?.isIntersecting ? (filmHost.dataset.title ?? firstTitle) : firstTitle;
          render();
        },
        { rootMargin: '-50% 0px -50% 0px' },
      ).observe(filmHost);
    }

    render();
    const begin = () => {
      started = true;
      sync();
    };
    const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(begin, { timeout: 1500 }) : setTimeout(begin, 300));
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }

  // Hero sequence. As the page scrolls, lines draw from the headline's last word to
  // each word in the list, and from those to the closing line. A line's tip follows a
  // mark 72% of the way down the screen, and each word pops as the mark reaches it.
  // Past the sheet, the reel's line shrinks away so the films can be watched.
  const last = document.querySelector<HTMLElement>('[data-run-last]');
  const frame = document.querySelector<HTMLElement>('[data-hero-frame]');
  const end = document.querySelector<HTMLElement>('[data-bloom-end]');
  const svg = document.querySelector<SVGSVGElement>('[data-links]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-bloom-word]'));
  const reel = document.querySelector<HTMLElement>('[data-reel]');
  const reelTitle = document.querySelector<HTMLElement>('[data-reel-title]');
  const reelText = document.querySelector<HTMLElement>('[data-reel-text]');
  const reelWash = document.querySelector<HTMLElement>('[data-reel-wash]');
  const reelEdge = document.querySelector<HTMLElement>('[data-reel-edge]');
  if (hero && last && end && svg && rows.length && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const seg = (v: number, from: number, to: number) => Math.min(1, Math.max(0, (v - from) / (to - from)));
    const NS = 'http://www.w3.org/2000/svg';
    const MARK = 0.72;

    type Link = { el: SVGPathElement; from: number; to: number; shown: number };
    type Node = { el: SVGCircleElement; at: number };
    let links: Link[] = [];
    let nodes: Node[] = [];
    let tops: number[] = [];
    let endTop = 0;
    let heroTop = 0;
    let reelTop = 0;
    let reelEnd = 0;
    let titleLift = 0;
    let titleScale = 1;

    const addNode = (x: number, y: number, at: number) => {
      const el = document.createElementNS(NS, 'circle');
      el.setAttribute('cx', String(x));
      el.setAttribute('cy', String(y));
      el.setAttribute('r', '3');
      el.setAttribute('fill', 'currentColor');
      svg.append(el);
      nodes.push({ el, at });
    };
    const addLink = (x0: number, y0: number, x1: number, y1: number) => {
      const el = document.createElementNS(NS, 'path');
      const bend = (y1 - y0) * 0.55;
      el.setAttribute('d', `M${x0} ${y0}C${x0} ${y0 + bend} ${x1} ${y1 - bend} ${x1} ${y1}`);
      el.setAttribute('fill', 'none');
      el.setAttribute('stroke', 'currentColor');
      el.setAttribute('stroke-width', '1');
      el.setAttribute('pathLength', '1');
      el.setAttribute('stroke-dasharray', '1 1');
      el.setAttribute('stroke-dashoffset', '1');
      svg.append(el);
      links.push({ el, from: y0, to: y1, shown: -1 });
    };

    // Coordinates are the hero's own.
    const measure = () => {
      const b = hero.getBoundingClientRect();
      heroTop = b.top + scrollY;
      if (reel && reelText) {
        const r = reel.getBoundingClientRect();
        reelTop = r.top + scrollY;
        reelEnd = r.bottom + scrollY;
        // The line ends just under the header, small enough to watch the film beneath it.
        const header = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0;
        titleLift = innerHeight / 2 - (header + 36);
        titleScale = 32 / parseFloat(getComputedStyle(reelText).fontSize);
      }

      svg.replaceChildren();
      links = [];
      nodes = [];
      svg.setAttribute('width', String(b.width));
      svg.setAttribute('height', String(b.height));
      const w = last.getBoundingClientRect();
      const originX = w.left + w.width / 2 - b.left;
      const originY = w.top + w.height * 0.88 - b.top;
      const first = end.firstElementChild!;
      // The closing line's rest position: take its pop offset out of the reading.
      endTop = first.getBoundingClientRect().top - new DOMMatrix(getComputedStyle(first).transform).m42 - b.top;
      const endX = b.width / 2;
      tops = rows.map((row) => {
        const r = row.getBoundingClientRect();
        const x = r.left + r.width / 2 - b.left;
        const top = r.top - b.top;
        addLink(originX, originY, x, top + r.height * 0.06);
        addNode(x, top + r.height * 0.06, top);
        addLink(x, top + r.height * 1.02, endX, endTop - 6);
        return top;
      });
      addNode(originX, originY, originY);
      addNode(endX, endTop - 6, endTop);
    };

    const render = (y: number) => {
      // Over the first screen of the reel the line shrinks to the top and the shade clears.
      const clear = reel ? seg(y, reelTop, reelTop + innerHeight * 0.7) : 0;
      const ease = clear * clear * (3 - 2 * clear);
      if (frame) frame.style.transform = `scale(${1 + seg(y, heroTop, reelTop || heroTop + 1) * 0.16 * (1 - ease)})`;
      if (reelTitle) reelTitle.style.transform = `translate3d(0, ${-titleLift * ease}px, 0) scale(${1 + (titleScale - 1) * ease})`;
      if (reelWash) reelWash.style.opacity = String(1 - ease);
      if (reelEdge) reelEdge.style.opacity = String(ease);
      if (reel) {
        // The line arrives once the sheet has lifted about halfway off the footage.
        reel.classList.toggle('is-in', y + innerHeight * 0.45 >= reelTop);
        hero.classList.toggle('in-reel', y >= reelTop - innerHeight * 0.1 && y <= reelEnd - innerHeight * 1.02);
      }
      const mark = y + innerHeight * MARK - heroTop;
      for (const link of links) {
        const shown = Math.round(seg(mark, link.from, link.to) * 1000) / 1000;
        if (shown === link.shown) continue;
        link.shown = shown;
        link.el.setAttribute('stroke-dashoffset', String(1 - shown));
      }
      for (const node of nodes) node.el.style.opacity = mark >= node.at ? '1' : '0';
      rows.forEach((row, i) => row.classList.toggle('is-in', mark >= (tops[i] ?? 0)));
      end.classList.toggle('is-in', mark >= endTop);
    };

    let now = scrollY;
    let raf = 0;
    const tick = () => {
      now += (scrollY - now) * 0.16;
      if (Math.abs(scrollY - now) < 0.5) now = scrollY;
      render(now);
      raf = now === scrollY ? 0 : requestAnimationFrame(tick);
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };
    const refresh = () => {
      measure();
      render(now);
    };
    addEventListener('scroll', wake, { passive: true });
    addEventListener('resize', refresh);
    document.fonts?.ready.then(refresh);
    refresh();
  }
</script>
