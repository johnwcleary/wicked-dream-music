---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Logo from '../components/Logo.astro';
import Arrow from '../components/Arrow.astro';
import Ticker from '../components/Ticker.astro';
import ServiceCard from '../components/ServiceCard.astro';
import WorkStrip from '../components/WorkStrip.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPage, getServices, getSite, splitHeadline } from '../lib/content';
import heroPhoto from '../assets/photos/guitarist-haze.jpg';

const site = await getSite();
const page = await getPage('home');
const servicesPage = await getPage('services');
const services = await getServices();
const servicesNav = site.nav.find((n) => n.href === '/services');
const [line1, line2] = splitHeadline(page.headline);
---

<BaseLayout title={page.title} description={page.lede} overlayHeader>
  <section class="hero">
    <div class="hero-media" aria-hidden="true">
      <div class="hero-drift">
        <Picture
          src={heroPhoto}
          alt=""
          formats={['avif', 'webp']}
          width={2560}
          widths={[640, 960, 1280, 1600, 1920, 2560]}
          sizes="(orientation: portrait) 110vh, 100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img"
        />
      </div>
    </div>

    <div class="hero-inner wrap">
      <p class="eyebrow hero-eyebrow">{page.eyebrow}</p>

      <div class="hero-mark">
        <Logo label={site.name} class="hero-logo" />
      </div>

      <div class="hero-copy">
        <h1 class="hero-title dream-text">
          <span>{line1}</span>
          <span>{line2}</span>
        </h1>
        <p class="hero-lede">{page.lede}</p>
        {
          page.cta && (
            <a class="pill-link" href={page.cta.href}>
              {page.cta.label}
              <Arrow />
            </a>
          )
        }
      </div>

      <p class="hero-credits">{page.strapline}</p>
    </div>
  </section>

  <Ticker />

  <section class="services wrap" data-reveal>
    <div class="services-head">
      <p class="eyebrow">{servicesNav?.label}</p>
      <h2 class="services-title">{servicesPage.headline}</h2>
      <p class="services-lede">{servicesPage.lede}</p>
      {
        page.cta && (
          <a class="link-arrow" href={page.cta.href}>
            {page.cta.label}
            <Arrow />
          </a>
        )
      }
    </div>
    <div class="services-grid">
      {services.map((s) => <ServiceCard service={s} headingLevel="h3" href={`/services#${s.id}`} />)}
    </div>
  </section>

  <WorkStrip />

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    overflow: hidden;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--wdm-ink);
  }
  /* Photo is multiplied onto a deep violet field: its brightest haze can never
     exceed the field colour, so the gradient wordmark and paper text keep AA. */
  .hero-drift {
    position: absolute;
    inset: 0;
    isolation: isolate;
    background:
      radial-gradient(60% 55% at 78% 22%, #6b4a8c, transparent 70%),
      radial-gradient(50% 50% at 12% 80%, #4a2440, transparent 70%),
      #3e2453;
    animation: hero-drift 40s ease-in-out infinite alternate;
    transform-origin: 60% 40%;
  }
  .hero-drift :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 38% 35%;
    mix-blend-mode: multiply;
  }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(19 6 26 / 0.7) 0%, rgb(19 6 26 / 0) 26%, rgb(19 6 26 / 0) 50%, rgb(19 6 26 / 0.85) 86%, var(--wdm-ink) 100%),
      linear-gradient(90deg, rgb(19 6 26 / 0.35), transparent 50%);
  }
  @keyframes hero-drift {
    from {
      transform: scale(1.02);
    }
    to {
      transform: scale(1.1) translate3d(-1.5%, 1%, 0);
    }
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: end;
    gap: 2rem;
    padding-top: 6.5rem;
    padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .hero-eyebrow {
    color: var(--wdm-paper);
  }
  .hero-mark {
    width: min(100%, 30rem);
  }
  .hero-mark :global(.hero-logo) {
    width: 100%;
    filter: drop-shadow(0 0 40px rgb(212 178 253 / 0.18));
  }
  .hero-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .hero-title {
    font-size: clamp(1.95rem, 7.6vw, 4.6rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.045em;
    padding-bottom: 0.06em;
  }
  .hero-lede {
    font-size: clamp(1.0625rem, 1.45vw, 1.25rem);
    line-height: 1.55;
    max-width: 36ch;
    color: var(--wdm-paper);
  }
  .hero-credits {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--wdm-mist);
    padding-top: 1.25rem;
    border-top: 1px solid var(--wdm-line);
  }

  @media (min-width: 900px) {
    .hero-inner {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: auto 1fr auto;
      column-gap: clamp(1rem, 2vw, 2rem);
      row-gap: 2.5rem;
      padding-top: 8rem;
    }
    .hero-eyebrow {
      grid-column: 1 / -1;
      align-self: start;
    }
    .hero-mark {
      grid-column: 1 / span 7;
      grid-row: 2;
      align-self: end;
      width: min(100%, 46rem, calc((100svh - 19rem) * 1.44));
    }
    .hero-copy {
      grid-column: 8 / -1;
      grid-row: 2;
      align-self: end;
      padding-bottom: 0.5rem;
    }
    .hero-title {
      font-size: clamp(2.1rem, 3.4vw, 3.6rem);
    }
    .hero-credits {
      grid-column: 1 / -1;
    }
  }

  /* ---------- Services ---------- */
  .services {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-top: clamp(5rem, 11vw, 10rem);
  }
  .services-head {
    display: grid;
    gap: 1.25rem;
    align-content: start;
    justify-items: start;
  }
  .services-title {
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }
  .services-lede {
    color: var(--wdm-mist);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    max-width: 32ch;
    margin-bottom: 0.75rem;
  }
  .services-grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.75rem);
  }
  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .services-grid > :global(:nth-child(even)) {
      transform: translateY(clamp(2rem, 5vw, 5rem));
    }
    .services-grid {
      padding-bottom: clamp(2rem, 5vw, 5rem);
    }
  }
  @media (min-width: 1200px) {
    .services {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      column-gap: clamp(2rem, 4vw, 4rem);
    }
    .services-head {
      position: sticky;
      top: 3rem;
      align-self: start;
    }
    .services-title {
      font-size: clamp(3rem, 5vw, 5rem);
    }
  }
</style>
