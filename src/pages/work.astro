---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import NextLink from '../components/NextLink.astro';
import { anchor, getPage, getWork, pad } from '../lib/content';

const page = await getPage('work');
const work = await getWork();
---

<BaseLayout title={page.title} description={page.lede}>
  <PageHead title={page.title} headline={page.headline} lede={page.lede} />

  <div class="wrap">
    <ol class="cat">
      {
        work.map((w, i) => {
          const img = w.data.image;
          return (
            <li class={`entry grid12 entry-${(i % 4) + 1}`} id={anchor(w.id)}>
              <p class="entry-no label">
                [{pad(w.data.order)}]<span class="label-muted"> / {w.data.category}</span>
              </p>
              <h2 class="entry-title display d-md">{w.data.title}</h2>
              <p class="entry-sum body-lg">{w.data.summary}</p>
              {img && (
                <figure class="entry-fig">
                  <div class="entry-img">
                    <Image
                      src={img}
                      alt={w.data.image_alt ?? ''}
                      widths={[400, 640, 960, 1280, 1600]}
                      sizes="(min-width: 900px) 42vw, 100vw"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      fetchpriority={i === 0 ? 'high' : 'auto'}
                      decoding={i === 0 ? 'sync' : 'async'}
                      class="bw"
                    />
                  </div>
                  <figcaption class="label label-muted" aria-hidden="true">
                    {img.width}×{img.height}
                  </figcaption>
                </figure>
              )}
            </li>
          );
        })
      }
    </ol>
    {page.footnote && <p class="foot label label-muted">{page.footnote}</p>}
  </div>

  <NextLink />
</BaseLayout>

<style>
  .cat {
    list-style: none;
    margin: clamp(4rem, 9vw, 8rem) 0 0;
    padding: 0;
  }
  .entry {
    row-gap: 1rem;
    align-items: start;
    padding-block: 1.25rem clamp(3.5rem, 7vw, 6.5rem);
    border-top: 1px solid var(--rule-strong);
    scroll-margin-top: 1rem;
  }
  .entry-no {
    grid-column: 1 / -1;
    margin: 0;
  }
  .entry-title {
    grid-column: 1 / -1;
    margin: 0.75rem 0 0;
    max-width: 14ch;
  }
  .entry-sum {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 38ch;
  }
  .entry-fig {
    grid-column: 1 / -1;
    margin: 1rem 0 0;
  }
  .entry-img {
    overflow: hidden;
    background: var(--plate);
  }
  .entry-img :global(img) {
    width: 100%;
    height: auto;
  }
  .entry-fig figcaption {
    margin-top: 0.5rem;
    text-align: right;
  }
  /* Mobile crops vary so the column doesn't read as a stack of equal cards. */
  .entry-1 .entry-fig { grid-column: 1 / span 10; }
  .entry-2 .entry-fig { grid-column: 3 / -1; }
  .entry-3 .entry-fig { grid-column: 1 / span 9; }
  .entry-4 .entry-fig { grid-column: 1 / -1; }

  @media (min-width: 900px) {
    .entry {
      row-gap: 1.5rem;
      grid-template-rows: auto auto 1fr;
    }
    .entry-no {
      grid-column: 1 / span 6;
    }
    .entry-title {
      grid-column: 1 / span 6;
    }
    .entry-sum {
      grid-column: 1 / span 5;
      align-self: start;
    }
    .entry-fig {
      grid-row: 1 / span 3;
      margin: 0;
    }
    .entry-1 .entry-fig { grid-column: 8 / span 5; }
    .entry-2 .entry-fig { grid-column: 7 / -1; }
    .entry-3 .entry-fig { grid-column: 9 / span 4; }
    .entry-4 .entry-fig { grid-column: 7 / span 6; }

    /* Even entries mirror: plate left, text right. */
    .entry:nth-child(even) .entry-no,
    .entry:nth-child(even) .entry-title {
      grid-column: 7 / -1;
    }
    .entry:nth-child(even) .entry-sum {
      grid-column: 7 / span 5;
    }
    .entry-2 .entry-fig { grid-column: 1 / span 5; }
    .entry-4 .entry-fig { grid-column: 1 / span 5; }
  }

  .foot {
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
    max-width: 60ch;
  }
</style>
