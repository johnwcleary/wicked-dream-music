---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getPage, getSite } from '../lib/content';

const site = await getSite();
const page = await getPage('contact');
---

<BaseLayout title={page.title} description={page.lede}>
  <h1 class="text-4xl font-bold">{page.headline}</h1>
  <p>{page.lede}</p>
  <section class="py-8">
    <h2 class="text-2xl font-bold">{page.intro_heading}</h2>
    <p>{page.intro}</p>
    <div class="mt-4"><ContactForm /></div>
    <p class="mt-4">{page.email_label} <a class="underline" href={`mailto:${site.email}`}>{site.email}</a></p>
    <p class="mt-4 text-sm uppercase">{site.location}</p>
  </section>
</BaseLayout>
