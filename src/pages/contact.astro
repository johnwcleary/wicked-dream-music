---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import ContactForm from '../components/ContactForm.astro';
import { getPage, getSite } from '../lib/content';

const site = await getSite();
const page = await getPage('contact');
---

<BaseLayout title={page.title} description={page.lede}>
  <PageHead title={page.title} headline={page.headline} lede={page.lede} meta={site.location} />

  <section class="enquire wrap" aria-labelledby="enquire-title">
    <div class="grid12 enquire-grid">
      <div class="aside">
        <h2 id="enquire-title" class="display d-sm aside-title">{page.intro_heading}</h2>
        <p class="aside-intro">{page.intro}</p>
        <div class="aside-mail">
          <p class="label label-muted">{page.email_label}</p>
          <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
      <div class="form-col">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .enquire {
    margin-top: clamp(4rem, 9vw, 8rem);
  }
  .enquire-grid {
    row-gap: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-strong);
  }
  .aside {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .aside-title {
    margin: 0.5rem 0 0;
  }
  .aside-intro {
    margin: 0;
    max-width: 36ch;
    font-size: clamp(1.0625rem, 1.3vw, 1.25rem);
  }
  .aside-mail {
    display: grid;
    gap: 0.4rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule);
  }
  .aside-mail p {
    margin: 0;
  }
  .mail {
    justify-self: start;
    font-size: clamp(1.125rem, 1.6vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  .mail:hover {
    text-decoration-thickness: 2px;
  }
  .form-col {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .aside {
      grid-column: 1 / span 4;
      position: sticky;
      top: 2rem;
    }
    .form-col {
      grid-column: 6 / -1;
      padding-top: 0.75rem;
    }
  }
</style>
