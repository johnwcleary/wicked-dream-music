---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import NextLink from '../components/NextLink.astro';
import { getPage, getSite, getWork, pad, paragraphs } from '../lib/content';

const site = await getSite();
const page = await getPage('about');
const work = await getWork();
const sections = page.sections ?? [];

// The pale, hazy guitarist plate suits a text-forward page.
const plate = work.find((w) => w.id === 'creative-partnerships' && w.data.image) ?? work.find((w) => w.data.image);

// Pull quote: the credentials line from the first section, repeated as a closing statement.
const firstParas = sections[0] ? paragraphs(sections[0].body) : [];
const quote = firstParas[firstParas.length - 1];
---

<BaseLayout title={page.title} description={page.lede}>
  <PageHead title={page.title} headline={page.headline} lede={page.lede} meta={page.eyebrow} />

  {
    plate?.data.image && (
      <figure class="strip wrap">
        <div class="strip-img">
          <Image
            src={plate.data.image}
            alt={plate.data.image_alt ?? ''}
            widths={[480, 800, 1200, 1600, 2000]}
            width={2000}
            quality={60}
            sizes="100vw"
            loading="lazy"
            decoding="async"
            class="bw"
          />
        </div>
        <figcaption class="strip-cap label">
          <span>[{pad(plate.data.order)}]</span>
          <span class="strip-title">{plate.data.title}</span>
          <span class="label-muted" aria-hidden="true">{plate.data.category}</span>
        </figcaption>
      </figure>
    )
  }

  <div class="wrap">
    {
      sections.map((s, i) => (
        <>
          <section class="chap grid12" aria-labelledby={`chap-${i + 1}`}>
            <p class="chap-no label" aria-hidden="true">
              {pad(i + 1)}
            </p>
            <h2 id={`chap-${i + 1}`} class="chap-title display d-sm">
              {s.heading}
            </h2>
            <div class="chap-body">
              {paragraphs(s.body).map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </section>
          {i === sections.length - 1 && quote && (
            <figure class="pull grid12" aria-hidden="true">
              <blockquote class="pull-q display">
                <p>“{quote}”</p>
              </blockquote>
              <figcaption class="pull-cap label label-muted">— {site.name}</figcaption>
            </figure>
          )}
        </>
      ))
    }
  </div>

  <NextLink />
</BaseLayout>

<style>
  .strip {
    margin-top: clamp(4rem, 9vw, 8rem);
  }
  .strip-img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--plate);
  }
  .strip-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .strip-cap {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.6rem;
  }
  .strip-title {
    flex: 1;
  }

  .chap {
    row-gap: 1rem;
    align-items: start;
    margin-top: clamp(4rem, 9vw, 8rem);
    padding-top: 1rem;
    border-top: 1px solid var(--rule-strong);
  }
  .chap-no {
    grid-column: 1 / -1;
    margin: 0;
  }
  .chap-title {
    grid-column: 1 / -1;
    margin: 0.5rem 0 0;
    max-width: 12ch;
  }
  .chap-body {
    grid-column: 1 / -1;
    max-width: 68ch;
  }
  .chap-body p {
    margin: 0 0 1.1em;
    font-size: clamp(1.125rem, 1.45vw, 1.375rem);
    line-height: 1.5;
    letter-spacing: -0.006em;
  }
  .chap-body p:first-child {
    text-indent: 0;
  }

  .pull {
    margin: clamp(5rem, 11vw, 10rem) 0 clamp(1rem, 3vw, 2rem);
    row-gap: 1.25rem;
  }
  .pull-q {
    grid-column: 1 / -1;
    margin: 0;
  }
  .pull-q p {
    margin: 0;
    font-size: clamp(2rem, 4.6vw, 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    text-indent: -0.4em;
  }
  .pull-cap {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .strip-img {
      aspect-ratio: 21 / 9;
    }
    .chap-no {
      grid-column: 1 / span 1;
      margin-top: 0.4rem;
    }
    .chap-title {
      grid-column: 2 / span 4;
      margin: 0;
    }
    .chap-body {
      grid-column: 6 / -1;
      margin-top: 0.35rem;
    }
    .pull-q {
      grid-column: 2 / span 10;
    }
    .pull-cap {
      grid-column: 2 / span 10;
    }
  }
</style>
