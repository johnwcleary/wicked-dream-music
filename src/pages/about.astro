---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, paragraphs } from '../lib/content';

const page = await getPage('about');
---

<BaseLayout title={page.title} description={page.lede}>
  <h1 class="text-4xl font-bold">{page.headline}</h1>
  <p>{page.lede}</p>
  <p class="text-sm uppercase">{page.eyebrow}</p>
  {
    page.sections?.map((s) => (
      <section class="py-4">
        <h2 class="text-2xl font-bold">{s.heading}</h2>
        {paragraphs(s.body).map((p) => <p class="mt-2">{p}</p>)}
      </section>
    ))
  }
</BaseLayout>
