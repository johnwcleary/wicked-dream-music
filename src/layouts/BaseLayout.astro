---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../lib/content';
import ogSource from '../assets/brand/logo-gradient.png';
import displayFont from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  /** Home only: the page opens on full-screen video, under a transparent header. */
  intro?: boolean;
}
const site = await getSite();
const { title, description = site.description, intro = false } = Astro.props;
const fullTitle = title === 'Home' ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const og = await getImage({ src: ogSource, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site ?? Astro.url).href;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f4eee3" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline define:vars={{ intro }}>
      var h = document.documentElement;
      h.classList.add('js');
      if (intro) h.classList.add('on-hero', 'on-intro', 'intro-foot');
      // Color audition: ?color=black or ?color=purple, kept for the visit. Links sent with blue get black. Remove once one is chosen.
      var color = new URLSearchParams(location.search).get('color');
      if (color !== 'black' && color !== 'blue' && color !== 'purple') {
        try {
          color = sessionStorage.getItem('wdm-color');
        } catch (e) {}
      }
      h.dataset.palette = color === 'purple' ? 'purple' : 'black';
      if (h.dataset.palette === 'purple') document.querySelector('meta[name="theme-color"]').content = '#0d0616';
    </script>
  </head>
  <body>
    <a href="#main" class="skip">{site.ui.skip_link}</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Color audition only. Remove once one is chosen. -->
    <div class="palette-pick" role="group" aria-label="Color audition" data-palette-pick hidden>
      <button type="button" data-palette-option="black">black</button>
      <button type="button" data-palette-option="purple">purple</button>
    </div>
    <script>
      // Color audition: switch palette in place and keep it in the address for sharing.
      const pick = document.querySelector<HTMLElement>('[data-palette-pick]');
      if (pick) {
        const root = document.documentElement;
        const options = pick.querySelectorAll<HTMLButtonElement>('[data-palette-option]');
        const show = () => options.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.paletteOption === root.dataset.palette)));
        options.forEach((b) =>
          b.addEventListener('click', () => {
            const color = b.dataset.paletteOption ?? 'black';
            root.dataset.palette = color;
            document.querySelector('meta[name="theme-color"]')?.setAttribute('content', color === 'purple' ? '#0d0616' : '#f4eee3');
            try {
              sessionStorage.setItem('wdm-color', color);
            } catch {}
            const url = new URL(location.href);
            url.searchParams.set('color', color);
            history.replaceState(null, '', url);
            show();
          }),
        );
        pick.hidden = false;
        show();
      }
      // Scroll reveals: mark [data-reveal] elements as they enter the viewport.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: 0.75rem;
    z-index: 100;
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.8125rem;
    transform: translateY(-200%);
  }
  .palette-pick {
    position: fixed;
    left: var(--gutter);
    bottom: 0.75rem;
    z-index: 60;
    display: flex;
    gap: 2px;
    padding: 2px;
    border-radius: 999px;
    background: #111;
    font-size: 0.8125rem;
  }
  .palette-pick[hidden] {
    display: none;
  }
  .palette-pick button {
    min-height: 1.75rem;
    padding: 0.2rem 0.7rem;
    border: 0;
    border-radius: 999px;
    background: none;
    color: #fff;
    cursor: pointer;
  }
  .palette-pick button[aria-pressed='true'] {
    background: #fff;
    color: #111;
  }
  .palette-pick button:focus-visible {
    outline-color: #fff;
  }
  .skip:focus,
  .skip:focus-visible {
    transform: none;
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
</style>
