---
import { getPage } from '../lib/content';

const page = await getPage('contact');
const fields = page.form_fields ?? [];
---

<!--
  Phase 2: wire this form to a Cloudflare Pages Function or a Netlify form.
  It intentionally has no action yet; method and field names are final.
-->
<form method="POST" class="grid gap-4">
  {
    fields.map((f) => (
      <div class="grid gap-1">
        <label for={`field-${f.name}`}>{f.label}</label>
        {f.type === 'textarea' ? (
          <textarea id={`field-${f.name}`} name={f.name} rows="5" required={f.required} class="border p-2" />
        ) : f.type === 'select' ? (
          <select id={`field-${f.name}`} name={f.name} required={f.required} class="border p-2">
            {(f.options ?? []).map((o) => <option value={o}>{o}</option>)}
          </select>
        ) : (
          <input
            id={`field-${f.name}`}
            name={f.name}
            type={f.type}
            required={f.required}
            autocomplete={f.type === 'email' ? 'email' : f.name === 'name' ? 'name' : f.name === 'company' ? 'organization' : undefined}
            class="border p-2"
          />
        )}
      </div>
    ))
  }
  <button type="submit" class="justify-self-start border px-4 py-2">{page.submit_label}</button>
</form>
