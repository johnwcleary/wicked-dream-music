---
import { getSite } from '../lib/content';

const site = await getSite();
// Enough repeats to overfill a wide screen; the second half mirrors the first for a seamless loop.
const reps = 3;
---

<div class="marquee">
  <div class="marquee-track">
    {
      [0, 1].map((half) => (
        <div class="marquee-group" aria-hidden={half === 1 ? 'true' : undefined}>
          {Array.from({ length: reps }).map((_, r) =>
            site.ticker.map((word) => (
              <>
                <span class="marquee-item" aria-hidden={half === 1 || r > 0 ? 'true' : undefined}>
                  {word}
                </span>
                <span class="marquee-sep" aria-hidden="true" />
              </>
            )),
          )}
        </div>
      ))
    }
  </div>
</div>
