---
/**
 * "Artists. Ideas. Sound. Culture." set as one huge line of type, with the
 * four work plates running inline between the words. Each plate opens its
 * entry in the Work section; hovering washes it in the brand gradient.
 */
import { Image } from 'astro:assets';
import { anchor, type Work } from '../lib/content';

interface Props {
  words: string[];
  items: Work[];
}
const { words, items } = Astro.props;
const plates = items.filter((w) => w.data.image);

// Crop per plate, in order: portrait, wide, square, cinematic.
const crops = [
  { ratio: 4 / 5, focus: '50% 22%', drift: '6%' },
  { ratio: 3 / 2, focus: '50% 50%', drift: '9%' },
  { ratio: 1, focus: '45% 45%', drift: '5%' },
  { ratio: 16 / 10, focus: '50% 50%', drift: '8%' },
];
---

<div class="wf wrap">
  <p class="wf-line display">
    {
      words.map((word, i) => {
        const w = plates[i];
        const crop = crops[i % crops.length]!;
        const img = w?.data.image;
        const fit = img ? [240, 360, 480, 720, 960].filter((n) => n <= img.width) : [];
        return (
          <>
            <span class="wf-pair">
            <span class="wf-word" data-reveal style={`--i: ${i * 2}`}>
              {word}
            </span>{' '}
            {w && img && (
              <a class="wf-plate" href={`#work-${anchor(w.id)}`} style={`--ratio: ${crop.ratio}`} data-reveal="wipe">
                <span class="wf-frame" style={`--i: ${i * 2 + 1}`}>
                  <Image
                    src={img}
                    alt=""
                    widths={fit.length ? fit : [img.width]}
                    width={Math.max(...(fit.length ? fit : [img.width]))}
                    quality={60}
                    sizes="(min-width: 768px) 26vw, 46vw"
                    loading="lazy"
                    decoding="async"
                    class="bw parallax"
                    style={`--drift: ${crop.drift}; object-position: ${crop.focus}`}
                  />
                </span>
                <span class="sr-only">{w.data.title}</span>
              </a>
            )}
            </span>{' '}
          </>
        );
      })
    }
  </p>
</div>

<style>
  .wf {
    padding-block: clamp(3.5rem, 8vw, 7rem);
    container-type: inline-size;
  }
  .wf-line {
    margin: 0;
    font-size: clamp(3rem, 13cqi, 10rem);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  @media (min-width: 768px) {
    .wf-line {
      /* Sized to the column so two pairs fit per line at any desktop width
         (measured for Archivo at 70% width; re-measure if the face changes). */
      font-size: 8.6cqi;
    }
  }
  /* A word and its plate travel together: they never break across lines. */
  .wf-pair {
    display: inline-block;
    white-space: nowrap;
    margin-right: 0.12em;
  }
  .wf-word {
    display: inline-block;
  }
  /* Plates sit in the line like words: taller than the type, centred on it. */
  .wf-plate {
    display: inline-block;
    height: 1.8em;
    aspect-ratio: var(--ratio);
    margin: 0.07em 0.14em 0.07em 0.04em;
    vertical-align: middle;
    transform: translateY(-0.06em);
  }
  .wf-frame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--plate);
  }
  .wf-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .wf-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-gradient);
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .wf-plate:hover .wf-frame::after,
  .wf-plate:focus-visible .wf-frame::after {
    opacity: 1;
  }
</style>
