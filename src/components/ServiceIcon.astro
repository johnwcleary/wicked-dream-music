---
/** A small line icon for a service, drawn to match the speaker. */
interface Props {
  name: keyof typeof icons;
}
const icons = {
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
  pencil: '<path d="M4 20l1-4L16 5l3 3L8 19z"/><path d="m14 7 3 3M13 20h7"/>',
  faders: '<path d="M6 4v8M6 16v4M12 4v2M12 10v10M18 4v10M18 18v2"/><circle cx="6" cy="14" r="2"/><circle cx="12" cy="8" r="2"/><circle cx="18" cy="16" r="2"/>',
  microphone: '<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3M9 21h6"/>',
  ticket: '<path d="M3 8a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2.5a1.5 1.5 0 0 0 0 3V16a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2.5a1.5 1.5 0 0 0 0-3z"/><path d="M15 6v2M15 11v2M15 16v2"/>',
  waveform: '<path d="M3 10v4M7.5 7v10M12 3.5v17M16.5 8v8M21 6v12"/>',
  disc: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.5"/><path d="M12 6.5A5.5 5.5 0 0 0 6.5 12"/>',
  people: '<circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.5 2.5-6 6-6s6 2.5 6 6M16 5a3.5 3.5 0 0 1 0 6.5M17.5 14.5c2.2.7 3.5 2.8 3.5 5.5"/>',
  listen: '<circle cx="10.5" cy="10.5" r="7"/><path d="m15.75 15.75 5 5M8 9.5v2M10.5 8v5M13 9.5v2"/>',
  setlist: '<path d="M3 6h12M3 11h12M3 16h6"/><path d="M14.5 19v-6.5l6-1.5V17"/><circle cx="12.75" cy="19" r="1.75"/><circle cx="18.75" cy="17" r="1.75"/>',
  network: '<circle cx="12" cy="5.5" r="2.5"/><circle cx="5.5" cy="18" r="2.5"/><circle cx="18.5" cy="18" r="2.5"/><path d="M10.8 7.7 6.7 15.8M13.2 7.7l4.1 8.1M8 18h8"/>',
};
const { name } = Astro.props;
---

<svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[name]} />

<style>
  .service-icon {
    display: block;
    width: 1.625rem;
    height: 1.625rem;
  }
</style>
