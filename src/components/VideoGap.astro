---
/**
 * A band across the page, showing footage held still behind it, so the page appears to scroll
 * over it. Tapping it pauses the loops, since the hero's control has scrolled away by here.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { getSite } from '../lib/content';

interface Props {
  video: { poster: ImageMetadata; mp4: string; mobile_mp4?: string };
}
const { video } = Astro.props;
const site = await getSite();
---

<div class="sliver" data-sliver>
  <div class="sliver-media" aria-hidden="true">
    <Image
      src={video.poster}
      alt=""
      widths={[640, 960, 1280, 1920].filter((w) => w <= video.poster.width)}
      width={Math.min(1920, video.poster.width)}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      quality={62}
      class="sliver-poster"
    />
    <video class="sliver-video" muted loop playsinline preload="none" disablepictureinpicture data-sliver-video>
      {video.mobile_mp4 && <source src={video.mobile_mp4} type="video/mp4" media="(max-width: 767px)" />}
      <source src={video.mp4} type="video/mp4" />
    </video>
  </div>
  <button type="button" class="sliver-toggle" data-hero-toggle data-play={site.ui.play_video} data-pause={site.ui.pause_video}>
    {site.ui.pause_video}
  </button>
</div>

<style>
  /* The clip keeps the fixed footage to this band, so the page appears to scroll over it. */
  .sliver {
    position: relative;
    height: clamp(3.75rem, 6.25vw, 6.25rem);
    clip-path: inset(0);
    background: var(--shade);
  }
  .sliver-media {
    position: fixed;
    inset: 0 0 auto;
    height: 100lvh;
  }
  .sliver-media :global(.sliver-poster),
  .sliver-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sliver-media :global(.sliver-poster) {
    z-index: 1;
    transition: opacity 0.8s var(--ease-out);
  }
  .sliver.is-playing :global(.sliver-poster) {
    opacity: 0;
  }
  /* The whole band is the control. Its label is for screen readers. */
  .sliver-toggle {
    position: absolute;
    inset: 0;
    width: 100%;
    border: 0;
    background: none;
    font-size: 0;
    cursor: pointer;
  }
  .sliver-toggle:focus-visible {
    outline-color: #fff;
    outline-offset: -3px;
  }
</style>
