---
/**
 * A contact-sheet field: every work image as a numbered archival plate,
 * each at its own size and crop. Plate numbers follow work `order`, so a
 * photo carries the same number everywhere on the site. Each plate opens
 * its entry in the Work section; hovering washes it in the brand gradient.
 */
import { Image } from 'astro:assets';
import { anchor, pad, type Work } from '../lib/content';

interface Props {
  items: Work[];
}
const { items } = Astro.props;
const withImages = items.filter((w) => w.data.image);

// Layout recipe per slot: crop ratio, responsive sizes, parallax drift.
const slots = [
  { ratio: '4 / 5', sizes: '(min-width: 768px) 32vw, 72vw', drift: '5%', focus: '50% 22%' },
  { ratio: '3 / 2', sizes: '(min-width: 768px) 50vw, 82vw', drift: '8%' },
  { ratio: '4 / 5', sizes: '(min-width: 768px) 26vw, 56vw', drift: '4%' },
  { ratio: '16 / 10', sizes: '(min-width: 768px) 38vw, 76vw', drift: '7%' },
];
---

<div class="field wrap">
  <ol class="field-grid grid12">
    {
      withImages.map((w, i) => {
        const slot = slots[i % slots.length]!;
        const img = w.data.image!;
        const fit = [320, 480, 640, 960, 1280].filter((n) => n <= img.width);
        const widths = fit.length ? fit : [img.width];
        return (
          <li class={`plate plate-${(i % slots.length) + 1}`}>
            <a class="plate-link" href={`#work-${anchor(w.id)}`}>
              <span class="plate-img" style={`aspect-ratio: ${slot.ratio}`} data-reveal="wipe">
                <Image
                  src={img}
                  alt=""
                  widths={widths}
                  width={Math.max(...widths)}
                  quality={60}
                  sizes={slot.sizes}
                  loading="lazy"
                  decoding="async"
                  class="bw parallax"
                  style={`--drift: ${slot.drift}; object-position: ${slot.focus ?? '50% 50%'}`}
                />
              </span>
              <span class="plate-cap label" data-reveal>
                <span class="plate-no" aria-hidden="true">[{pad(w.data.order)}]</span>
                <span class="plate-title">{w.data.title}</span>
                <span class="plate-arrow" aria-hidden="true">↓</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .field {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .field-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    row-gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  .plate-link {
    display: block;
  }
  .plate-img {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--plate);
  }
  .plate-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* The one hover moment: the plate washes into the brand gradient. */
  .plate-img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--wdm-gradient);
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .plate-link:hover .plate-img::after,
  .plate-link:focus-visible .plate-img::after {
    opacity: 1;
  }
  .plate-cap {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.6rem;
  }
  .plate-title {
    flex: 1;
  }
  .plate-link:hover .plate-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .plate-arrow {
    opacity: 0;
    transform: translateY(-0.3rem);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }
  .plate-link:hover .plate-arrow,
  .plate-link:focus-visible .plate-arrow {
    opacity: 1;
    transform: none;
  }

  /* Mobile: a staggered column — widths and sides alternate. */
  .plate-1 {
    grid-column: 1 / span 9;
  }
  .plate-2 {
    grid-column: 3 / -1;
  }
  .plate-3 {
    grid-column: 1 / span 7;
  }
  .plate-4 {
    grid-column: 4 / -1;
  }

  @media (min-width: 768px) {
    .field-grid {
      row-gap: 0;
    }
    .plate-1 {
      grid-column: 1 / span 4;
      grid-row: 1 / span 2;
    }
    .plate-2 {
      grid-column: 6 / -1;
      grid-row: 1;
      margin-top: clamp(4rem, 12vw, 12rem);
    }
    .plate-3 {
      grid-column: 2 / span 3;
      grid-row: 2 / span 2;
      margin-top: clamp(3rem, 7vw, 7rem);
    }
    .plate-4 {
      grid-column: 7 / span 5;
      grid-row: 3;
      margin-top: clamp(3rem, 6vw, 6rem);
    }
  }
</style>
