---
/**
 * A contact-sheet field: every work image as a numbered archival plate,
 * each at its own size and crop. Plate numbers follow work `order`, so a
 * photo carries the same number everywhere on the site.
 */
import { Image } from 'astro:assets';
import { pad, type Work } from '../lib/content';

interface Props {
  items: Work[];
}
const { items } = Astro.props;
const withImages = items.filter((w) => w.data.image);

// Layout recipe per slot: crop ratio + responsive sizes (CSS handles placement).
const slots = [
  { ratio: '4 / 5', sizes: '(min-width: 768px) 34vw, 72vw' },
  { ratio: '3 / 2', sizes: '(min-width: 768px) 50vw, 82vw' },
  { ratio: '1 / 1', sizes: '(min-width: 768px) 22vw, 56vw' },
  { ratio: '16 / 10', sizes: '(min-width: 768px) 38vw, 76vw' },
];
---

<div class="field wrap">
  <div class="field-grid grid12">
    {
      withImages.map((w, i) => {
        const slot = slots[i % slots.length]!;
        const img = w.data.image!;
        return (
          <figure class={`plate plate-${(i % slots.length) + 1}`}>
            <div class="plate-img" style={`aspect-ratio: ${slot.ratio}`}>
                <Image
                  src={img}
                  alt={w.data.image_alt ?? ''}
                  widths={[320, 480, 640, 960, 1280]}
                  sizes={slot.sizes}
                  loading="lazy"
                  decoding="async"
                  class="bw"
                />
            </div>
            <figcaption class="plate-cap label">
              <span class="plate-no">[{pad(w.data.order)}]</span>
              <span class="plate-title">{w.data.title}</span>
              <span class="plate-dim label-muted" aria-hidden="true">
                {img.width}×{img.height}
              </span>
            </figcaption>
          </figure>
        );
      })
    }
  </div>
</div>

<style>
  .field {
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .field-grid {
    row-gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }
  .plate {
    margin: 0;
  }
  .plate-img {
    overflow: hidden;
    background: var(--plate);
  }
  .plate-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .plate-cap {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.6rem;
  }
  .plate-title {
    flex: 1;
  }
  .plate-dim {
    white-space: nowrap;
  }

  /* Mobile: a staggered column — widths and sides alternate. */
  .plate-1 {
    grid-column: 1 / span 9;
  }
  .plate-2 {
    grid-column: 3 / -1;
  }
  .plate-3 {
    grid-column: 1 / span 7;
  }
  .plate-4 {
    grid-column: 4 / -1;
  }

  @media (min-width: 768px) {
    .field-grid {
      row-gap: 0;
    }
    .plate-1 {
      grid-column: 1 / span 4;
      grid-row: 1 / span 2;
    }
    .plate-2 {
      grid-column: 6 / -1;
      grid-row: 1;
      margin-top: clamp(4rem, 12vw, 12rem);
    }
    .plate-3 {
      grid-column: 3 / span 3;
      grid-row: 3;
      margin-top: clamp(3rem, 7vw, 7rem);
    }
    .plate-4 {
      grid-column: 7 / span 5;
      grid-row: 2 / span 2;
      margin-top: clamp(3rem, 6vw, 6rem);
    }
  }
</style>
