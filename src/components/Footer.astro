---
import { getSite, toSection } from '../lib/content';
import logoUrl from '../assets/brand/wdm-lockup-white.webp?url';

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="colophon">
      <span class="colo-logo" role="img" aria-label={site.name} style={`--logo-url: url(${logoUrl})`}></span>
      <p class="colo-loc label">
        {site.name}<br />
        <span class="label-muted">{site.location}</span>
      </p>
      <nav class="colo-nav" aria-label={site.ui.footer_nav_label}>
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a class="label" href={toSection(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="colo-rights label label-muted">© {year} {site.name}. {site.ui.rights}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(1.5rem, 2.5vw, 2.25rem);
  }
  .colophon {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    justify-items: start;
    gap: 0.75rem clamp(1rem, 2vw, 2rem);
    margin-left: var(--text-left);
    padding-block: 1rem 1.25rem;
  }
  /* On the left line, beside the text. The white logo as a mask, in the page's own text color. */
  .colo-logo {
    grid-row: 1 / span 3;
    display: block;
    width: clamp(5.5rem, 11vw, 10rem);
    aspect-ratio: 2000 / 1286;
    background: currentColor;
    -webkit-mask: var(--logo-url) center / contain no-repeat;
    mask: var(--logo-url) center / contain no-repeat;
  }
  .colo-loc,
  .colo-nav,
  .colo-rights {
    grid-column: 2;
    margin: 0;
  }
  .colo-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  .colo-nav a {
    display: inline-block;
    padding-block: 0.3rem;
  }
  .colo-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
