---
import Logo from './Logo.astro';
import { getPage, getSite, isCurrent, pad } from '../lib/content';

const site = await getSite();
const contact = await getPage('contact');
const year = new Date().getFullYear();
const onContact = isCurrent('/contact', Astro.url.pathname);
---

<footer class="site-footer">
  <div class="wrap">
    {
      !onContact && (
        <div class="sign grid12">
          <p class="sign-kicker label label-muted">{contact.intro_heading}</p>
          <a class="sign-mail display" href={`mailto:${site.email}`}>
            {site.email}
          </a>
        </div>
      )
    }
    <div class="colophon grid12">
      <a href="/" class="colo-logo" aria-label={site.name}>
        <Logo label={site.name} class="h-auto w-full" />
      </a>
      <p class="colo-loc label">
        {site.name}<br />
        <span class="label-muted">{site.location}</span>
      </p>
      <nav class="colo-nav" aria-label={site.ui.footer_nav_label}>
        <ul>
          {
            site.nav.map((item, i) => (
              <li>
                <a class="label" href={item.href}>
                  <span class="label-muted" aria-hidden="true">{pad(i + 1)}</span> {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="colo-rights label label-muted">© {year} {site.name}. {site.ui.rights}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(5rem, 12vw, 10rem);
  }
  .sign {
    row-gap: 1rem;
    padding-block: clamp(2rem, 4vw, 3rem) clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--rule-strong);
  }
  .sign-kicker {
    grid-column: 1 / -1;
  }
  .sign-mail {
    grid-column: 1 / -1;
    justify-self: start;
    font-size: clamp(1.75rem, 6.6vw, 7.5rem);
    line-height: 0.95;
    overflow-wrap: anywhere;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 2px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.08em;
    transition: background-size 0.5s var(--ease-out);
  }
  .sign-mail:hover {
    background-size: 100% 2px;
  }
  .colophon {
    row-gap: 1.75rem;
    align-items: start;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--rule);
  }
  .colo-logo {
    grid-column: 1 / span 4;
    width: 5.5rem;
    display: block;
  }
  .colo-loc {
    grid-column: 5 / -1;
  }
  .colo-nav {
    grid-column: 1 / span 6;
  }
  .colo-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .colo-nav a {
    display: inline-block;
    padding-block: 0.3rem;
  }
  .colo-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .colo-rights {
    grid-column: 7 / -1;
    align-self: end;
  }

  @media (min-width: 768px) {
    .colo-logo {
      grid-column: 1 / span 3;
      width: 7rem;
    }
    .colo-loc {
      grid-column: 4 / span 3;
    }
    .colo-nav {
      grid-column: 7 / span 3;
    }
    .colo-rights {
      grid-column: 10 / -1;
      text-align: right;
    }
  }
</style>
