---
import Logo from './Logo.astro';
import { getSite, toSection } from '../lib/content';

const site = await getSite();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="colophon grid12">
      <a href="/#top" class="colo-logo" aria-label={site.name}>
        <Logo label={site.name} class="h-auto w-full" />
      </a>
      <p class="colo-loc label">
        {site.name}<br />
        <span class="label-muted">{site.location}</span>
      </p>
      <nav class="colo-nav" aria-label={site.ui.footer_nav_label}>
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a class="label" href={toSection(item.href)}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="colo-rights label label-muted">© {year} {site.name}. {site.ui.rights}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(5rem, 12vw, 10rem);
  }
  .colophon {
    row-gap: 1.75rem;
    align-items: start;
    padding-block: 1.5rem 2rem;
  }
  .colo-logo {
    grid-column: 1 / span 4;
    width: 5.5rem;
    display: block;
  }
  .colo-loc {
    grid-column: 5 / -1;
  }
  .colo-nav {
    grid-column: 1 / span 6;
  }
  .colo-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .colo-nav a {
    display: inline-block;
    padding-block: 0.3rem;
  }
  .colo-nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .colo-rights {
    grid-column: 7 / -1;
    align-self: end;
  }

  @media (min-width: 768px) {
    .colo-logo {
      grid-column: 1 / span 3;
      width: 7rem;
    }
    .colo-loc {
      grid-column: 4 / span 3;
    }
    .colo-nav {
      grid-column: 7 / span 3;
    }
    .colo-rights {
      grid-column: 10 / -1;
      text-align: right;
    }
  }
</style>
