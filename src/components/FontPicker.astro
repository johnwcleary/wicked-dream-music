---
/** The font audition's control, for trying each option on the real pages. Temporary. */
import '../styles/font-audition.css';

const options = [
  { id: 'current', label: 'Inter Tight (current)' },
  { id: 'bodoni', label: 'Bodoni Moda' },
  { id: 'instrument', label: 'Instrument Serif' },
  { id: 'gloock', label: 'Gloock' },
  { id: 'cormorant', label: 'Cormorant Garamond' },
  { id: 'jost', label: 'Jost' },
  { id: 'archivo', label: 'Archivo Expanded' },
];
---

<label class="font-picker">
  <span>Font</span>
  <select data-font-picker>
    {options.map((option) => <option value={option.id}>{option.label}</option>)}
  </select>
</label>

<style>
  .font-picker {
    position: fixed;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid color-mix(in srgb, #fff 40%, transparent);
    border-radius: 999px;
    background: #0f0f10;
    color: #fff;
    font-family: 'Inter Tight Variable', sans-serif;
    font-size: 0.8125rem;
  }
  .font-picker select {
    max-width: 10.5rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }
  .font-picker option {
    color: #0f0f10;
  }
  /* Clear of the sound and pause controls along the foot of the screen. */
  @media (max-width: 767px) {
    .font-picker {
      bottom: 3.25rem;
    }
  }
</style>

<script>
  const select = document.querySelector<HTMLSelectElement>('[data-font-picker]');
  if (select) {
    const root = document.documentElement;
    select.value = root.dataset.font ?? 'current';
    if (select.selectedIndex < 0) select.value = 'current';
    select.addEventListener('change', () => {
      if (select.value === 'current') delete root.dataset.font;
      else root.dataset.font = select.value;
      try {
        localStorage.setItem('wdm-font', select.value);
      } catch {
        // The choice just won't be remembered.
      }
      // The hero measures its type, so it measures again in the new font.
      requestAnimationFrame(() => {
        void document.body.offsetHeight;
        document.fonts.ready.then(() => dispatchEvent(new Event('resize')));
      });
    });
  }
</script>
