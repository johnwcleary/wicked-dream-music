---
import Headline from './Headline.astro';
import { getSite, isCurrent, pad } from '../lib/content';

interface Props {
  headline: string;
  lede?: string;
  /** Small label top-right; defaults to site.location */
  aside?: string;
  /** Small label top-left; defaults to "0n / Nav label" for the current route */
  kicker?: string;
  tall?: boolean;
}
const site = await getSite();
const path = Astro.url.pathname;
const navIndex = site.nav.findIndex((n) => isCurrent(n.href, path));
const { headline, lede, aside = site.location, tall = false } = Astro.props;
const kicker = Astro.props.kicker ?? (navIndex >= 0 ? `${pad(navIndex + 1)} / ${site.nav[navIndex].label}` : '');
---

<section class:list={['hero band-ink wrap', { tall }]}>
  <div class="g12 hero-top">
    <p class="label hero-kicker">{kicker}</p>
    <p class="label muted hero-aside">{aside}</p>
  </div>
  <div class="hero-main">
    <Headline text={headline} class="mega hero-h" />
    <div class="g12 hero-foot">
      {lede && <p class="lede hero-lede">{lede}</p>}
      <div class="hero-extra"><slot /></div>
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(56px, 10vw, 120px);
    padding-top: calc(var(--nav-h) + 20px);
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .hero.tall {
    min-height: min(100svh, 980px);
  }
  .hero-top {
    row-gap: 6px;
  }
  .hero-kicker {
    grid-column: 1 / -1;
  }
  .hero-aside {
    grid-column: 1 / -1;
  }
  .hero-main :global(.hero-h) {
    margin-left: -0.03em;
  }
  .hero-foot {
    margin-top: clamp(28px, 4vw, 56px);
    row-gap: 28px;
    align-items: end;
  }
  .hero-lede {
    grid-column: 1 / -1;
  }
  .hero-extra {
    grid-column: 1 / -1;
  }
  .hero-extra:empty {
    display: none;
  }
  @media (min-width: 768px) {
    .hero-kicker {
      grid-column: 1 / span 6;
    }
    .hero-aside {
      grid-column: 7 / span 6;
      text-align: right;
    }
    .hero-lede {
      grid-column: 7 / span 5;
    }
    .hero-extra {
      grid-column: 1 / span 6;
      grid-row: 1;
    }
  }
</style>
