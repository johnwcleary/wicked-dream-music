---
import Logo from './Logo.astro';
import { getSite, isCurrent } from '../lib/content';

const site = await getSite();
const path = Astro.url.pathname;
---

<div class="flex flex-wrap items-center justify-between gap-4 p-4">
  <a href="/" class="block w-24" aria-label={site.name}>
    <Logo class="h-auto w-full" />
  </a>
  <nav aria-label={site.ui.nav_label}>
    <ul class="flex flex-wrap gap-4">
      {
        site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href, path) ? 'page' : undefined} class="underline">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
