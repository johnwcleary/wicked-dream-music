---
import { getSite, sectionId, toSection } from '../lib/content';

const site = await getSite();
---

<header class="site-header">
  <div class="bar wrap">
    <button type="button" class="menu-btn label" aria-expanded="false" aria-controls="site-menu" data-open={site.ui.menu_open} data-close={site.ui.menu_close}>
      <span class="menu-btn-text">{site.ui.menu_open}</span>
      <span class="menu-btn-icon" aria-hidden="true"></span>
    </button>
    <div id="site-menu" class="menu">
      <nav aria-label={site.ui.nav_label}>
        <ul class="menu-list">
          {
            site.nav.map((item) => (
              <li>
                <a href={toSection(item.href)} data-section={sectionId(item.href)}>
                  <span class="menu-text">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="menu-meta">
        <a class="label link-line" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="label label-muted">{site.location}</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  /* A soft scrim that fades out under the bar, everywhere on the page, so the logo and
     links stay legible as content passes beneath them. On a pseudo-element so it can
     run past the header's own height. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -2.5rem;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--paper) 92%, transparent) 0%,
      color-mix(in srgb, var(--paper) 78%, transparent) 45%,
      transparent 100%
    );
  }
  /* Over the full-screen films the header turns light, on a neutral scrim. */
  :global(html:is(.on-reel, .on-intro):not(.menu-open)) .site-header {
    color: var(--on-shade);
  }
  :global(html:is(.on-reel, .on-intro):not(.menu-open)) .site-header::before {
    inset: 0 0 -5rem;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--scrim) 70%, transparent) 0%,
      color-mix(in srgb, var(--scrim) 64%, transparent) 30%,
      color-mix(in srgb, var(--scrim) 38%, transparent) 50%,
      color-mix(in srgb, var(--scrim) 16%, transparent) 70%,
      color-mix(in srgb, var(--scrim) 5%, transparent) 85%,
      transparent 100%
    );
  }
  :global(html:is(.on-reel, .on-intro):not(.menu-open)) .site-header :focus-visible {
    outline-color: var(--on-shade);
  }
  .bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--col-gap);
    min-height: var(--header-h);
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
  }
  .menu-btn-icon {
    position: relative;
    width: 1.25rem;
    height: 0.5rem;
    border-block: 1.5px solid currentColor;
    transition: transform 0.3s var(--ease-out), height 0.3s var(--ease-out);
  }
  .menu-btn[aria-expanded='true'] .menu-btn-icon {
    height: 0;
    border-bottom-width: 0;
  }

  /* Desktop + no-JS: inline nav. */
  .menu-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-list a {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 450;
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .menu-list a:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }
  .menu-list a[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }
  :global(html:is(.on-reel, .on-intro):not(.menu-open)) .menu-list a:hover {
    background: color-mix(in srgb, var(--on-shade) 16%, transparent);
  }
  :global(html:is(.on-reel, .on-intro):not(.menu-open)) .menu-list a[aria-current] {
    background: var(--on-shade);
    color: var(--shade);
  }
  .menu-meta {
    display: none;
  }

  @media (max-width: 767px) {
    :global(html:not(.js)) .bar {
      flex-wrap: wrap;
      padding-bottom: 0.75rem;
    }
    :global(html:not(.js)) .menu {
      width: 100%;
    }
    :global(html.js) .menu-btn {
      display: inline-flex;
      position: relative;
      z-index: 2;
    }
    :global(html.js) .menu {
      display: none;
    }
    :global(html.js) .menu.is-open {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2rem;
      padding: 6rem var(--gutter) 1.75rem;
      background: var(--paper);
      color: var(--ink);
      overflow-y: auto;
      animation: menu-in 0.35s var(--ease-out);
    }
    .menu.is-open .menu-list {
      flex-direction: column;
      gap: 0;
    }
    .menu.is-open .menu-list a {
      display: flex;
      align-items: baseline;
      gap: 0.9rem;
      width: 100%;
      padding-block: 0.7rem 0.6rem;
      font-size: clamp(1.75rem, 8.5vw, 2.5rem);
      font-family: var(--font-display);
      font-weight: var(--display-weight);
      letter-spacing: var(--display-tracking);
      line-height: 1;
    }
    .menu.is-open .menu-list a,
    .menu.is-open .menu-list a[aria-current],
    .menu.is-open .menu-list a:hover {
      padding-inline: 0;
      background: none;
      color: inherit;
    }
    .menu.is-open .menu-list a[aria-current] .menu-text {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.12em;
    }
    .menu.is-open .menu-meta {
      display: grid;
      gap: 0.4rem;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('site-menu');
  if (btn && menu) {
    const label = btn.querySelector('.menu-btn-text');
    const links = () => Array.from(menu.querySelectorAll<HTMLElement>('a'));
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean, returnFocus = true) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      if (label) label.textContent = (open ? btn.dataset.close : btn.dataset.open) ?? '';
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.documentElement.classList.toggle('menu-open', open);
      if (open) links()[0]?.focus();
      else if (returnFocus) btn.focus();
    };

    btn.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab') return;
      // Keep focus inside the open menu (button + menu links).
      const items = [btn, ...links()];
      const first = items[0]!;
      const last = items[items.length - 1]!;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Picking a section closes the menu; the browser then scrolls to it.
    links().forEach((a) =>
      a.addEventListener('click', () => {
        if (isOpen()) setOpen(false, false);
      }),
    );

    // Close if the viewport grows past the mobile breakpoint.
    matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false, false);
    });
  }

  // Mark the nav item for the section in view (one-page site).
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('#site-menu a[data-section]'));
  const sections = navLinks
    .map((a) => document.getElementById(a.dataset.section ?? ''))
    .filter((el): el is HTMLElement => !!el);
  if (sections.length) {
    const setCurrent = (id: string) =>
      navLinks.forEach((a) => {
        if (a.dataset.section === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    const seen = new Map<string, boolean>();
    // The last section may be too short to reach the line, so the foot of the page marks it.
    const mark = () => {
      const atFoot = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
      const current = atFoot ? sections[sections.length - 1] : sections.find((el) => seen.get(el.id));
      if (current) setCurrent(current.id);
    };
    addEventListener('scroll', mark, { passive: true });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => seen.set(e.target.id, e.isIntersecting));
        mark();
      },
      // High on the screen, so a short section is marked once it has been scrolled to.
      { rootMargin: '-30% 0px -65% 0px' },
    );
    sections.forEach((el) => io.observe(el));
  }

  // Hairline under the sticky header once the page has scrolled; dark header
  // while the hero band is still underneath it.
  const hero = document.getElementById('top');
  const header = document.querySelector<HTMLElement>('.site-header');
  const opening = document.querySelector<HTMLElement>('[data-opening]');
  const onScroll = () => {
    const root = document.documentElement;
    root.classList.toggle('scrolled', scrollY > 8);
    if (hero && header) root.classList.toggle('on-hero', hero.getBoundingClientRect().bottom > header.offsetHeight);
    // Light over the full-screen opening at the top of the home page.
    if (opening && header) {
      const bottom = opening.getBoundingClientRect().bottom;
      root.classList.toggle('on-intro', bottom > header.offsetHeight);
      // The hero's footer row sits at the foot of the screen, so it changes as the footage leaves there.
      root.classList.toggle('intro-foot', bottom > innerHeight - 40);
    }
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
