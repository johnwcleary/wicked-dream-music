---
import { getSite, initials, pad, sectionId, toSection } from '../lib/content';

const site = await getSite();
const mark = initials(site.name);
---

<header class="site-header">
  <div class="bar wrap">
    <a href="/#top" class="mark">
      <span aria-hidden="true">{mark}<span class="mark-c">©</span></span>
      <span class="sr-only">{site.name}</span>
    </a>
    <p class="loc label">{site.location}</p>
    <button type="button" class="menu-btn label" aria-expanded="false" aria-controls="site-menu" data-open={site.ui.menu_open} data-close={site.ui.menu_close}>
      <span class="menu-btn-text">{site.ui.menu_open}</span>
      <span class="menu-btn-icon" aria-hidden="true"></span>
    </button>
    <div id="site-menu" class="menu">
      <nav aria-label={site.ui.nav_label}>
        <ul class="menu-list">
          {
            site.nav.map((item, i) => (
              <li>
                <a href={toSection(item.href)} data-section={sectionId(item.href)}>
                  <span class="menu-num label" aria-hidden="true">{pad(i + 1)}</span>
                  <span class="menu-text">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="menu-meta">
        <a class="label link-line" href={`mailto:${site.email}`}>{site.email}</a>
        <p class="label label-muted">{site.location}</p>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
  }
  /* Frosted ground on a pseudo-element: a backdrop-filter on the header itself
     would trap the fixed mobile menu inside it. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--paper) 97%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s;
  }
  :global(html.scrolled) .site-header::before {
    border-bottom-color: var(--rule);
  }
  /* Over the dark hero band the header goes dark too, so the top reads as one band. */
  .site-header,
  .site-header::before {
    transition:
      color 0.35s,
      background-color 0.35s,
      border-color 0.4s;
  }
  :global(html.on-hero:not(.menu-open)) .site-header {
    color: var(--paper);
  }
  /* Over the hero the header is transparent: the footage runs up to the top edge. */
  :global(html.on-hero:not(.menu-open)) .site-header::before {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: color-mix(in srgb, var(--paper) 16%, transparent);
  }
  :global(html.on-hero:not(.menu-open)) .loc {
    color: color-mix(in srgb, var(--paper) 62%, transparent);
  }
  :global(html.on-hero:not(.menu-open)) .site-header :focus-visible {
    outline-color: var(--paper);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--col-gap);
    min-height: var(--header-h);
  }
  .mark {
    font-size: 1.375rem;
    font-weight: 620;
    font-family: var(--font-display);
    font-stretch: var(--display-stretch);
    letter-spacing: -0.04em;
    line-height: 1;
    padding-block: 0.4rem;
    margin-right: auto;
  }
  .mark-c {
    font-size: 0.6em;
    vertical-align: 0.55em;
    margin-left: 0.04em;
    letter-spacing: 0;
  }
  .loc {
    display: none;
    color: var(--muted);
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0;
    background: none;
    border: 0;
    color: inherit;
    cursor: pointer;
  }
  .menu-btn-icon {
    position: relative;
    width: 1.25rem;
    height: 0.5rem;
    border-block: 1.5px solid currentColor;
    transition: transform 0.3s var(--ease-out), height 0.3s var(--ease-out);
  }
  .menu-btn[aria-expanded='true'] .menu-btn-icon {
    height: 0;
    border-bottom-width: 0;
  }

  /* Desktop + no-JS: inline nav. */
  .menu-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .menu-list a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.35rem;
    font-size: 0.9375rem;
    font-weight: 480;
    letter-spacing: -0.01em;
  }
  .menu-list a:hover .menu-text {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
  .menu-num {
    display: none;
  }
  .menu-list a::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    background: currentColor;
    transform: scale(0);
    transition: transform 0.35s var(--ease-out);
  }
  .menu-list a[aria-current]::before {
    transform: none;
  }
  .menu-meta {
    display: none;
  }

  @media (min-width: 1100px) {
    .loc {
      display: block;
      margin-right: auto;
    }
  }

  @media (max-width: 767px) {
    :global(html:not(.js)) .bar {
      flex-wrap: wrap;
      padding-bottom: 0.75rem;
    }
    :global(html:not(.js)) .menu {
      width: 100%;
    }
    :global(html.js) .menu-btn {
      display: inline-flex;
      position: relative;
      z-index: 2;
    }
    :global(html.js) .mark {
      position: relative;
      z-index: 2;
    }
    :global(html.js) .menu {
      display: none;
    }
    :global(html.js) .menu.is-open {
      position: fixed;
      inset: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2rem;
      padding: 5.5rem var(--gutter) 1.75rem;
      background: var(--paper);
      color: var(--ink);
      overflow-y: auto;
      animation: menu-in 0.35s var(--ease-out);
    }
    .menu.is-open .menu-list {
      flex-direction: column;
      gap: 0;
      border-bottom: 1px solid var(--rule);
    }
    .menu.is-open .menu-list li {
      border-top: 1px solid var(--rule);
    }
    .menu.is-open .menu-list a {
      display: flex;
      align-items: baseline;
      gap: 0.9rem;
      width: 100%;
      padding-block: 0.7rem 0.6rem;
      font-size: clamp(2.25rem, 11vw, 3.25rem);
      font-family: var(--font-display);
      font-weight: var(--display-weight);
      font-stretch: var(--display-stretch);
      letter-spacing: var(--display-tracking);
      line-height: 1;
    }
    .menu.is-open .menu-list a::before {
      display: none;
    }
    .menu.is-open .menu-num {
      display: inline;
      min-width: 1.75rem;
      color: var(--muted);
    }
    .menu.is-open .menu-list a[aria-current] .menu-num {
      color: var(--ink);
    }
    .menu.is-open .menu-list a[aria-current] .menu-text {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.12em;
    }
    .menu.is-open .menu-meta {
      display: grid;
      gap: 0.4rem;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.getElementById('site-menu');
  if (btn && menu) {
    const label = btn.querySelector('.menu-btn-text');
    const links = () => Array.from(menu.querySelectorAll<HTMLElement>('a'));
    const isOpen = () => btn.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean, returnFocus = true) => {
      btn.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
      if (label) label.textContent = (open ? btn.dataset.close : btn.dataset.open) ?? '';
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.documentElement.classList.toggle('menu-open', open);
      if (open) links()[0]?.focus();
      else if (returnFocus) btn.focus();
    };

    btn.addEventListener('click', () => setOpen(!isOpen()));

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab') return;
      // Keep focus inside the open menu (button + menu links).
      const items = [btn, ...links()];
      const first = items[0]!;
      const last = items[items.length - 1]!;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Picking a section closes the menu; the browser then scrolls to it.
    links().forEach((a) =>
      a.addEventListener('click', () => {
        if (isOpen()) setOpen(false, false);
      }),
    );

    // Close if the viewport grows past the mobile breakpoint.
    matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false, false);
    });
  }

  // Mark the nav item for the section in view (one-page site).
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('#site-menu a[data-section]'));
  const sections = navLinks
    .map((a) => document.getElementById(a.dataset.section ?? ''))
    .filter((el): el is HTMLElement => !!el);
  if (sections.length) {
    const setCurrent = (id: string) =>
      navLinks.forEach((a) => {
        if (a.dataset.section === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    const seen = new Map<string, boolean>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => seen.set(e.target.id, e.isIntersecting));
        const current = sections.find((el) => seen.get(el.id));
        if (current) setCurrent(current.id);
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((el) => io.observe(el));
  }

  // Hairline under the sticky header once the page has scrolled; dark header
  // while the hero band is still underneath it.
  const hero = document.getElementById('top');
  const header = document.querySelector<HTMLElement>('.site-header');
  const onScroll = () => {
    const root = document.documentElement;
    root.classList.toggle('scrolled', scrollY > 8);
    if (hero && header) root.classList.toggle('on-hero', hero.getBoundingClientRect().bottom > header.offsetHeight);
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
