---
/** Photo pushed hard into the brand: grayscale + contrast, multiplied over the gradient, blacks lifted to ink. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  eager?: boolean;
  class?: string;
  position?: string;
}
const { src, alt, sizes, widths = [480, 800, 1200, 1600, 2200], eager = false, class: className, position } = Astro.props;
---

<div class:list={['duo', className]}>
  <Image
    src={src}
    alt={alt}
    widths={widths.filter((w) => w <= src.width)}
    sizes={sizes}
    format="webp"
    quality={72}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? 'sync' : 'async'}
    style={position ? `object-position: ${position}` : undefined}
  />
</div>
