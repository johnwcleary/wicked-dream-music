---
import { Image } from 'astro:assets';
import type { Work } from '../lib/content';
import { pad } from '../lib/content';

interface Props {
  item: Work;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { item, headingLevel = 'h2', eager = false } = Astro.props;
const { order, category, title, summary, image, image_alt } = item.data;
const Heading = headingLevel;
---

<article class="border p-4">
  {
    image && (
      <Image
        src={image}
        alt={image_alt ?? ''}
        width={1200}
        widths={[400, 800, 1200]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        class="h-auto w-full"
      />
    )
  }
  <p class="text-sm uppercase">{pad(order)} / {category}</p>
  <Heading class="text-xl font-bold">{title}</Heading>
  <p>{summary}</p>
</article>
