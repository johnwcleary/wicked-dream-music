---
import Lines from './Lines.astro';
import { pad } from '../lib/content';

interface Props {
  title: string;
  id: string;
  /** Number of entries in the section, shown as an archival count. */
  count?: number;
  /** Optional kicker (e.g. an eyebrow or lede from content). */
  kicker?: string;
  /** Section number, shown before the kicker. */
  number?: number;
}
const { title, id, count, kicker, number } = Astro.props;
---

<div class="sh grid12">
  <span class="sh-rule" data-reveal="rule" aria-hidden="true"></span>
  {
    kicker && (
      <p class="sh-kicker label label-muted" data-reveal>
        {number !== undefined && <span class="sh-no" aria-hidden="true">{pad(number)} —</span>} {kicker}
      </p>
    )
  }
  <Lines as="h2" id={id} class="sh-title display d-md" lines={[title]} i={1}>
    {count !== undefined && <sup class="sh-count label" aria-hidden="true">({pad(count)})</sup>}
  </Lines>
</div>

<style>
  .sh {
    position: relative;
    row-gap: 1rem;
    padding-top: 1rem;
    margin-bottom: clamp(2rem, 5vw, 4.5rem);
  }
  .sh-rule {
    position: absolute;
    inset: 0 var(--col-gap) auto 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--rule-strong);
  }
  .sh-kicker {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 70ch;
  }
  .sh-no {
    color: var(--ink);
  }
  .sh-title {
    grid-column: 1 / -1;
    justify-self: start;
    position: relative;
    margin: 0;
    padding-right: 2.75rem;
  }
  .sh-count {
    position: absolute;
    top: 0.2em;
    right: 0;
    font-size: 0.8125rem;
    letter-spacing: 0;
  }
</style>
