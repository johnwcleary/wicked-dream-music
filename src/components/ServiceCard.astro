---
import type { Service } from '../lib/content';
import { pad } from '../lib/content';

interface Props {
  service: Service;
  headingLevel?: 'h2' | 'h3';
}
const { service, headingLevel = 'h2' } = Astro.props;
const { order, category, title, summary, bullets } = service.data;
const Heading = headingLevel;
---

<article class="border p-4">
  <p class="text-sm uppercase">{pad(order)} / {category}</p>
  <Heading class="text-xl font-bold">{title}</Heading>
  <p>{summary}</p>
  <ul class="list-disc pl-5">
    {bullets.map((b) => <li>{b}</li>)}
  </ul>
</article>
