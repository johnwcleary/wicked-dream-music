---
import Arrow from './Arrow.astro';
import { getPage, getSite, splitHeadline } from '../lib/content';

const site = await getSite();
const contact = await getPage('contact');
const contactNav = site.nav.find((n) => n.href === '/contact');
const [line1, line2] = splitHeadline(contact.headline);
---

<section class="cta wrap" data-reveal>
  <div class="cta-panel">
    <div class="cta-halo" aria-hidden="true"></div>
    <p class="eyebrow">{contact.intro_heading}</p>
    <h2 class="cta-title">
      <span>{line1}</span>
      <span>{line2}</span>
    </h2>
    <div class="cta-foot">
      <p class="cta-lede">{contact.lede}</p>
      {
        contactNav && (
          <a class="pill-link" href={contactNav.href}>
            {contactNav.label}
            <Arrow />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(2rem, 6vw, 5rem);
  }
  .cta-panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(2rem, 7vw, 6.5rem) clamp(1.5rem, 6vw, 6rem);
    border-radius: calc(var(--radius-lg) * 1.4);
    border: 1px solid var(--wdm-line);
    background: var(--wdm-ink-2);
  }
  .cta-halo {
    position: absolute;
    z-index: -1;
    inset: -40% -20% auto auto;
    width: 85%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(closest-side at 45% 45%, rgb(212 178 253 / 0.28), transparent 72%),
      radial-gradient(closest-side at 60% 75%, rgb(254 192 208 / 0.2), transparent 72%);
  }
  .cta-title {
    font-size: clamp(2.1rem, 6.6vw, 6rem);
    letter-spacing: -0.05em;
    line-height: 1;
    max-width: 16ch;
  }
  .cta-title span {
    display: block;
  }
  .cta-foot {
    display: grid;
    gap: 2rem;
    align-items: end;
  }
  .cta-lede {
    color: var(--wdm-mist);
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    max-width: 30ch;
  }
  .cta-foot .pill-link {
    justify-self: start;
  }
  @media (min-width: 900px) {
    .cta-foot {
      grid-template-columns: 1fr auto;
    }
  }
</style>
