---
/** The four services as a numbered index with hairline dividers. */
import { anchor, pad, type Service } from '../lib/content';

interface Props {
  items: Service[];
}
const { items } = Astro.props;
---

<ol class="si">
  {
    items.map((s) => (
      <li class="si-row">
        <a class="si-link grid12" href={`/services#${anchor(s.id)}`}>
          <span class="si-num label" aria-hidden="true">{pad(s.data.order)}</span>
          <h3 class="si-title display d-sm">{s.data.title}</h3>
          <p class="si-sum">{s.data.summary}</p>
          <span class="si-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .si {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }
  .si-row {
    border-top: 1px solid var(--rule);
  }
  .si-link {
    row-gap: 0.6rem;
    align-items: baseline;
    padding-block: 1.1rem 1.4rem;
  }
  .si-num {
    grid-column: 1 / span 2;
    color: var(--muted);
  }
  .si-title {
    grid-column: 3 / span 9;
    margin: 0;
    transition: transform 0.45s var(--ease-out);
  }
  .si-sum {
    grid-column: 3 / span 9;
    margin: 0;
    max-width: 34ch;
    color: var(--muted);
  }
  .si-arrow {
    grid-column: 12;
    grid-row: 1;
    justify-self: end;
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 0.45s var(--ease-out);
  }
  .si-link:hover .si-title {
    transform: translateX(0.35rem);
  }
  .si-link:hover .si-arrow {
    transform: translateX(0.35rem);
  }
  .si-link:hover .si-num {
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .si-link {
      padding-block: 1.5rem 1.75rem;
    }
    .si-num {
      grid-column: 1 / span 1;
    }
    .si-title {
      grid-column: 2 / span 6;
    }
    .si-sum {
      grid-column: 8 / span 4;
      grid-row: 1;
      max-width: 36ch;
    }
  }
</style>
