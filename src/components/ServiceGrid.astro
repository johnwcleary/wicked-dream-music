---
/**
 * The services, one under the other. Each title is a window onto a still from the
 * films, which drifts as the page scrolls, and opens (native <details>) to a compact
 * grid of its offerings.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { anchor, type Service } from '../lib/content';

interface Props {
  items: Service[];
  /** Stills for the titles, used in turn. */
  stills?: (ImageMetadata | undefined)[];
}
const { items, stills = [] } = Astro.props;
const pictures = await Promise.all(
  stills.map((src) => (src ? getImage({ src, width: Math.min(1400, src.width), format: 'webp', quality: 58 }) : undefined)),
);
---

<div class="svc-list">
  {
    items.map((s, i) => {
      const picture = pictures[i % Math.max(pictures.length, 1)];
      return (
        <details class="svc" id={`services-${anchor(s.id)}`}>
          <summary class="svc-head">
            <h3 class="svc-title display" style={picture ? `--still: url('${picture.src}')` : undefined} data-reveal>
              {s.data.title}
            </h3>
            <span class="svc-for display" data-reveal style="--i: 1">
              {s.data.category}
            </span>
            <span class="svc-icon" aria-hidden="true" />
          </summary>
          <ul class="svc-grid">
            {s.data.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </details>
      );
    })
  }
</div>

<style>
  .svc-list {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.75rem);
  }
  .svc {
    scroll-margin-top: 6rem;
  }
  .svc-head {
    position: relative;
    display: block;
    padding-right: 3rem;
    list-style: none;
    cursor: pointer;
  }
  .svc-head::-webkit-details-marker {
    display: none;
  }
  .svc-icon {
    position: absolute;
    top: 50%;
    right: 0;
    width: clamp(1.25rem, 2vw, 1.75rem);
    aspect-ratio: 1;
    translate: 0 -50%;
  }
  .svc-icon::before,
  .svc-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.5s var(--ease-out);
  }
  .svc-icon::after {
    transform: rotate(90deg);
  }
  .svc[open] .svc-icon::after {
    transform: rotate(0deg);
  }
  .svc-title {
    margin: 0;
    font-size: clamp(2.75rem, 5.8vw, 6.25rem);
    font-weight: 600;
    line-height: 0.92;
    /* Room for descenders: the still only paints inside this box. */
    padding-block: 0.08em 0.22em;
    margin-block: -0.08em -0.22em;
  }
  /* The still shows only through the letters, darkened so its brightest parts keep
     3.1:1 against the page. */
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .svc-title {
      color: transparent;
      background-image:
        linear-gradient(color-mix(in srgb, var(--ink) 45%, transparent), color-mix(in srgb, var(--ink) 45%, transparent)),
        var(--still, linear-gradient(var(--ink), var(--ink)));
      background-position: 50% 40%;
      background-size: 135% auto;
      -webkit-background-clip: text;
      background-clip: text;
    }
  }
  .svc-for {
    display: block;
    margin: 0.6em 0 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.15vw, 1.125rem);
    font-weight: 450;
    letter-spacing: -0.005em;
    line-height: 1.2;
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem clamp(1rem, 2vw, 2rem);
    margin: 0;
    padding: clamp(1rem, 2vw, 1.75rem) 0 0;
    list-style: none;
    font-size: clamp(0.9375rem, 1.05vw, 1.0625rem);
    line-height: 1.3;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .svc-title {
        animation: svc-drift linear both;
        animation-timeline: view();
      }
      .svc:nth-child(even) .svc-title {
        animation-direction: reverse;
      }
      @keyframes svc-drift {
        from {
          background-position: 15% 25%;
        }
        to {
          background-position: 85% 65%;
        }
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .svc {
      interpolate-size: allow-keywords;
    }
    .svc::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 0.6s var(--ease-out),
        content-visibility 0.6s allow-discrete;
    }
    .svc[open]::details-content {
      block-size: auto;
    }
  }

  @media (min-width: 900px) {
    .svc-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
