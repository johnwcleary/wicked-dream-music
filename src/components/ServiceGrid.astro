---
/**
 * The services, side by side on desktop: each one's title, who it's for, and
 * its offerings in a compact two-column grid.
 */
import { anchor, type Service } from '../lib/content';

interface Props {
  items: Service[];
}
const { items } = Astro.props;
---

<div class="svc-list">
  {
    items.map((s, i) => (
      <article class="svc" id={`services-${anchor(s.id)}`} data-reveal style={`--i: ${i}`}>
        <h3 class="svc-title display">{s.data.title}</h3>
        <p class="svc-for display">{s.data.category}</p>
        <ul class="svc-grid">
          {s.data.bullets.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      </article>
    ))
  }
</div>

<style>
  .svc-list {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 5vw, 5rem);
  }
  .svc {
    scroll-margin-top: 6rem;
  }
  .svc-title {
    margin: 0;
    font-size: clamp(2.25rem, 3.6vw, 3.75rem);
    line-height: 1;
  }
  .svc-for {
    margin: 0.2em 0 0;
    color: var(--accent);
    font-size: clamp(1.375rem, 1.9vw, 2rem);
    font-style: italic;
    line-height: 1.1;
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem clamp(1rem, 2vw, 2rem);
    margin: clamp(1rem, 2vw, 1.75rem) 0 0;
    padding: 0;
    list-style: none;
    font-size: clamp(1rem, 1.2vw, 1.1875rem);
    line-height: 1.3;
    letter-spacing: -0.006em;
  }

  @media (min-width: 900px) {
    .svc-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
