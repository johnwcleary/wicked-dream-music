---
/**
 * The services, one under the other on alternating sides. Each title is a window
 * onto a still from the films, which drifts as the page scrolls, beside a compact
 * grid of its offerings.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { anchor, type Service } from '../lib/content';

interface Props {
  items: Service[];
  /** Stills for the titles, used in turn. */
  stills?: (ImageMetadata | undefined)[];
}
const { items, stills = [] } = Astro.props;
const pictures = await Promise.all(
  stills.map((src) => (src ? getImage({ src, width: Math.min(1400, src.width), format: 'webp', quality: 58 }) : undefined)),
);
---

<div class="svc-list">
  {
    items.map((s, i) => {
      const picture = pictures[i % Math.max(pictures.length, 1)];
      return (
        <article class="svc" id={`services-${anchor(s.id)}`}>
          <div class="svc-head">
            <h3 class="svc-title display" style={picture ? `--still: url('${picture.src}')` : undefined} data-reveal>
              {s.data.title}
            </h3>
            <p class="svc-for display" data-reveal style="--i: 1">
              {s.data.category}
            </p>
          </div>
          <ul class="svc-grid">
            {s.data.bullets.map((b, j) => (
              <li data-reveal style={`--i: ${j + 1}`}>
                {b}
              </li>
            ))}
          </ul>
        </article>
      );
    })
  }
</div>

<style>
  .svc-list {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.75rem);
  }
  .svc {
    display: grid;
    gap: 1.25rem clamp(2rem, 5vw, 5rem);
    scroll-margin-top: 6rem;
  }
  .svc-title {
    margin: 0;
    color: var(--paper);
    font-size: clamp(3.75rem, 9.5vw, 10.5rem);
    line-height: 0.94;
    /* Room for descenders: the still only paints inside this box. */
    padding-block: 0.08em 0.22em;
    margin-block: -0.08em -0.22em;
  }
  /* The still shows only through the letters, lightened so its darkest parts keep
     3.4:1 against the ink. */
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .svc-title {
      color: transparent;
      -webkit-text-stroke: 0.014em transparent;
      background-image:
        linear-gradient(color-mix(in srgb, var(--paper) 42%, transparent), color-mix(in srgb, var(--paper) 42%, transparent)),
        var(--still, linear-gradient(var(--paper), var(--paper)));
      background-position: 50% 40%;
      background-size: 135% auto;
      -webkit-background-clip: text;
      background-clip: text;
    }
  }
  .svc-for {
    margin: 0.3em 0 0;
    color: var(--accent);
    font-size: clamp(1.5rem, 2.4vw, 2.5rem);
    font-style: italic;
    line-height: 1.1;
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem clamp(1rem, 2vw, 2rem);
    align-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: clamp(1rem, 1.3vw, 1.3125rem);
    line-height: 1.3;
    letter-spacing: -0.006em;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .svc-title {
        animation: svc-drift linear both;
        animation-timeline: view();
      }
      .svc:nth-child(even) .svc-title {
        animation-direction: reverse;
      }
      @keyframes svc-drift {
        from {
          background-position: 15% 25%;
        }
        to {
          background-position: 85% 65%;
        }
      }
    }
  }

  @media (min-width: 900px) {
    .svc {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
    }
    /* Alternating sides, like the words in the hero. */
    .svc:nth-child(even) {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .svc:nth-child(even) .svc-head {
      order: 2;
      text-align: right;
    }
  }
</style>
